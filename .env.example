RESEND_API_KEY=re_xxxxxxxxxxxx
ADMIN_EMAIL=admin@example.com
RESEND_AUDIENCE_ID=aud_xxxxxxxxxxxx
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxx/xxx/xxx

# LiveQuiz session spine (roadmap F-02).
# Upstash Redis holds authoritative session state; Ably carries the fan-out.
# Provisioned through the Vercel Marketplace in an EU region matching vercel.json's fra1.
#
# Production store (recreated 2026-10-12, Vercel resource `upstash-kv-green-xylophone`)
# is connected with the required custom prefix `aicommunity`, so Vercel injects
# aicommunity_KV_REST_API_URL / aicommunity_KV_REST_API_TOKEN. That pair is read first;
# the unprefixed KV_REST_API_* pair, then UPSTASH_REDIS_REST_*, are fallbacks. The order
# lives in src/lib/session/credentials.ts. Set one pair.
aicommunity_KV_REST_API_URL=https://xxxx.upstash.io
aicommunity_KV_REST_API_TOKEN=xxxxxxxxxxxx
# The integration also injects aicommunity_KV_REST_API_READ_ONLY_TOKEN, aicommunity_KV_URL
# and aicommunity_REDIS_URL. The spine reads none of them — it speaks HTTP.
# KV_REST_API_URL=https://xxxx.upstash.io
# KV_REST_API_TOKEN=xxxxxxxxxxxx

# Ably. The browser never receives this — it requests a short-lived, subscribe-only
# token from /api/quiz/token instead.
ABLY_API_KEY=xxxxxxxx.xxxxxx:xxxxxxxxxxxxxxxxxxxxxx

# Guards the host-action endpoints. The PRD accepts an unprotected host *view*, but an
# attendee who reads the network tab must not be able to advance the quiz.
LIVEQUIZ_HOST_SECRET=generate-a-long-random-string

# Enables the dev-only spine harness at /quiz/spine-check. Set in Preview and local
# development ONLY — deliberately unset in Production, where the route must 404.
LIVEQUIZ_HARNESS=1

# The deployment `bun run quiz:reset` and `bun run quiz:rehearse` target. Local only —
# it is read by scripts under `scripts/`, never by anything under `src/`, so it does not
# belong in Vercel's environment. Both scripts also accept `--base=` , which wins.
# Production is the right value: preview URLs return 302 to Vercel SSO for anonymous
# visitors, so simulated attendee devices cannot reach one.
LIVEQUIZ_BASE_URL=https://ai-community-szn.vercel.app
