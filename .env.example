RESEND_API_KEY=re_xxxxxxxxxxxx
ADMIN_EMAIL=admin@example.com
RESEND_AUDIENCE_ID=aud_xxxxxxxxxxxx
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxx/xxx/xxx

# LiveQuiz session spine (roadmap F-02).
# Upstash Redis holds authoritative session state; Ably carries the fan-out.
# Provisioned through the Vercel Marketplace in an EU region matching vercel.json's fra1.
#
# The Marketplace integration may inject either name pair below — @upstash/redis accepts
# both. Run `bun scripts/probe-spine-config.ts` after provisioning: it reports which pair
# is actually present. Set whichever pair the probe finds; do not set both.
UPSTASH_REDIS_REST_URL=https://xxxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=xxxxxxxxxxxx
# KV_REST_API_URL=https://xxxx.upstash.io
# KV_REST_API_TOKEN=xxxxxxxxxxxx

# Ably. The browser never receives this — it requests a short-lived, subscribe-only
# token from /api/quiz/token instead.
ABLY_API_KEY=xxxxxxxx.xxxxxx:xxxxxxxxxxxxxxxxxxxxxx

# Guards the host-action endpoints. The PRD accepts an unprotected host *view*, but an
# attendee who reads the network tab must not be able to advance the quiz.
LIVEQUIZ_HOST_SECRET=generate-a-long-random-string

# Enables the dev-only spine harness at /quiz/spine-check. Set in Preview and local
# development ONLY — deliberately unset in Production, where the route must 404.
LIVEQUIZ_HARNESS=1
