---
import { isHarnessEnabled } from "../../lib/session/harness";
import { HOST_SECRET_HEADER } from "../../lib/session/host";
import { SESSION_CHANNEL, SNAPSHOT_EVENT } from "../../lib/session/realtime";
import { quizzes } from "../../quiz/index";

/**
 * The dev-only spine harness (roadmap F-02, Phase 4).
 *
 * Throwaway by design. It exists to prove the spine moves state end to end before
 * S-02 depends on it, and to give F-04 something to point simulated devices at.
 *
 * **The production views are `/quiz` (attendee) and `/quiz/host` (host).** S-02
 * built them, and they — not this page — are the pattern to follow: shared modules
 * in `src/lib/client/`, imported by an Astro `<script>`, with the server handing
 * values down through `define:vars`. That is Open Roadmap Question 2's answer, and
 * no UI-framework integration is installed or may be added.
 *
 * **This page survives for exactly one reason:** it is the only surface that
 * exercises `end` and `purge`, with the confirmation flow the runbook and the
 * rehearsal recovery path both lean on. The host view deliberately omits both.
 *
 * **Its browser-side secret is why it must stay behind `LIVEQUIZ_HARNESS`.** The
 * `hostSecret` below is rendered into the page, which is acceptable *only* because
 * this page cannot exist in production. Do not read it as precedent: `/quiz/host`
 * has the host type the secret instead, and it never appears in the HTML or the
 * bundle.
 *
 * On demand — no `prerender` export. 404s unless `LIVEQUIZ_HARNESS` is set, which
 * it is in Preview and local development but deliberately not in Production.
 */

if (!isHarnessEnabled()) {
  return new Response(null, { status: 404 });
}

// The harness sends the host secret from the browser. Acceptable ONLY because
// this page cannot exist in production — see `harness.ts`.
const hostSecret = import.meta.env.LIVEQUIZ_HOST_SECRET ?? "";

/**
 * Which quiz this harness starts (multiple-quizzes).
 *
 * The first registry entry, because the harness measures the *spine* — round trip,
 * store `EVAL`, publish — and which quiz is on the other end of it changes none of
 * those numbers. It still has to name one: `start` refuses a request that does not, and
 * a harness pointed at a lenient variant of an endpoint measures the wrong endpoint.
 */
const harnessQuizId = quizzes[0]?.id ?? "";
---

<html lang="pl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>LiveQuiz — spine check</title>
    <style>
      :root {
        color-scheme: dark;
        font-family: ui-monospace, monospace;
      }
      body {
        margin: 0;
        background: #12121c;
        color: #e8e8f0;
        padding: 1rem;
      }
      h1 {
        font-size: 1rem;
        color: #a78bfa;
        margin: 0 0 0.75rem;
      }
      .panes {
        display: grid;
        gap: 1rem;
        grid-template-columns: 1fr;
      }
      @media (min-width: 720px) {
        .panes {
          grid-template-columns: 1fr 1fr;
        }
      }
      section {
        background: #1c1c2b;
        border: 1px solid #2f2f45;
        border-radius: 0.5rem;
        padding: 1rem;
      }
      h2 {
        font-size: 0.8rem;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        color: #9ca3af;
        margin: 0 0 0.75rem;
      }
      button {
        font: inherit;
        background: #7c3aed;
        color: white;
        border: 0;
        border-radius: 0.375rem;
        padding: 0.6rem 1rem;
        margin: 0 0.4rem 0.4rem 0;
        cursor: pointer;
      }
      button:disabled {
        opacity: 0.5;
        cursor: default;
      }
      pre {
        background: #0e0e17;
        padding: 0.6rem;
        border-radius: 0.375rem;
        overflow-x: auto;
        font-size: 0.8rem;
        margin: 0.5rem 0 0;
      }
      .big {
        font-size: 1.6rem;
        color: #34d399;
        margin: 0.25rem 0;
      }
      .bad {
        color: #f87171;
      }
      /* Set apart from the flow verbs so a mis-click is unlikely — these are the
         only two actions on this page that cannot be undone. */
      .danger {
        margin-top: 1rem;
        padding-top: 0.75rem;
        border-top: 1px dashed #4b2b3a;
      }
      .danger .muted {
        margin-bottom: 0.5rem;
      }
      .danger-button {
        background: #9f1239;
      }
      .ended {
        color: #fbbf24;
        font-weight: 600;
      }
      .muted {
        color: #9ca3af;
        font-size: 0.8rem;
      }
      table {
        width: 100%;
        border-collapse: collapse;
        font-size: 0.8rem;
      }
      td {
        padding: 0.2rem 0;
        border-bottom: 1px solid #2f2f45;
      }
      td:first-child {
        color: #9ca3af;
        width: 45%;
      }
    </style>
  </head>
  <body>
    <h1>LiveQuiz spine check — F-02</h1>
    <p class="muted">
      Dev-only. Not reachable in production. Open this on a second device to
      watch fan-out.
    </p>

    <div class="panes">
      <section>
        <h2>Host</h2>
        <button data-action="start">start</button>
        <button data-action="advance">advance</button>
        <button data-action="reveal">reveal</button>

        <div class="danger">
          <div class="muted">
            Irreversible (F-03). Both send the current version as confirmation,
            so a stale click is refused rather than applied. <code>end</code> is refused
            while a question is open; <code>purge</code> deliberately is not — it
            is the escape hatch for exactly that case.
          </div>
          <button data-action="end" data-confirm class="danger-button"
            >end</button
          >
          <button data-action="purge" data-confirm class="danger-button"
            >purge</button
          >
        </div>
        <div class="muted">Round trip (click → HTTP response)</div>
        <div class="big" id="rtt">—</div>
        <div class="muted">End to end (click → snapshot rendered here)</div>
        <div class="big" id="e2e">—</div>
        <div class="muted">
          Both measured on this device's clock, so no cross-device skew. The
          second device confirms arrival and agreement, not its own absolute
          delta.
        </div>
        <pre id="log">ready</pre>
      </section>

      <section>
        <h2>Device</h2>
        <table>
          <tr><td>connection</td><td id="conn">connecting…</td></tr>
          <tr><td>version</td><td id="version">—</td></tr>
          <tr><td>phase</td><td id="phase">—</td></tr>
          <tr><td>question</td><td id="question">—</td></tr>
          <tr><td>source of last apply</td><td id="source">—</td></tr>
          <tr><td>snapshots applied</td><td id="applied">0</td></tr>
          <tr><td>snapshots dropped (not newer)</td><td id="dropped">0</td></tr>
        </table>
        <pre id="state">waiting for state…</pre>
      </section>
    </div>

    <script
      define:vars={{
        hostSecret,
        secretHeader: HOST_SECRET_HEADER,
        channelName: SESSION_CHANNEL,
        snapshotEvent: SNAPSHOT_EVENT,
        quizId: harnessQuizId,
      }}
    >
      window.__spineCheck = {
        hostSecret,
        secretHeader,
        channelName,
        snapshotEvent,
        quizId,
      };
    </script>

    <script>
      import * as Ably from "ably";

      type HarnessConfig = {
        hostSecret: string;
        secretHeader: string;
        channelName: string;
        snapshotEvent: string;
        /** Which quiz `start` asks for (multiple-quizzes) — the route refuses a request without one. */
        quizId: string;
      };

      type Snapshot = {
        version: number;
        phase: string;
        currentQuestionId: string | null;
      } | null;

      const config = (window as unknown as { __spineCheck: HarnessConfig })
        .__spineCheck;

      const el = (id: string): HTMLElement => {
        const node = document.getElementById(id);
        if (!node) throw new Error(`missing #${id}`);
        return node;
      };
      const write = (id: string, value: unknown): void => {
        el(id).textContent = String(value);
      };
      const buttons = (): HTMLButtonElement[] =>
        Array.from(
          document.querySelectorAll<HTMLButtonElement>("button[data-action]"),
        );

      /**
       * The client's single reconciliation rule: apply whichever snapshot carries
       * the higher version, drop anything not newer. It is what makes the state
       * fetch and the subscription safe to race, and it is why a device that
       * missed a message recovers on the next one.
       */
      let current: Snapshot = null;
      let appliedCount = 0;
      let droppedCount = 0;
      /** Set by a host click; consumed by the first snapshot that arrives after it. */
      let pendingClickAt: number | null = null;

      function apply(
        state: Snapshot,
        source: "fetch" | "ably" | "http",
      ): boolean {
        if (state && current && state.version <= current.version) {
          droppedCount += 1;
          write("dropped", droppedCount);
          return false;
        }

        current = state;
        appliedCount += 1;
        write("applied", appliedCount);
        write("source", source);
        write("version", state ? state.version : "— (no session)");
        write("phase", state ? state.phase : "— (purged or never started)");
        // The whole reason `ended` is a phase rather than an absent session: a device
        // must be able to tell "the quiz finished" from "the quiz never started" and
        // from "my connection died". Three different states, three different renders.
        el("phase").className = state?.phase === "ended" ? "ended" : "";
        write(
          "question",
          state && state.currentQuestionId ? state.currentQuestionId : "—",
        );
        write("state", JSON.stringify(state, null, 2));

        if (pendingClickAt !== null && source === "ably") {
          write("e2e", `${Math.round(performance.now() - pendingClickAt)} ms`);
          pendingClickAt = null;
        }
        return true;
      }

      // Fetch before subscribing: this is what makes a reload render current state
      // immediately instead of waiting for the host's next action.
      async function primeFromServer(): Promise<void> {
        try {
          const response = await fetch("/api/quiz/state");
          const body = (await response.json()) as { state?: Snapshot };
          apply(body.state ?? null, "fetch");
        } catch (err) {
          write("state", `state fetch failed: ${err}`);
        }
      }

      async function connect(): Promise<void> {
        // authUrl, never a key: the browser gets a short-lived subscribe-only token.
        const client = new Ably.Realtime({ authUrl: "/api/quiz/token" });

        client.connection.on((change) => {
          write("conn", change.current);
          el("conn").className = change.current === "connected" ? "" : "bad";
        });

        const channel = client.channels.get(config.channelName);
        await channel.subscribe(config.snapshotEvent, (message) => {
          apply(message.data as Snapshot, "ably");
        });
      }

      async function fire(
        action: string,
        needsConfirm: boolean,
      ): Promise<void> {
        /**
         * The confirmation the destructive routes demand: the version this device
         * believes is current, which it can only know from having applied a snapshot.
         * Omitted when there is no session — `purge` accepts that and reports
         * "nothing to purge", which is how residue cleanup is reached.
         */
        let body: FormData | undefined;

        // `start` names the quiz it wants; the route refuses a request that names none,
        // and this harness measures the real endpoint rather than a lenient variant.
        if (action === "start") {
          body = new FormData();
          body.set("quizId", config.quizId);
        }

        if (needsConfirm) {
          if (current) {
            body = new FormData();
            body.set("version", String(current.version));
          }

          const what =
            action === "purge"
              ? "Usunąć wszystkie dane sesji teraz? Tego nie można cofnąć."
              : "Zakończyć sesję?";
          if (!window.confirm(what)) return;
        }

        buttons().forEach((button) => {
          button.disabled = true;
        });

        // The headline figure starts HERE — at the click, before the request — not
        // at the response. The guardrail is "within 1 second of the host acting",
        // and anchoring at the response would omit the endpoint round trip, the
        // store EVAL and the publish: most of the server-side budget.
        const clickedAt = performance.now();
        pendingClickAt = clickedAt;
        write("e2e", "waiting…");

        try {
          const response = await fetch(`/api/quiz/host/${action}`, {
            method: "POST",
            headers: { [config.secretHeader]: config.hostSecret },
            body,
          });
          write("rtt", `${Math.round(performance.now() - clickedAt)} ms`);

          const payload = (await response.json()) as { state?: Snapshot };
          write(
            "log",
            `${action} → ${response.status} ${JSON.stringify(payload).slice(0, 300)}`,
          );

          // Render the authoritative response too, so the host pane is correct even
          // if the broadcast is what failed.
          if (payload.state) apply(payload.state, "http");

          // `purge` leaves nothing behind, so there is no state in its response to
          // apply. Re-prime from the server instead, which is what a real device
          // reloading after a purge would see.
          if (action === "purge" && response.ok) {
            current = null;
            await primeFromServer();
          }
        } catch (err) {
          write("log", `${action} → request failed: ${err}`);
          pendingClickAt = null;
        } finally {
          buttons().forEach((button) => {
            button.disabled = false;
          });
        }
      }

      buttons().forEach((button) => {
        button.addEventListener("click", () => {
          void fire(
            button.dataset.action ?? "",
            button.hasAttribute("data-confirm"),
          );
        });
      });

      primeFromServer().then(connect);
    </script>
  </body>
</html>
