---
import "../../styles/global.css";

import {
  DEVICE_STORAGE_KEY,
  PLAYER_STORAGE_KEY,
  QUESTION_SEEN_STORAGE_KEY,
} from "../../lib/session/keys";
import { SESSION_CHANNEL, SNAPSHOT_EVENT } from "../../lib/session/realtime";
import { MAX_GUESS_INPUT_LENGTH } from "../../lib/session/guess";
import { MAX_TEXT_ANSWER_LENGTH } from "../../lib/session/scoring";
import { MAX_WORD_LENGTH } from "../../lib/session/words";
import { publicQuiz } from "../../quiz/public";

/**
 * The attendee view (roadmap S-02, PRD FR-002/FR-007/FR-008).
 *
 * Claim a name, then follow the host. Read on a phone held at arm's length in a dark
 * room, so the type is large and the contrast is high; all copy is Polish.
 *
 * **On demand — no `prerender` export.** It renders per request because the join and
 * the current session state are both request-time facts. See the root CLAUDE.md's route table.
 *
 * **Reads no secret of any kind.** Everything below reaches the browser deliberately:
 * the channel and event names (which a subscribe-only token already grants access to),
 * the `localStorage` key, the answer-length bound on the text input, and the *public*
 * quiz projection — prompts and option text, never an answer. The bound is read in
 * frontmatter and written straight into the markup's `maxlength`, so the `<script>`
 * block never needs it — which matters because that block may not value-import from
 * `src/lib/session/`. The server-side refusal in `/api/quiz/answer` is the real bound;
 * `maxlength` is only there to stop a phone typing past it.
 * `src/lib/client/boundary.test.ts` scans the `<script>` blocks below
 * and fails the suite if one reads env or value-imports `src/quiz/` or
 * `src/lib/session/`; this frontmatter is excluded from that scan because it runs
 * server-side, which is exactly how these values are fetched.
 *
 * **No `BaseLayout`.** That layout carries the site navbar, footer and OG metadata for
 * a content site. This is a full-screen single-purpose view, so it keeps its own
 * document shell — `spine-check.astro`'s precedent — but styled with Tailwind utilities
 * rather than an inline `<style>` block.
 */
---

<html lang="pl" class="bg-quiz-ink">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>LiveQuiz — dołącz</title>
  </head>
  <!--
    THE PHONE SHELL (signage redesign, step 7).

    One column, `dvh` tall, with the room's palette: this is the same signage system the
    projector runs, at the sizes a phone held at arm's length in a dark room can carry.
    Nothing here goes below 20px, which is the floor the whole scale is built on.

    `min-h-dvh` with the main column growing, so the waiting screens can push their status
    line into the thumb zone while the answering screens stack from the top — see
    `setWaiting`.
  -->
  <body
    class="flex min-h-dvh flex-col bg-quiz-ink font-archivo text-quiz-signwhite antialiased
           px-7 pt-6 pb-8"
  >
    <main class="mx-auto flex w-full max-w-md flex-1 flex-col gap-6">
      <h1 class="text-[20px] font-semibold uppercase tracking-[0.14em] text-quiz-zinc">
        LiveQuiz
      </h1>

      <!-- Shown until the stored-player check resolves, so a returning device never
           flashes the name form it is about to skip. -->
      <section id="boot" class="text-[30px] font-semibold leading-[36px] text-quiz-echo">
        Ładowanie…
      </section>

      <noscript>
        <p class="text-[30px] font-semibold leading-[36px]">
          Ten quiz wymaga włączonego JavaScriptu. Włącz go i odśwież stronę.
        </p>
      </noscript>

      <!-- The join screen is a waiting screen: the headline sits under the wordmark and the
           form sits in the thumb zone, because typing a name one-handed is the whole of what
           PRD FR-002 gives thirty seconds to. -->
      <section id="join" hidden class="flex flex-1 flex-col justify-between gap-8">
        <p class="text-[44px] font-extrabold leading-[46px] tracking-[-0.035em]">
          Wpisz swoją nazwę, żeby dołączyć do quizu.
        </p>

        <form id="join-form" class="flex flex-col gap-4" novalidate>
          <label
            for="display-name"
            class="text-[20px] font-semibold uppercase tracking-[0.14em] text-quiz-zinc"
          >
            Twoja nazwa
          </label>
          <input
            id="display-name"
            name="displayName"
            type="text"
            inputmode="text"
            autocomplete="off"
            autocapitalize="words"
            autocorrect="off"
            spellcheck="false"
            maxlength="24"
            class="w-full rounded-[18px] border-2 border-quiz-field-border bg-quiz-asphalt
                   px-4 py-4 text-[30px] font-semibold leading-[36px] text-quiz-signwhite
                   placeholder:text-quiz-zinc focus:border-quiz-chrome focus:outline-none"
            placeholder="np. Ania"
          />
          <button
            id="join-submit"
            type="submit"
            class="w-full rounded-[18px] bg-quiz-chrome px-4 py-4 text-[32px] font-bold
                   text-quiz-ink disabled:bg-quiz-asphalt disabled:text-quiz-pill-disabled"
          >
            Dołącz
          </button>

          <!--
            The refusal bubble (plan §3).

            Every way a join can be turned away lands here — the name is taken, this device
            has claimed its allowance, storage is off in private mode — and all three are
            `refused`, so all three get the signal marker. The bubble is the phone's version
            of the projector's: a marker bar carrying the register, then the sentence.

            Hidden while empty, so a refusal that has been cleared takes its height with it
            rather than leaving a gap above the button.
          -->
          <div
            id="join-error-bubble"
            hidden
            class="flex items-stretch gap-3 rounded-[16px] border-2 border-quiz-field-border
                   bg-quiz-float px-4 py-3"
          >
            <span class="w-[8px] shrink-0 rounded-full bg-quiz-signal"></span>
            <p
              id="join-error"
              role="alert"
              aria-live="polite"
              class="text-[22px] font-semibold leading-[28px]"
            >
            </p>
          </div>
        </form>
      </section>

      <!-- `data-waiting` decides whether this column stacks from the top or pushes its
           status into the thumb zone. Written by `setWaiting` and by nothing else. -->
      <section
        id="follow"
        hidden
        data-waiting="false"
        class="flex flex-1 flex-col gap-6 data-[waiting=true]:justify-between"
      >
        <!-- Who this device is, and what it came back with — one block, because the waiting
             layout spreads its children and three loose lines would strand this one in the
             middle of the screen with nothing to do there. -->
        <div class="flex flex-col gap-2">
          <p
            id="player-name"
            class="text-[20px] font-semibold uppercase tracking-[0.14em] text-quiz-zinc"
          >
          </p>
        <!-- What this device came back with, on a resume only (roadmap S-09, FR-009).

             Deliberately NOT a live score line. It is refreshed by nothing, and it says
             so: it is phrased as a statement about the moment of resuming, which stays
             true however long it sits there, and `paintTotal` retires it the first time
             a fresh total reaches the result panel. A permanently-visible total updated
             only at reveal is the affordance-vs-data-path defect `lessons.md` opens
             with, and it would put two different scores on one screen. -->
          <p id="resume-total" class="text-[22px] leading-[28px] text-quiz-echo"></p>
        </div>

        <!-- The class is written by `status()`, which picks the register the sentence is in:
             a headline on the waiting screens, a label above a question, an alarm when the
             connection is gone. Never styled here, or the two would disagree. -->
        <p id="follow-status"></p>

        <!-- The backup-mode banner. Shown only while the channel is unavailable *and*
             polling is working, so it is never on screen at the same time as the red
             `follow-status` failure line — the two describe mutually exclusive states.

             Static markup, sibling of the status line rather than something
             `renderQuestion` emits, for the same reason the answer fields below are:
             `render()` runs on every applied snapshot and `replaceChildren()` would
             destroy anything living inside the question container. -->
        <div
          id="degraded-note"
          hidden
          class="flex items-stretch gap-3 rounded-[16px] border-2 border-quiz-field-border
                 bg-quiz-float px-4 py-3"
        >
          <span class="w-[8px] shrink-0 rounded-full bg-quiz-chrome"></span>
          <!--
            `attention`, not `refused`: nothing is broken and nothing needs fixing by the
            person holding the phone — they are being told why the screen may lag. That is the
            register the projector's bubble gives chrome, and this is its phone counterpart.

            **The copy is shortened, which the plan sanctions explicitly.** The full sentence
            ran to three lines on a 390px screen, above a question the attendee is trying to
            answer against a clock. What it must carry is that answers still work and that the
            clock may cost them — the mechanism ("we refresh every few seconds") is a fact
            about a transport nobody in the room can act on.
          -->
          <!-- 20px, the phone scale's floor, and the one place this view goes to it: the
               banner is a notice *above* the question, so every line it takes is a line the
               prompt loses. At 22px the shortened sentence still ran to four. -->
          <p role="status" aria-live="polite" class="text-[20px] font-semibold leading-[26px]">
            Tryb zapasowy — odpowiedzi działają, ale punkty za czas mogą być niższe.
          </p>
        </div>

        <!-- The countdown (S-11, FR-020). A STATIC element shown and hidden, for the same
             reason the inputs below are: `renderQuestion` calls `replaceChildren()` on the
             question container, so anything emitted there is destroyed and rebuilt on every
             snapshot — and this one is animating.

             Present only while a scored question is open. The two unscored questions carry no
             limit, so no clock appears on them at all.

             **Moved above the question.** The plan's phone order is label → prompt →
             countdown → options, and the middle two cannot be separated: `renderQuestion`
             emits the prompt and the option list as one block, the same constraint that put
             the projector's multiple-choice note in the top strip. Of the two placements left,
             above wins — under the options the clock was the last thing read before the tap,
             which is the wrong end. It is context for the decision, not part of it.

             `data-urgent` is written by the countdown's `onPaint` and read by both the number and the
             bar, so the two cannot disagree about whether the last five seconds have started —
             `renderCountdown`'s contract, applied to colour.

             **The classes here previously named colours this project does not define**
             (`text-content-secondary`, `bg-accent`), so the clock had been rendering in
             whatever it inherited since S-11. -->
        <div id="countdown" hidden data-urgent="false" class="flex flex-col gap-2">
          <div class="flex items-baseline justify-between gap-4">
            <span class="text-[20px] font-semibold uppercase tracking-[0.14em] text-quiz-zinc">
              Pozostały czas
            </span>
            <span
              data-countdown-text
              class="text-[34px] font-extrabold leading-[34px] tabular-nums
                     [[data-urgent=true]_&]:text-quiz-signal">0 s</span
            >
          </div>
          <!-- The bar is decoration for the number above it, hence aria-hidden HERE and not on
               the panel (impl review F5): a screen reader announcing a width every second is
               noise, but the seconds value is the one thing on this panel a non-sighted
               attendee needs. It sat on the whole panel, which hid the number too. -->
          <div class="h-[8px] overflow-hidden rounded-full bg-quiz-divider" aria-hidden="true">
            <div
              data-countdown-bar
              class="h-full rounded-full bg-quiz-chrome transition-[width] duration-1000
                     ease-linear [[data-urgent=true]_&]:bg-quiz-signal"
              style="width: 100%"
            >
            </div>
          </div>
        </div>

        <div id="question" class="flex flex-col gap-4"></div>

        <!-- The answering controls. Hidden for every phase and kind that cannot be
             answered, so nothing tappable is ever on screen without a purpose. -->

        <!-- The free-text field (S-05). A STATIC element shown and hidden, deliberately
             not something `renderQuestion` emits: that function calls
             `replaceChildren()` and `render()` runs on every snapshot, so an input
             inside the question container would be destroyed and rebuilt while the
             attendee is typing — losing the value, the focus and the caret. Another
             attendee joining is enough to trigger it. -->
        <input
          id="answer-text"
          type="text"
          hidden
          inputmode="text"
          autocomplete="off"
          autocapitalize="off"
          autocorrect="off"
          spellcheck="false"
          maxlength={MAX_TEXT_ANSWER_LENGTH}
          class="w-full rounded-[18px] border-2 border-quiz-field-border bg-quiz-asphalt
                 px-4 py-4 text-[30px] font-semibold leading-[36px] text-quiz-signwhite
                 placeholder:text-quiz-zinc focus:border-quiz-chrome focus:outline-none
                 disabled:border-quiz-divider disabled:text-quiz-echo"
          placeholder="Wpisz odpowiedź"
        />

        <!-- The numeric field (S-06). Static and sibling to the text one, for exactly
             the same reason: `render()` runs on every snapshot and would otherwise
             destroy it mid-keystroke.

             **`type="text"` with `inputmode="decimal"`, and that is the decision.**
             `type="number"` picks its accepted decimal separator from the browser
             locale, so the same typed characters parse differently on two phones in
             the same room; and it reports an empty string for any value it considers
             invalid, which is precisely the absent-versus-hostile confusion
             `lessons.md` rule 2 is about. `inputmode` gets the numeric keypad with
             neither problem. -->
        <input
          id="answer-number"
          type="text"
          hidden
          inputmode="decimal"
          autocomplete="off"
          autocapitalize="off"
          autocorrect="off"
          spellcheck="false"
          maxlength={MAX_GUESS_INPUT_LENGTH}
          class="w-full rounded-[18px] border-2 border-quiz-field-border bg-quiz-asphalt
                 px-4 py-4 text-[30px] font-semibold leading-[36px] text-quiz-signwhite
                 placeholder:text-quiz-zinc focus:border-quiz-chrome focus:outline-none
                 disabled:border-quiz-divider disabled:text-quiz-echo"
          placeholder="Wpisz liczbę"
        />

        <!-- The word field (S-08). A third static sibling of the two above, for the same
             reason and with the same consequence: `render()` runs on every snapshot and
             `replaceChildren()` inside the question container would destroy the input
             mid-keystroke, losing the value, the focus and the caret.

             `maxlength` is `MAX_WORD_LENGTH`, not the text field's 80 — a word goes on a
             projector, so it is bounded by what fits a projected line, the same number
             `MAX_DISPLAY_NAME_LENGTH` uses for the same reason. Read in frontmatter and
             written straight into the markup, because the `<script>` block below may not
             value-import from `src/lib/session/`.

             `autocapitalize="off"` deliberately: the fold lowercases anyway, so a phone
             capitalising the first letter would show the attendee something other than
             what the projector renders. -->
        <input
          id="answer-word"
          type="text"
          hidden
          inputmode="text"
          autocomplete="off"
          autocapitalize="off"
          autocorrect="off"
          spellcheck="false"
          maxlength={MAX_WORD_LENGTH}
          class="w-full rounded-[18px] border-2 border-quiz-field-border bg-quiz-asphalt
                 px-4 py-4 text-[30px] font-semibold leading-[36px] text-quiz-signwhite
                 placeholder:text-quiz-zinc focus:border-quiz-chrome focus:outline-none
                 disabled:border-quiz-divider disabled:text-quiz-echo"
          placeholder="Wpisz jedno słowo"
        />

        <p id="answer-note" hidden class="text-[22px] leading-[28px] text-quiz-echo"></p>
        <!--
          The send failure, in the same bubble the join refusal uses (plan §3).

          **Directly above the submit button**, which is where a failure has to appear: the
          sentence says "try again" and the button is what the thumb is already on. Under the
          button it sat below the fold on a long prompt — a refusal an attendee never saw,
          beside a control that looked like it had worked.

          `refused` register, so the marker is `signal`: the answer did not land. The submit
          button beside it stays enabled on a network failure — the phone is being told to try
          again, and a disabled button under "spróbuj ponownie" is an instruction it cannot
          follow.

          `role="alert"` on the copy rather than on the bubble, so the live region announces
          the sentence and not the bar beside it.
        -->
        <div
          id="answer-error-bubble"
          hidden
          class="flex items-stretch gap-3 rounded-[16px] border-2 border-quiz-field-border
                 bg-quiz-float px-4 py-3"
        >
          <span class="w-[8px] shrink-0 rounded-full bg-quiz-signal"></span>
          <p
            id="answer-error"
            role="alert"
            aria-live="polite"
            class="text-[22px] font-semibold leading-[28px]"
          >
          </p>
        </div>
        <button
          id="answer-submit"
          type="button"
          hidden
          class="w-full rounded-[18px] bg-quiz-chrome px-4 py-4 text-[30px] font-bold
                 text-quiz-ink disabled:bg-quiz-asphalt disabled:text-quiz-pill-disabled"
        >
          Wyślij odpowiedź
        </button>

        <!-- The accepted answer for a free-text question, from the snapshot. Sits
             OUTSIDE the result panel on purpose: the panel is gated on having answered
             and on the per-device fetch, while this must reach a device that stayed
             silent and one whose fetch failed. -->
        <p
          id="answer-accepted"
          hidden
          class="rounded-[18px] border-2 border-quiz-mint bg-quiz-mint-tint px-4 py-3
                 text-[30px] font-semibold leading-[36px] text-quiz-mint"
        >
        </p>

        <!-- The reveal panel. The verdict line is per device and arrives from
             /api/quiz/result; the correct answer above it came with the snapshot and
             is on screen whether or not that fetch succeeds. -->
        <section id="result" hidden class="flex flex-col gap-2">
          <!-- The verdict's colour is written by `verdict()`, which is also what writes the
               words — the two are one statement and must not be set apart. -->
          <p id="result-verdict"></p>
          <!-- Sized by `award()`, which also writes the words: a figure and a sentence do not
               take the same type, and the element cannot tell which it is holding. -->
          <p id="result-award"></p>
          <p id="result-answer" class="text-[30px] font-semibold leading-[38px] text-quiz-echo"></p>
          <p id="result-total" class="text-[28px] font-semibold leading-[36px] text-quiz-zinc"></p>
        </section>

        <!--
          The leaderboard beat (roadmap S-07, FR-014).

          The same five rows the projector shows, in the same order, because both render
          the list the server published and neither sorts. Own row highlighted.

          `standings-you` sits OUTSIDE the board for the reason `answer-accepted` sits
          outside the result panel: the board comes with the snapshot and is on screen
          whichever way the per-device fetch goes, while this line depends on that fetch
          and must be able to say nothing without taking the board down with it.
        -->
        <section id="standings" hidden class="flex flex-col gap-3">
          <div id="standings-board"></div>
          <p id="standings-you" class="text-[22px] leading-[28px] text-quiz-echo"></p>
        </section>
      </section>
    </main>

    <!--
      `define:vars` forces an inline, unprocessed script, so it cannot import from npm.
      The handoff is therefore split in two exactly as `spine-check.astro` does it: this
      block parks the server-rendered values on `window`, and the module script below
      picks them up.
    -->
    <script
      define:vars={{
        channelName: SESSION_CHANNEL,
        snapshotEvent: SNAPSHOT_EVENT,
        storageKey: PLAYER_STORAGE_KEY,
        seenStorageKey: QUESTION_SEEN_STORAGE_KEY,
        deviceStorageKey: DEVICE_STORAGE_KEY,
        questions: publicQuiz.questions,
      }}
    >
      window.__liveQuiz = {
        channelName,
        snapshotEvent,
        storageKey,
        seenStorageKey,
        deviceStorageKey,
        questions,
      };
    </script>

    <script>
      import {
        createSessionClient,
        type ConnectionCause,
        type ConnectionStatus,
        type SessionClient,
      } from "../../lib/client/session";
      import { clearPlayer, readPlayer, writePlayer } from "../../lib/client/player";
      import { deviceId, deviceStoragePersists } from "../../lib/client/device";
      import {
        clearSeen,
        fetchResult,
        hasSubmitted,
        markSeen,
        markSubmitted,
        submitAnswer,
        submittedText,
        submittedOptionIds,
        type AnswerPayload,
        type OwnResult,
      } from "../../lib/client/answer";
      import { createCelebration } from "../../lib/client/celebrate";
      import { createCountdown } from "../../lib/client/countdown";
      import {
        el,
        renderCountdown,
        renderEntrance,
        renderFigureCountUp,
        renderQuestion,
        renderStandings,
        setHidden,
        setText,
        standingsPositionText,
        wordEchoText,
      } from "../../lib/client/render";
      import type { PublicQuestion } from "../../quiz/public";

      type Config = {
        channelName: string;
        snapshotEvent: string;
        storageKey: string;
        seenStorageKey: string;
        deviceStorageKey: string;
        questions: PublicQuestion[];
      };

      type JoinResponse = {
        player?: { id: string; displayName: string };
        state?: Parameters<SessionClient["apply"]>[0];
        error?: string;
        /** Present on a resume only (roadmap S-09) — a fresh claim has nothing to carry. */
        total?: number;
        /**
         * Which 409 this is (roadmap S-09). `taken` and `capped` are both 409s and the
         * device does different things with them, so the status alone cannot decide.
         */
        refusal?: string;
      };

      const config = (window as unknown as { __liveQuiz: Config }).__liveQuiz;

      const boot = el("boot");
      const joinSection = el("join");
      const followSection = el("follow");
      const questionBox = el("question");
      const nameInput = el("display-name") as HTMLInputElement;
      const submit = el("join-submit") as HTMLButtonElement;
      const form = el("join-form") as HTMLFormElement;
      const answerSubmit = el("answer-submit") as HTMLButtonElement;
      const answerText = el("answer-text") as HTMLInputElement;
      const answerNumber = el("answer-number") as HTMLInputElement;
      const answerWord = el("answer-word") as HTMLInputElement;
      const answerNote = el("answer-note");
      const standingsBox = el("standings");
      const standingsBoard = el("standings-board");
      const answerAccepted = el("answer-accepted");
      const degradedNote = el("degraded-note");
      const resultPanel = el("result");
      const countdownBox = el("countdown");
      const joinErrorBubble = el("join-error-bubble");
      const answerErrorBubble = el("answer-error-bubble");

      /**
       * THE STATUS LINE'S THREE REGISTERS (signage redesign, step 7).
       *
       * One element carries three different jobs, and sizing it once would get two of them
       * wrong: on a waiting screen it *is* the screen — the only thing to read — while above
       * a question it is a label on something more important, and when the channel is gone it
       * is an alarm. So the caller says which, and the class lives in one place rather than
       * being written at each branch.
       */
      type StatusStyle = "headline" | "label" | "alarm";

      const STATUS_CLASSES: Record<StatusStyle, string> = {
        headline: "text-[44px] font-extrabold leading-[46px] tracking-[-0.035em]",
        label: "text-[20px] font-semibold uppercase tracking-[0.14em] text-quiz-zinc",
        alarm: "text-[30px] font-semibold leading-[36px] text-quiz-signal",
      };

      function status(text: string, style: StatusStyle): void {
        setText("follow-status", text);
        el("follow-status").className = STATUS_CLASSES[style];
      }

      /**
       * Whether this is a screen with nothing to do on it.
       *
       * A waiting screen pushes its status into the thumb zone, because it is the only thing
       * on it and a phone is held low; an answering screen stacks from the top, because the
       * prompt has to be read before anything under it is tapped. Set from the one place the
       * question box is shown or hidden, so the two can never disagree about which kind of
       * screen this is.
       *
       * `waiting` defaults to "no question means nothing to read", which is true of every
       * screen but one: the board has no question and is not a waiting screen either, so
       * `renderBoard` passes it explicitly rather than writing the attribute itself. Two
       * writers is exactly what this function exists to prevent.
       */
      function showQuestion(visible: boolean, waiting = !visible): void {
        setHidden(questionBox, !visible);
        followSection.dataset.waiting = String(waiting);
      }

      /**
       * Which question the answering controls are currently dressed for.
       *
       * **Only so a send failure cannot outlive its question** (impl review F9). The ordinary
       * open → reveal → advance flow clears the error through `hideAnswerControls`, but
       * `CONTROL_RULES` deliberately keeps `dalej` live during `question-open`, so open → open
       * is reachable — and a stale "Nie udało się wysłać…" would then sit in a signal-marked
       * bubble above the new question's submit, reading as a refusal of an answer nobody has
       * given yet.
       */
      let controlsQuestionId: string | null = null;

      function dressControlsFor(questionId: string): void {
        if (controlsQuestionId === questionId) return;
        controlsQuestionId = questionId;
        answerError("");
      }

      /**
       * The join refusal, and the bubble that carries it.
       *
       * Empty means *no refusal*, and the bubble goes with it — a cleared message that left
       * its frame behind would read as a refusal with the words missing.
       */
      /**
       * **Unhidden before the text is written, and that order is the whole point** (impl
       * review F4). A node inside a `display:none` subtree is not in the accessibility tree,
       * so writing into it announces nothing — and revealing a container that already holds
       * its sentence is not reliably announced either. Before the bubble, these were
       * always-present paragraphs whose text changed in place, which did announce; the frame
       * is what took that away, and this is what gives it back.
       */
      function joinError(text: string): void {
        setHidden(joinErrorBubble, false);
        setText("join-error", text);
        setHidden(joinErrorBubble, text.length === 0);
      }

      /**
       * The answering side's equivalent, and the same rule: empty means *no failure*, so the
       * frame goes with the words. A bubble left standing with nothing in it reads as a
       * refusal whose sentence failed to load.
       */
      function answerError(text: string): void {
        // Unhidden first, for the reason `joinError` states.
        setHidden(answerErrorBubble, false);
        setText("answer-error", text);
        setHidden(answerErrorBubble, text.length === 0);
      }

      let connection: ConnectionStatus = "connecting";
      /**
       * Why the connection is unhealthy, held beside the status because the `lost` branch
       * picks its wording from it. Deliberately not folded into `connection`: the status
       * decides what is on screen, the cause decides only what it says.
       */
      let connectionCause: ConnectionCause = null;
      let joined = false;
      let player: { id: string; displayName: string } | null = null;

      /**
       * Everything the answering beats need, keyed by question id.
       *
       * Per question rather than a single "current" value, because the snapshot is what
       * decides which question is current and it can move under us. Keyed state means
       * an out-of-order or replayed snapshot renders the right thing rather than
       * mixing one question's selection into another — the property `render()` already
       * had and that these additions must not cost.
       */
      const selections = new Map<string, string[]>();
      /**
       * What this device has typed, per question — the text equivalent of `selections`,
       * and keyed for the same reason: the snapshot decides which question is current
       * and it can move underneath us.
       */
      const typed = new Map<string, string>();
      const results = new Map<string, OwnResult>();
      /** Questions whose result fetch has already been issued — one per device, ever. */
      const resultRequested = new Set<string>();

      /**
       * This device's own position, and which beat it belongs to (roadmap S-07).
       *
       * Keyed by the snapshot **version** rather than by question id, unlike `results`
       * above. A host may show the standings more than once between the same pair of
       * questions, and each beat is a fresh board — a question-keyed cache would paint the
       * first beat's position under the second one's board, which is plausible and wrong.
       * Every accepted transition bumps the version, so it identifies a beat exactly.
       *
       * `rank === null` with `rankVersion` set is the failed-fetch state, and it must stay
       * distinguishable from "not asked yet": it is the difference between a neutral line
       * and one more request.
       */
      let rank: number | null = null;
      let rankVersion: number | null = null;
      /**
       * Whether a rank request for `rankVersion` is still open.
       *
       * **A third state, because two collapse into a lie** (impl review F2). `rank === null`
       * is the *failure* state, and it is also what this device holds while the request is
       * in flight — so any re-render at the same version painted "we couldn't get your
       * position" over a request that was still running. Re-rendering at the same version is
       * routine: a connection transition calls `render()`, and a venue Wi-Fi flap during the
       * beat is exactly when it happens.
       */
      let rankPending = false;

      /**
       * THE PHONE'S QUESTION TYPE AND OPTION ROWS (signage redesign, step 8).
       *
       * The projector's answer band at phone scale: a 56px slab carrying the option's letter,
       * then the text. Same letters as the big screen, from the same mechanism — a CSS counter
       * on the list, because `renderQuestion` writes an option's text with `textContent` and
       * leaves no child to put a letter in. The letters follow the rendered order, which is
       * what `publicQuiz` shuffles and what both screens show.
       *
       * **Selection travels by attribute, and by two different ones.** In `answerable` mode
       * the renderer builds a button and marks it `aria-pressed`; in `static` mode it marks
       * the item `data-selected`. Both are read here as variants — never as an appended
       * `optionSelected` class — because an appended utility and the base it overrides are the
       * same kind of rule, and stylesheet order decides which wins. The two modes never
       * co-occur, so the two treatments cannot collide.
       *
       * They are deliberately *different* treatments: a live pick is chrome, the accent that
       * means "this is yours to change", while a locked one steps down to the muted chrome
       * pair — still legibly yours, no longer inviting a tap.
       */
      const OPTION_LIST = "flex flex-col gap-2 [counter-reset:option]";

      const OPTION_CLASS =
        "flex min-h-[64px] w-full items-center overflow-hidden rounded-[18px] " +
        "bg-quiz-asphalt pr-4 text-left text-[26px] font-semibold leading-[32px] " +
        "text-quiz-signwhite [counter-increment:option] before:mr-4 before:flex " +
        "before:w-[56px] before:shrink-0 before:self-stretch before:items-center " +
        "before:justify-center before:bg-quiz-slab-inactive before:text-[24px] " +
        "before:font-extrabold before:text-quiz-signwhite " +
        "before:[--tw-content:counter(option,_upper-alpha)] " +
        // Live pick.
        "aria-pressed:bg-quiz-chrome-tint aria-pressed:before:bg-quiz-chrome " +
        "aria-pressed:before:text-quiz-ink " +
        /*
         * Locked pick — and at the reveal, this device's own answer.
         *
         * `:not([data-correct=true])` is load-bearing rather than tidy. At a reveal an option
         * can be both this device's pick and the right answer, and the two treatments below
         * set the same properties; without the exclusion, which one won would be decided by
         * stylesheet order. With it the two selectors are mutually exclusive, and the
         * compound is more specific, so a correct pick reads as *correct* — which is the
         * thing the attendee is looking for.
         */
        "[&[data-selected=true]:not([data-correct=true])]:bg-quiz-locked-tint " +
        "[&[data-selected=true]:not([data-correct=true])]:before:bg-quiz-locked-slab " +
        "[&[data-selected=true]:not([data-correct=true])]:before:text-quiz-locked-letter " +
        // The answer, at the reveal. Marked whether or not this device picked it.
        "data-[correct=true]:bg-quiz-mint-tint data-[correct=true]:text-quiz-mint " +
        "data-[correct=true]:before:bg-quiz-mint data-[correct=true]:before:text-quiz-ink";

      /** The prompt above them. Smaller than the projector's for the obvious reason. */
      const PROMPT_CLASS = "text-[36px] font-extrabold leading-[38px] tracking-[-0.035em]";

      const client = createSessionClient({
        channelName: config.channelName,
        snapshotEvent: config.snapshotEvent,
        /**
         * The whole point of this change: a device Ably refused — most plausibly one that
         * did not fit under the free tier's 200-connection ceiling — keeps playing over
         * HTTP instead of sitting out the segment behind a red banner.
         */
        fallbackPolling: true,
        onSnapshot: () => render(),
        onConnection: (status, info) => {
          connection = status;
          connectionCause = info.cause;
          render();
        },
      });

      function indexOfQuestion(id: string): number {
        return config.questions.findIndex((question) => question.id === id);
      }

      /**
       * The whole attendee-facing state machine, in one function driven by the snapshot
       * and the connection status. Rendering from state rather than from events is what
       * makes an out-of-order or duplicated snapshot harmless.
       */
      function render(): void {
        if (!joined) return;

        /**
         * **The countdown's single clearing point.** Every branch below either returns
         * without a clock or, on `question-open`, arms a fresh one — so no phase change,
         * connection loss or reveal can leave a timer running for a question that has left
         * the screen. Put anywhere else, this would be a rule each new branch has to
         * remember.
         */
        stopCountdown();

        const state = client.current();

        // Lost connection wins over everything: whatever is on screen is no longer
        // known to be current, and saying so is the difference between a quiet room and
        // a broken phone. The three states `ended` exists to separate are exactly these.
        if (connection === "lost") {
          /**
           * **Two causes, two sentences, and the difference is a promise we can keep.**
           * "Próbujemy połączyć ponownie" is true of a network wobble, which the SDK
           * retries on its own. It is not true of an exhausted account limit: there may be
           * no retry, and the wait is on someone else's action, not this phone's.
           *
           * The limit itself is deliberately unnamed. An attendee can do nothing with
           * "the account's connection ceiling is full", and a message that reads as "there
           * is no room for you" invites them to put the phone away. The diagnosis belongs
           * on the host's screen, where someone can act on it.
           */
          status(
            connectionCause === "account-limit"
              ? "Nie możemy Cię teraz podłączyć na żywo. Spróbuj odświeżyć stronę za chwilę."
              : "Utracono połączenie. Próbujemy połączyć ponownie…",
            "alarm"
          );
          setHidden(degradedNote, true);
          hideAnswerControls();
          /**
           * **The question goes too, and this was the one `render()` path that never said so**
           * (impl review F6). `hideAnswerControls` reaches the submit and the three fields,
           * but the option buttons live inside `#question` — so the previous prompt stayed on
           * screen under the alarm with its buttons still live. A tap ran `onSelect` →
           * `render()`, which returns here without repainting: `aria-pressed` never moved and
           * the tap did nothing, silently, on the one screen that is already telling the
           * attendee something is wrong.
           *
           * It also settles `data-waiting`, which otherwise kept whatever the previous phase
           * left — so the alarm sat at the top or at the foot depending on where the session
           * happened to be when the channel went.
           */
          showQuestion(false);
          setHidden(standingsBox, true);
          return;
        }

        /**
         * **`degraded` falls through to the ordinary rendering path, and that is the
         * entire fix.** The snapshot arrives on a timer instead of instantly, but it is
         * the same snapshot, and everything the controls below do — submitting, locking,
         * fetching a result — is HTTP and unaffected by the channel being gone.
         *
         * The banner is suppressed once the session is over: `ended` already says
         * everything, and "we refresh every few seconds" beside "that's it, thanks" is
         * noise about a transport nobody is waiting on any more.
         */
        setHidden(
          degradedNote,
          !(connection === "degraded" && state !== null && state.phase !== "ended")
        );

        /**
         * Hidden here, once, rather than in each of the branches below (roadmap S-07).
         *
         * Every other branch returns early, so a hide placed inside them would be five
         * copies of one rule and the next branch added would inherit none of them — the
         * board would then survive into a question and sit under it. The standings branch
         * unhides it as its first act.
         *
         * **Keyed on the field, not on the phase** (roadmap S-10). Two phases carry a board
         * now — the beat and the close — and the schema is what decides which; a phase list
         * here would be a second copy of that rule, and the copy is what falls behind. Same
         * rule the host view uses, for the same reason.
         */
        setHidden(standingsBox, state === null || state.standings === null);

        /**
         * The session is over — either closed by the host (`ended`) or gone (`null`, which
         * is what a purge looks like from a phone).
         *
         * **The two halves diverge below, and S-10 is why.** Everything in this block is
         * common: the answering state must go in both cases. What follows it splits, because
         * a closed session has a result to show and a purged one has nothing at all —
         * including no rank state worth keeping.
         *
         * Rendered as the end of the session either way, never as the name form: the session
         * really is over, and sending someone back to a form they cannot complete is the
         * worse of the two wrongs.
         */
        if (state === null || state.phase === "ended") {
          // Question ids are stable across sessions, so paint times left behind here
          // would be read back by the next one and score this device at the floor.
          // This is the one moment every still-watching device agrees it is over.
          clearSeen(config.seenStorageKey);
          /**
           * The in-memory half of the same cleanup, for the same reason.
           *
           * `clearSeen` only reaches storage. A host who purges and restarts mid-event
           * while this device stays on the page would otherwise re-open a question with
           * the previous answer still in the field and the previous result still in the
           * panel — question ids being stable is exactly what makes them line up again.
           * A reload happens to clear all four, which is why this went unnoticed.
           */
          typed.clear();
          selections.clear();
          results.clear();
          resultRequested.clear();
          // The field itself is a live DOM element and holds its own value; without
          // this the reconciliation guard sees an unchanged question id and never
          // rewrites it.
          answerText.value = "";
          delete answerText.dataset.questionId;
          answerNumber.value = "";
          delete answerNumber.dataset.questionId;
          answerWord.value = "";
          delete answerWord.dataset.questionId;

          /**
           * THE SPLIT (roadmap S-10). A purged session clears the rank state; a closed one
           * must not.
           *
           * The clearing half is not hypothetical (roadmap S-07): a host who purges and
           * restarts mid-event gets a session whose versions begin again at 1, so a stale
           * `rankVersion` from the previous room can match a beat in the new one — and this
           * device would then show a position it earned in a session that no longer exists,
           * without issuing a fetch that would correct it.
           *
           * Doing the same on `ended` would be worse than useless: `renderBoard` below keys
           * its one fetch per beat on `rankVersion !== state.version`, and `render()` runs
           * again on every connection transition, so clearing here would re-issue the
           * request on each one — a fetch loop on the closing screen, which is the moment
           * every device in the room is still watching.
           */
          if (state === null) {
            status("To już koniec. Dzięki za grę!", "headline");
            showQuestion(false);
            hideAnswerControls();
            rank = null;
            rankVersion = null;
            rankPending = false;
            return;
          }

          renderBoard(state);
          return;
        }

        if (state.phase === "lobby") {
          status("Jesteś w grze. Czekamy na prowadzącego…", "headline");
          showQuestion(false);
          hideAnswerControls();
          return;
        }

        if (state.phase === "standings") {
          renderBoard(state);
          return;
        }

        const id = state.currentQuestionId;
        const position = id === null ? -1 : indexOfQuestion(id);
        const label =
          position === -1
            ? "Pytanie"
            : `Pytanie ${position + 1} z ${config.questions.length}`;

        status(
          state.phase === "question-revealed" ? `${label} — odpowiedź ujawniona` : label,
          "label"
        );

        showQuestion(true);

        // An id absent from the projection means the definition changed under a live
        // session. `renderQuestion` shows a neutral placeholder rather than an error.
        const question = position === -1 ? undefined : config.questions[position];

        if (state.phase === "question-revealed") {
          renderRevealed(
            question,
            state.revealedOptionIds ?? null,
            state.revealedAnswerText ?? null
          );
          return;
        }

        renderOpen(question, state.updatedAt);
      }

      /**
       * The leaderboard, on the attendee's own phone — **the beat and the close, in one
       * function** (roadmap S-07, FR-014; extended by S-10, FR-006).
       *
       * Two halves that fail independently, and keeping them independent is the point:
       *
       * - **The board comes with the snapshot** and is painted unconditionally, in the
       *   order received. Same list, same order, same five names as the projector, because
       *   neither sorts. A device that never joined, or whose own fetch fails, still sees
       *   the standings the room is looking at.
       * - **The position is per device** and arrives from `/api/quiz/result`. A failure
       *   costs this one line and nothing else — the same split S-03 established for the
       *   accepted answer and the score, and for the same reason.
       *
       * **One function rather than a closing copy of it**, because the version-keyed fetch
       * below has a guard that took an implementation review to get right (F6). A second
       * copy would be a second chance to get it wrong, on the screen the room ends on.
       * What the phase changes is the heading and the winner's emphasis.
       */
      function renderBoard(state: NonNullable<ReturnType<SessionClient["current"]>>): void {
        const closing = state.phase === "ended";
        const board = state.standings;

        status(
          closing
            ? // A close whose board read failed lands here with nothing to show, and says
              // what it always said rather than promising a result that is not coming.
              board === null
              ? "To już koniec. Dzięki za grę!"
              : "Koniec! Oto wyniki."
            : "Ranking",
          "headline"
        );
        /**
         * The confetti, on every phone in the room (phase 5).
         *
         * **Only at the close, and only once.** `renderBoard` also paints the standings
         * beat between questions, so the phase test is what keeps the celebration for the
         * end rather than for every leaderboard; and this function runs again on every
         * snapshot, poll and connection flap for as long as the closing screen is up, which
         * is what `fire`'s per-signature guard is for.
         *
         * Keyed by the winner as well as the phase, so a second session started in the same
         * tab celebrates again rather than being mistaken for the first one still ending.
         * A boardless close still fires: the session ended either way, and the room does not
         * owe its confetti to a tally read that happened to fail.
         */
        if (closing) {
          celebration.fire(`ended|${board?.rows[0]?.displayName ?? ""}`);
        }
        // Not a waiting screen: the board is the thing to read, and it belongs under the
        // heading rather than pushed to the foot of the phone with a gap above it.
        showQuestion(false, false);
        hideAnswerControls();
        setHidden(resultPanel, true);
        setHidden(answerAccepted, true);

        renderStandings(standingsBoard, board?.rows, {
          // Its own row, matched on the name this device stored — which is the one the
          // server returned, so exact equality is enough and no fold is needed. See
          // `renderStandings`.
          ownDisplayName: player?.displayName ?? null,
          animate: true,
          // The same key the projector uses, for the same reason: the standings beat and
          // the close publish the same rows, and without it the close would inherit the
          // earlier signature and arrive silently.
          motionKey: closing ? "ended" : "standings",
          // The winner set apart at the close, as a first-child variant rather than a new
          // `renderStandings` option: it is presentation, and the renderer's job is the
          // published order. `[&>li:first-child>span]` reaches the spans a row is built from.
          list: closing
            ? "flex flex-col gap-2 [&>li:first-child>span]:text-[40px] " +
              "[&>li:first-child>span]:font-extrabold [&>li:first-child]:bg-quiz-chrome " +
              "[&>li:first-child]:text-quiz-ink"
            : "flex flex-col gap-2",
          row:
            "grid grid-cols-[auto_1fr_auto_auto] items-baseline gap-4 rounded-[18px] " +
            "bg-quiz-asphalt px-4 py-3 text-[26px] font-semibold leading-[32px] " +
            // Own row in the chrome tint — the same fill a picked option takes, because it
            // answers the same question: which of these is mine.
            "data-[own=true]:bg-quiz-chrome-tint",
          // No `rowOwn`: the highlight rides `data-own`, which the renderer already sets, for
          // the reason the option rows carry theirs as variants.
          /**
           * **The first-row colours are ink-on-chrome, so they may only apply where the
           * chrome ground does** — which is the closing board and nowhere else (impl review
           * F1). Unconditional, they painted the leader's points at ~1.06:1 against the
           * asphalt row in the `standings` phase: the top score, invisible, on every phone,
           * at every leaderboard beat.
           */
          rank: closing
            ? "tabular-nums text-quiz-zinc [li:first-child>&]:text-quiz-ink-on-chrome"
            : "tabular-nums text-quiz-zinc",
          name: "truncate",
          points: closing
            ? "tabular-nums [li:first-child>&]:text-quiz-ink"
            : "tabular-nums",
          /**
           * THE MOVEMENT CELL (this change), at phone scale.
           *
           * Smaller than the points beside it — the row is already `text-[26px]` and a
           * fourth figure at the same size makes four columns of equal weight out of a line
           * that should read name-first.
           *
           * `min-w-[3ch]` holds the column so names truncate at a fixed width rather than at
           * one that depends on who moved this beat — and it is the *only* thing holding it.
           * A `shrink-0` sat here until impl review F3: the row is a grid, so `flex-shrink`
           * never applied to its children, and the class read as load-bearing while doing
           * nothing. What absorbs a narrow screen is `truncate` on the name, as before.
           *
           * No first-child override is needed here: the own row is `chrome-tint`, which is
           * near-black, and the closing screen's chrome bar carries no deltas to colour.
           */
          delta:
            "min-w-[3ch] text-[20px] leading-[26px] tabular-nums font-semibold",
          deltaUp: "text-quiz-mint",
          deltaDown: "text-quiz-signal",
          empty: "text-[26px] leading-[32px] text-quiz-echo",
        });

        /**
         * A device with no claim: no position to tell it about.
         *
         * **Unreachable by construction, and kept deliberately** (S-10 implementation
         * review, F1). `render()` returns early unless `joined`, and `joined` is set only
         * inside `enterSession`, which sets `player` in the same breath — so nothing
         * without a claim reaches this function at all. The comment here used to say "a
         * spectator can watch the board", which described a mode this view does not have,
         * and a plan's verification row was written against that sentence before the review
         * traced it. Corrected rather than deleted: the guard costs nothing and is the right
         * behaviour if the two flags ever decouple.
         */
        if (!player) {
          setText("standings-you", "");
          return;
        }

        /**
         * A close whose board read failed (roadmap S-10). `render()` hides the whole section
         * when there is no board, so a position fetched here would paint into a hidden line
         * — one request per device spent on nothing, on the one path where the store is
         * already known to be struggling. Unreachable in the `standings` phase, where the
         * schema requires a board.
         */
        if (board === null) {
          setText("standings-you", "");
          return;
        }

        // A fresh beat. Keyed by version rather than by question, because the host may
        // show the standings twice between the same pair of questions and each is a new
        // board — see the note on `rankVersion`. The close is one more such beat: it has
        // its own version, so it asks once and re-renders freely afterwards.
        if (rankVersion !== state.version) {
          rankVersion = state.version;
          rank = null;
          rankPending = true;
          renderOwnPosition(state.playerCount);

          const beat = state.version;

          /**
           * **The closing snapshot carries no question id, and the route refuses a request
           * without one** — a 400, which would reach this device as a silently absent
           * position. So the close sends the last question in the definition.
           *
           * It is not a lie and not a workaround around the gate: `/api/quiz/result` ignores
           * the field in both the standings and the ended branches, because a *position* is
           * not about a question. The field stays required there because rejecting a formless
           * request is the cheaper contract, and this is what paying it looks like.
           */
          const askAbout =
            state.currentQuestionId ?? config.questions[config.questions.length - 1]?.id ?? "";

          void fetchResult(player.id, askAbout).then((own) => {
            /**
             * **Guarded against the LIVE state, not against `rankVersion`** (impl review F6).
             *
             * The first version compared `rankVersion` — a module value this function is the
             * only writer of — against the version captured in this closure, and claimed to
             * discard a reply that landed after the room moved on. It could not: those two
             * are equal unless a *newer standings beat* arrived, so a reply landing during
             * the next question passed the guard and painted a position. It was invisible
             * only because `#standings-you` is hidden by then, two functions away — a
             * safety property provided by something other than the line claiming it.
             *
             * Reading `client.current()` asks the question the comment always meant to ask.
             * The phase check also closes the purge hole: versions restart at 1, so a reply
             * captured at version 7 could otherwise land inside a new session's version-7
             * beat.
             *
             * **Both board-carrying phases pass it** (roadmap S-10), and the check is on the
             * board rather than on a phase list for the reason the visibility rule in
             * `render()` is: the schema decides where a board may appear, and a list here
             * would be a copy of that rule able to fall behind it. A reply landing after the
             * room moved to a question still fails — that state carries no board.
             */
            const live = client.current();
            if (live === null || live.standings === null || live.version !== beat) return;
            rankPending = false;
            rank = own?.rank ?? null;
            // From the live snapshot rather than the captured one — same field either way
            // (F3), and this is the fresher of the two.
            renderOwnPosition(live.playerCount);
          });
          return;
        }

        renderOwnPosition(state.playerCount);
      }

      /**
       * The attendee's own line under the board.
       *
       * The copy itself lives in `standingsPositionText`, where it is unit-tested — the
       * absent-rank branch is one `lessons.md` has an entry about, and a page has no
       * harness to reach it from.
       *
       * **The denominator is the snapshot's `playerCount`, not the board's** (impl review
       * F3). The board carries its own count, taken in the same read as the rows, and using
       * it looks like the more consistent choice — that was the first implementation and it
       * was wrong. The host screen renders the *snapshot's* count, which `applyHostAction`
       * refreshes with a fresh `HLEN` after the board is built, so the two numbers genuinely
       * differ when a join lands between the reads. Phones reading "z 149" beside a projector
       * reading "150" is the divergence the PRD guardrail is about; a denominator one beat
       * fresher than the rows it describes is invisible.
       */
      function renderOwnPosition(playerCount: number | null): void {
        setText("standings-you", standingsPositionText(rank, playerCount, rankPending));
      }

      /**
       * The countdown (roadmap S-11, FR-020).
       *
       * **The state machine lives in `countdown.ts`, not here, and that is the fix for a
       * defect rather than tidiness.** The first version was inline, and an inline
       * `<script>` has no harness — so a recursion between the clock and this renderer
       * shipped behind a green suite and a passing source scan. The module is unit-tested
       * with fake timers; what stays here is only the wiring.
       *
       * **`stop()` runs at the top of every `render()`**, so no branch — reveal, standings,
       * lobby, `ended`, a lost connection — can leave a clock ticking for a question that
       * has left the screen. Only the `question-open` path starts one again.
       *
       * **`onExpire` is the only path back into `render`.** `start` reports an
       * already-closed window by return value instead, because it runs *inside* a render
       * and re-entering from there is precisely what crashed.
       */
      /**
       * One handle for the page, because the fire-once guard is state and a per-render
       * handle would forget it every snapshot — the same reason `countdown` below is one
       * object rather than a function called from `render`.
       */
      const celebration = createCelebration();

      const countdown = createCountdown({
        onPaint: (remainingMs, limitMs) => {
          renderCountdown(countdownBox, remainingMs, limitMs);
          /**
           * The last five seconds, in `signal`.
           *
           * On the container rather than on the two elements, so the number and the bar
           * cannot disagree about whether the hurry has started — the same reason
           * `renderCountdown` paints text and geometry in one call, and the reason this line
           * lives beside it rather than anywhere else. Nothing else changes: no size, no
           * motion, no sound. It is a colour, because an attendee is reading a phone in a
           * dark room and a moving clock is already saying the rest.
           *
           * **That sentence is about the clock, and it still holds — but it is no longer
           * the whole view's position.** It was the project's only statement about motion
           * on the phone, and it was read as one: this view now lands its option rows, its
           * acknowledgement, its result panel and its award through `motion.ts`. What
           * stays refused is motion *here*, on a clock that is already the moving thing on
           * screen, and anything that competes with the seconds an attendee is reading.
           * See `motion-contract.md`.
           */
          countdownBox.dataset.urgent = String(remainingMs <= URGENT_MS);
        },
        // Reaching zero changes what is on screen — the controls come off — so it goes
        // through the ordinary state machine rather than editing the DOM from here.
        onExpire: () => render(),
      });

      /** Where the clock turns `signal`. Five seconds, matching the plan's phone spec. */
      const URGENT_MS = 5_000;

      function stopCountdown(): void {
        countdown.stop();
        setHidden(countdownBox, true);
      }

      /**
       * Shows the clock for the open question and answers whether its window has already
       * closed.
       *
       * `openedAt` is the snapshot's `updatedAt` — the moment the host opened this
       * question, and the same value the server measures the window from. That is what
       * keeps this phone, every other phone and the projector on one clock: nothing here is
       * derived from when *this* device happened to paint.
       */
      function startCountdown(question: PublicQuestion, openedAt: number): boolean {
        if (question.timeLimitSeconds === undefined) return false;

        setHidden(countdownBox, false);
        return countdown.start(openedAt, question.timeLimitSeconds);
      }

      /** Every answering control off, in one call, so no branch can leave one behind. */
      function hideAnswerControls(): void {
        setHidden(answerSubmit, true);
        setHidden(answerText, true);
        setHidden(answerNumber, true);
        setHidden(answerWord, true);
        setHidden(answerNote, true);
        setHidden(answerAccepted, true);
        setHidden(resultPanel, true);
        answerError("");
      }

      /**
       * THE ONLY WRITER OF THE NOTE UNDER THE FIELD (this change).
       *
       * It was ten bare `textContent` assignments, and the arrival is why they became one
       * function rather than eleven: an acknowledgement that lands is worth nothing if
       * nine of the ten sentences still blink into place, and `say()` on the host view is
       * the same shape for the same reason.
       *
       * **Keyed by the sentence itself**, so the note moves when what it says changes and
       * stands still otherwise. That is what keeps it quiet during typing: `render()` runs
       * on every snapshot while a field is being filled in, and the word field's own
       * handler rewrites this note on each keystroke — both re-write the same string, and
       * an unchanged string is not an arrival.
       */
      function noteSays(text: string): void {
        answerNote.textContent = text;
        renderEntrance(answerNote, text, { enabled: true });
      }

      /**
       * `question-open` — the answering beat.
       *
       * The paint time is recorded first and read back if this device has seen the
       * question before, which is what makes a reload keep its original clock rather
       * than restarting it at full speed weight.
       */
      function renderOpen(question: PublicQuestion | undefined, openedAt: number): void {
        setHidden(resultPanel, true);
        setHidden(answerAccepted, true);

        /**
         * **Every kind is answerable now (roadmap S-08 took the last one).** The branch is
         * kept rather than collapsed to `question !== undefined`, because the thing it
         * actually guards is a question id absent from the projection — a definition changed
         * under a live session — and a sixth kind added later must land in the static
         * placeholder rather than in whichever branch happens to fall through.
         */
        const answerable =
          question !== undefined &&
          (question.kind === "single-choice" ||
            question.kind === "multiple-choice" ||
            question.kind === "text" ||
            question.kind === "number" ||
            question.kind === "word-cloud");

        if (!question || !answerable) {
          // Static text, and no control — something tappable that does nothing reads as a
          // broken quiz.
          renderQuestion(questionBox, question, {
            prompt: PROMPT_CLASS,
            list: OPTION_LIST,
            option: OPTION_CLASS,
          });
          hideAnswerControls();
          return;
        }

        /**
         * The clock starts before the kind dispatch, because the rule is the same for all
         * of them and because `timeUp` below has to be decided once.
         */
        const timeUp = startCountdown(question, openedAt);

        /**
         * **Out of time, and this device never answered.**
         *
         * Checked before the kind branches so there is one timed-out screen rather than
         * four, and `hasSubmitted` is read first because an attendee who *did* answer must
         * keep seeing their confirmation — for them the clock running out changes nothing.
         *
         * Nothing here marks the question as submitted. The server recorded no answer, and
         * saying otherwise would put a result panel on screen at the reveal for an answer
         * that does not exist.
         */
        if (timeUp && !hasSubmitted(config.seenStorageKey, question.id)) {
          renderTimedOut(question);
          return;
        }

        if (question.kind === "text") {
          renderOpenText(question);
          return;
        }

        if (question.kind === "number") {
          renderOpenNumber(question);
          return;
        }

        if (question.kind === "word-cloud") {
          renderOpenWord(question);
          return;
        }

        // A choice question has no field. Hidden explicitly because this branch does not
        // call `hideAnswerControls`.
        setHidden(answerText, true);
        setHidden(answerNumber, true);
        setHidden(answerWord, true);

        markSeen(config.seenStorageKey, question.id);
        dressControlsFor(question.id);

        const selected = pickedOptionIds(question.id);
        // Read from storage, not from memory: a reload mid-question must not re-offer
        // the controls for an answer the store has already accepted.
        const locked = hasSubmitted(config.seenStorageKey, question.id);

        renderQuestion(questionBox, question, {
          prompt: PROMPT_CLASS,
          list: OPTION_LIST,
          option: OPTION_CLASS,
          mode: locked ? "static" : "answerable",
          selectedOptionIds: selected,
          /**
           * The rows land when the question arrives; the prompt is painted final, because
           * it is the thing the reader needs first and the clock is already running.
           *
           * Keyed by the question's id alone — deliberately not by the mode or the
           * selection, both of which change under the reader's thumb: tapping an option
           * re-renders this whole block, and a key that moved with it would restart the
           * list mid-tap.
           */
          animate: true,
          onSelect: (next) => {
            selections.set(question.id, next);
            render();
          },
        });

        setHidden(answerNote, false);
        if (locked) {
          // Confirmed, and nothing about correctness — that waits for the host.
          noteSays("Odpowiedź zapisana. Czekamy na prowadzącego…");
          setHidden(answerSubmit, true);
          return;
        }

        // FR-017: say up front that a warm-up is a warm-up. Driven by `scored` from the
        // projection, never inferred from a zero award — the payloads are identical.
        noteSays(
          question.scored
          ? question.kind === "multiple-choice"
            ? "Możesz wybrać kilka odpowiedzi. Liczy się też czas."
            : "Liczy się też czas — im szybciej, tym więcej punktów."
          : "To pytanie na rozgrzewkę — bez punktów.",
        );

        setHidden(answerSubmit, false);
        answerSubmit.disabled = selected.length === 0;
      }

      /**
       * `question-open`, but the window has closed on a device that did not answer
       * (roadmap S-11, FR-020).
       *
       * The prompt stays on screen — the question has not gone anywhere, and the host has
       * not advanced — with every control gone and one sentence saying why. Deliberately
       * **not** the `notOpen` wording: the question *is* open, and telling an attendee it
       * closed while the projector still shows it is the kind of small contradiction that
       * produces a hand in the air.
       *
       * The controls come off client-side as a courtesy, not as the rule. The server is
       * still the only thing that decides, which is why a phone whose clock is a little
       * fast costs its owner nothing they would not have lost anyway.
       */
      function renderTimedOut(question: PublicQuestion): void {
        renderQuestion(questionBox, question, {
          prompt: PROMPT_CLASS,
          list: OPTION_LIST,
          option: OPTION_CLASS,
        });

        hideAnswerControls();
        setHidden(answerNote, false);
        noteSays("Czas minął. Czekamy na prowadzącego…");
      }

      /**
       * `question-open` for a free-text question (roadmap S-05, FR-011).
       *
       * Same beats as the choice path — paint clock, lock, note, disabled-until-valid
       * submit — with a field instead of buttons.
       */
      function renderOpenText(question: PublicQuestion): void {
        // Prompt only. A text question has no options, so `renderQuestion` draws the
        // prompt and returns; the field lives outside this container on purpose.
        renderQuestion(questionBox, question, {
          prompt: PROMPT_CLASS,
        });

        markSeen(config.seenStorageKey, question.id);
        dressControlsFor(question.id);

        const locked = hasSubmitted(config.seenStorageKey, question.id);

        /**
         * **The reconciliation rule, and both of the obvious readings are wrong.**
         *
         * The input is a live DOM element holding its own value; the Map is the
         * per-question record. Written from the Map on every `render()`, it would
         * clobber whatever the attendee is mid-way through typing — and `render()` fires
         * on every snapshot, so another attendee joining is enough to trigger it.
         * Written never, advancing between two text questions would leave the previous
         * answer sitting in the field.
         *
         * So: write it only when the question being rendered is not the one the element
         * currently holds, tracked by `data-question-id` on the element itself.
         */
        if (answerText.dataset.questionId !== question.id) {
          answerText.dataset.questionId = question.id;
          // Storage first, memory second. The Map does not survive a reload, and the
          // server will not serve this device its own answer back until the reveal — so
          // without the stored copy a reloaded, locked field would sit empty under
          // "Odpowiedź zapisana", which is the one moment it needs to show something.
          answerText.value =
            submittedText(config.seenStorageKey, question.id) ?? typed.get(question.id) ?? "";
        }

        setHidden(answerText, false);
        setHidden(answerNumber, true);
        // Disabled rather than hidden once locked: the attendee should still see what
        // they sent.
        answerText.disabled = locked;

        setHidden(answerNote, false);
        if (locked) {
          noteSays("Odpowiedź zapisana. Czekamy na prowadzącego…");
          setHidden(answerSubmit, true);
          return;
        }

        // FR-017, same rule as the choice path: driven by `scored`, never inferred from
        // a zero award.
        noteSays(
          question.scored
          ? "Wpisz odpowiedź. Liczy się też czas — im szybciej, tym więcej punktów."
          : "To pytanie na rozgrzewkę — bez punktów.",
        );

        setHidden(answerSubmit, false);
        answerSubmit.disabled = !hasTypedAnswer();
      }

      /**
       * `question-open` for a number question (roadmap S-06, FR-013).
       *
       * The text path with one field swapped and one rule changed — the submit gate is
       * "contains a digit" rather than "contains anything". Kept as its own function
       * rather than parameterising `renderOpenText`, because the two differ in the note
       * copy, the enable rule and the element, which is most of the body.
       */
      function renderOpenNumber(question: PublicQuestion): void {
        // Prompt only; the field lives outside the container that `render()` rebuilds.
        renderQuestion(questionBox, question, {
          prompt: PROMPT_CLASS,
        });

        markSeen(config.seenStorageKey, question.id);
        dressControlsFor(question.id);

        const locked = hasSubmitted(config.seenStorageKey, question.id);

        // The same reconciliation rule as the text field, and for the same reason —
        // see `renderOpenText`. Written only when the element is holding a different
        // question, so a snapshot mid-keystroke cannot clobber what is being typed.
        if (answerNumber.dataset.questionId !== question.id) {
          answerNumber.dataset.questionId = question.id;
          answerNumber.value =
            submittedText(config.seenStorageKey, question.id) ?? typed.get(question.id) ?? "";
        }

        setHidden(answerNumber, false);
        setHidden(answerText, true);
        // Disabled rather than hidden once locked, so the attendee still sees the
        // number they sent.
        answerNumber.disabled = locked;

        setHidden(answerNote, false);
        if (locked) {
          noteSays("Odpowiedź zapisana. Czekamy na prowadzącego…");
          setHidden(answerSubmit, true);
          return;
        }

        /**
         * FR-017 as everywhere else, driven by `scored`. The scored line says closeness
         * counts **without naming a threshold**: the bands are deliberately not exposed
         * to the attendee, because a number on screen is something to argue with at the
         * busiest moment of the beat.
         */
        noteSays(
          question.scored
          ? "Nie musisz trafić idealnie — im bliżej, tym więcej punktów. Liczy się też czas."
          : "To pytanie na rozgrzewkę — bez punktów.",
        );

        setHidden(answerSubmit, false);
        answerSubmit.disabled = !hasTypedGuess();
      }

      /**
       * `question-open` for a word-cloud question (roadmap S-08, FR-012).
       *
       * The same five beats as the text and number paths — paint clock, reconciliation,
       * lock, note, disabled-until-valid submit — and its own function for the same reason
       * `renderOpenNumber` is: the copy, the enable rule and the element are what differ,
       * which is most of the body.
       *
       * **The copy is the one real difference and it is deliberate.** Every other unscored
       * beat says "bez punktów", which frames the question as something the attendee missed
       * out on. This is the question the PRD kept knowing it was the most expensive view in
       * the set, because watching your own word land on the big screen is what proves the
       * session is live — so the note points at the screen instead of apologising for the
       * absence of points.
       */
      function renderOpenWord(question: PublicQuestion): void {
        // Prompt only; the field is a static sibling outside the container `render()`
        // rebuilds.
        renderQuestion(questionBox, question, {
          prompt: PROMPT_CLASS,
        });

        markSeen(config.seenStorageKey, question.id);
        dressControlsFor(question.id);

        const locked = hasSubmitted(config.seenStorageKey, question.id);

        // The same reconciliation rule as the other two fields, and for the same reason —
        // see `renderOpenText`. Written only when the element holds a different question, so
        // a snapshot arriving mid-keystroke cannot clobber what is being typed.
        if (answerWord.dataset.questionId !== question.id) {
          answerWord.dataset.questionId = question.id;
          answerWord.value =
            submittedText(config.seenStorageKey, question.id) ?? typed.get(question.id) ?? "";
        }

        setHidden(answerWord, false);
        setHidden(answerText, true);
        setHidden(answerNumber, true);
        // Disabled rather than hidden once locked, so the attendee still sees the word they
        // sent — and can compare it with the chip on the projector.
        answerWord.disabled = locked;

        setHidden(answerNote, false);
        if (locked) {
          noteSays("Słowo wysłane! Zobacz duży ekran.");
          setHidden(answerSubmit, true);
          return;
        }

        // No `scored` branch, unlike every other kind: the build gate refuses a scored
        // word-cloud question, so there is no second case to write copy for.
        noteSays(wordNoteText());

        setHidden(answerSubmit, false);
        answerSubmit.disabled = !hasTypedWord();
      }

      /**
       * Which options this device has on this question — submitted, or still being chosen.
       *
       * **Storage first, memory second, and the order is the fix.** `selections` is a `Map`
       * that a reload empties, so before this the locked screen and the reveal both lost the
       * mark on an attendee's own answer the moment they refreshed. The store holds what was
       * actually accepted, so it wins wherever it has something; memory covers the live case,
       * where nothing has been submitted yet and there is nothing in the store to find.
       *
       * The same shape as `submittedText`'s use for the typed kinds, which had this right
       * from S-05 — this is the choice kinds catching up.
       */
      function pickedOptionIds(questionId: string): readonly string[] {
        return (
          submittedOptionIds(config.seenStorageKey, questionId) ??
          selections.get(questionId) ??
          []
        );
      }

      /** Whether the field holds anything but whitespace. The server is the real judge. */
      function hasTypedAnswer(): boolean {
        return answerText.value.trim().length > 0;
      }

      /**
       * What the note above the word field says, which is also **the only place the gate is
       * visible** (signage redesign, step 8).
       *
       * The submit button greys out for two reasons an attendee can see they caused — nothing
       * typed, or a space in the middle — and a disabled button that does not say why is the
       * failure `lessons.md` opens with, in miniature. The empty case explains itself; the
       * space case does not, so it gets a sentence.
       *
       * It says nothing about the character allowlist or the length bound. Those are the
       * server's, they do not gate this button, and a note about a rule the button is not
       * enforcing is worse than no note.
       */
      function wordNoteText(): string {
        const value = answerWord.value.trim();
        return value.length > 0 && /\s/.test(value)
          ? "To musi być jedno słowo — bez spacji."
          : "Napisz jedno słowo — pojawi się na dużym ekranie.";
      }

      /**
       * Whether the word field holds something that could be one word.
       *
       * **A loose test, deliberately not a copy of `validateWord`.** That function is
       * server-side and lives under `src/lib/session/`, which `boundary.test.ts` refuses to
       * let this script value-import — and two validators that disagree would refuse an
       * answer the server would have accepted, or enable a button for one it will not. All
       * this decides is whether the button is tappable: an over-permissive gate costs a
       * refusal the attendee can read, an over-strict one silently blocks a legitimate word.
       *
       * It checks the two rules an attendee can *see* they broke — nothing typed, or a space
       * in the middle. The length bound is enforced by the input's `maxlength` and by the
       * server; the character allowlist is the server's alone, because a disallowed
       * character is not something a greyed-out button explains.
       */
      function hasTypedWord(): boolean {
        const value = answerWord.value.trim();
        return value.length > 0 && !/\s/.test(value);
      }

      /**
       * Whether the numeric field holds anything that could be a number.
       *
       * **A loose test, deliberately not a parse.** `src/lib/session/guess.ts` is the
       * only parser and it is server-side; a client-side one would either duplicate it
       * or cross the boundary `boundary.test.ts` enforces, and two parsers that
       * disagree is a scoring dispute on stage. All this decides is whether the submit
       * button is tappable — an over-permissive gate costs a refusal the attendee can
       * read, while an over-strict one silently blocks a legitimate answer.
       */
      function hasTypedGuess(): boolean {
        return /\d/.test(answerNumber.value);
      }

      /**
       * Typing updates the Map and the submit button directly — **never through
       * `render()`**, which would rebuild the question container and fight the field.
       */
      answerText.addEventListener("input", () => {
        const questionId = answerText.dataset.questionId;
        if (questionId) typed.set(questionId, answerText.value);

        answerSubmit.disabled = answerText.disabled || !hasTypedAnswer();
      });

      /** The same, for the numeric field. Same reason it bypasses `render()`. */
      answerNumber.addEventListener("input", () => {
        const questionId = answerNumber.dataset.questionId;
        if (questionId) typed.set(questionId, answerNumber.value);

        answerSubmit.disabled = answerNumber.disabled || !hasTypedGuess();
      });

      /** And for the word field. Same reason again: `render()` would fight the input. */
      answerWord.addEventListener("input", () => {
        const questionId = answerWord.dataset.questionId;
        if (questionId) typed.set(questionId, answerWord.value);

        answerSubmit.disabled = answerWord.disabled || !hasTypedWord();
        // The note is part of the gate, so it has to move with the button rather than waiting
        // for a render that deliberately never comes while a field is being typed into.
        noteSays(wordNoteText());
      });

      /**
       * `question-revealed` — the payoff beat.
       *
       * The correct answer comes from the snapshot, so it is on screen before any
       * request is made. **If the per-device fetch fails, that is what stays on
       * screen** — the split between broadcast correctness and per-device scoring
       * exists precisely so a failed fetch costs the score line and nothing more.
       */
      function renderRevealed(
        question: PublicQuestion | undefined,
        revealedOptionIds: readonly string[] | null,
        revealedAnswerText: string | null
      ): void {
        setHidden(answerSubmit, true);
        setHidden(answerText, true);
        setHidden(answerNumber, true);
        setHidden(answerWord, true);
        setHidden(answerNote, true);
        answerError("");

        renderQuestion(questionBox, question, {
          prompt: PROMPT_CLASS,
          list: OPTION_LIST,
          option: OPTION_CLASS,
          // No `optionSelected` / `optionCorrect` / `optionWrong`: both states are carried by
          // the `data-` attributes the renderer already sets, read as variants in
          // `OPTION_CLASS`. An appended class here would be the same kind of rule as the base
          // it overrides, and stylesheet order would decide the reveal's colours.
          mode: "revealed",
          selectedOptionIds: pickedOptionIds(question?.id ?? ""),
          correctOptionIds: revealedOptionIds,
        });

        /**
         * **The accepted answer, and it is rendered before and independently of the
         * fetch.** That is the whole reason it rides the snapshot: a device that stayed
         * silent, and one whose per-device fetch fails, must still learn the answer. A
         * failed fetch costs the score line and the echo, never this.
         */
        const hasAccepted = revealedAnswerText !== null && revealedAnswerText.length > 0;
        setHidden(answerAccepted, !hasAccepted);
        if (hasAccepted) {
          answerAccepted.textContent = `Poprawna odpowiedź: ${revealedAnswerText}`;
        }

        if (!question) {
          setHidden(resultPanel, true);
          return;
        }

        // A device that stayed silent sees the correct answer and no verdict. Read
        // from storage so a reload between answering and the reveal does not turn an
        // attendee who answered into one who apparently did not.
        if (!hasSubmitted(config.seenStorageKey, question.id)) {
          setHidden(resultPanel, true);
          return;
        }

        /**
         * The word cloud's own reveal (roadmap S-08, FR-012).
         *
         * **Branched on KIND before `scored`, and the order is the point** — the ordering
         * S-06 established for the number kind, here for a different conflation. Both
         * unscored kinds fall through the same `scored` gate below, but the copy there says
         * "To była rozgrzewka — bez punktów", which frames the question as something the
         * attendee missed out on. This is the question the PRD kept *because* it is the
         * moment that proves the session is live, so it gets its own line pointing at the
         * cloud the room is looking at.
         *
         * **No result fetch**, exactly as the unscored branch below: there is no award to
         * ask for, and this keeps the fan-in gate intact — 2 of the 14 questions removed
         * from 150 devices per reveal.
         *
         * The word comes from storage rather than from the server, unlike the free-text
         * echo: `/api/quiz/result` would serve it, but spending a request to be told
         * something this device already wrote down is the fetch the gate exists to avoid.
         * A device that cleared storage sees the line without the word, which is honest.
         */
        if (question.kind === "word-cloud") {
          setHidden(resultPanel, false);
          verdict("Dzięki za słowo!", "landed");
          /**
           * **Says the screen shows it in lower case, rather than pretending it matches** (impl
           * review F10). The echo below is the word as *typed*; the projector renders the fold,
           * so someone who typed `KAWA` sees `kawa` up there. The two genuinely differ and the
           * honest fix is to say so — this device cannot compute the fold, because `foldWord`
           * lives under `src/lib/session/` and `boundary.test.ts` refuses a value import from
           * there. A second, client-side fold would be the "two implementations that can
           * disagree" shape this project rejects for the guess parser, for a cosmetic line.
           */
          award("Na dużym ekranie zobaczysz je małymi literami.", "sentence");
          // Through `wordEchoText`, which owns the absent-word branch — see that function.
          setText("result-answer", wordEchoText(submittedText(config.seenStorageKey, question.id)));
          setText("result-total", "");
          return;
        }

        // An unscored question has no award to fetch, so asking would spend a request
        // to be told nothing — and this is 2 of the 14 questions removed from a fan-in
        // of 150 devices per reveal. The warm-up gets its own line instead.
        if (!question.scored) {
          setHidden(resultPanel, false);
          verdict("Dzięki za odpowiedź!", "landed");
          award("To była rozgrzewka — bez punktów.", "sentence");
          setText("result-answer", "");
          setText("result-total", "");
          return;
        }

        const known = results.get(question.id);
        if (known) {
          showResult(known, question);
          return;
        }

        // Not yet fetched. Issue it once — `render()` runs on every snapshot and every
        // tap, and an ungated fetch here would issue one per render.
        setHidden(resultPanel, true);
        if (!resultRequested.has(question.id) && player) {
          resultRequested.add(question.id);
          void fetchResult(player.id, question.id).then((own) => {
            // A failure leaves the correct answer on screen and says nothing else. It
            // is deliberately not retried and deliberately not an error message: the
            // attendee has the answer, and a red line about a score they cannot see is
            // worse than a missing one.
            if (own) {
              results.set(question.id, own);
              render();
            }
          });
        }
      }

      /**
       * THE AWARD LINE, AND THE TWO THINGS IT HOLDS (impl review F2).
       *
       * `+800 pkt` is a figure and wants the hero size; "To była rozgrzewka — bez punktów." is
       * a sentence and does not. Sized as a figure for both, the two unscored kinds — which
       * are questions 1 and 2 of the definition, so the *first two reveals of every session* —
       * filled a 390px screen with one sentence at 72px and pushed the echo and the running
       * total off it.
       *
       * The caller says which, exactly as it says which tone the verdict is in. Same reason
       * too: the size is part of what the line means, so it must be chosen where the words
       * are, not assumed by the element.
       */
      type AwardShape = "figure" | "sentence";

      const AWARD_SHAPES: Record<AwardShape, string> = {
        figure: "text-[72px] font-extrabold leading-[76px] tracking-[-0.04em]",
        sentence: "text-[30px] font-semibold leading-[38px]",
      };

      function award(text: string, shape: AwardShape): void {
        setText("result-award", text);
        el("result-award").className = AWARD_SHAPES[shape];
      }

      /**
       * The award, counted up to what was actually earned (this change).
       *
       * The `figure` shape only — a sentence has no number to count. **The true figure is
       * always written exactly at the end and reaches a device with no animation
       * immediately**: this is the number an attendee may be about to compare with the
       * person beside them, so the count is decoration over data that must not be in doubt.
       *
       * Keyed by the question *and* the figure, so a result that arrives late — the panel
       * painted from a fetch that resolved after the first render — counts up when it
       * lands rather than being treated as the same beat.
       */
      function awardCountUp(points: number, questionId: string): void {
        const node = el("result-award");
        node.className = AWARD_SHAPES.figure;
        renderFigureCountUp(
          node,
          points,
          `${questionId}|${points}`,
          (value) => `+${value} pkt`
        );
      }

      /**
       * THE VERDICT AND ITS COLOUR (signage redesign, step 9).
       *
       * Three readings the room's palette already has words for, and the middle one is why
       * this is a function rather than a class on the element:
       *
       * - `mint` — it landed. An exact hit, and the two unscored kinds' thank-yous, which are
       *   confirmations of the same sort.
       * - `chrome` — partial. `Blisko!` is the number kind's `correct: false` with a positive
       *   award, and painting it like a miss is precisely the conflation the exact-hit
       *   definition of `correct` was chosen to avoid.
       * - `zinc` — `Bez odpowiedzi`. Nothing happened, and nothing is being judged. Zinc is
       *   the labels' colour everywhere else, and it is borrowed here deliberately: this is
       *   the one verdict that is not a verdict.
       *
       * A plain miss keeps `signwhite`. `signal` is for a refusal or a failure — a wrong
       * answer is neither, and colouring it red would tell an attendee the *page* broke.
       *
       * The words and the colour are written together because they are one statement; setting
       * the text at one site and the tone at another is how they come apart.
       */
      type VerdictTone = "landed" | "partial" | "silent" | "miss";

      const VERDICT_BASE = "text-[56px] font-extrabold leading-[58px] tracking-[-0.035em]";
      const VERDICT_TONES: Record<VerdictTone, string> = {
        landed: "text-quiz-mint",
        partial: "text-quiz-chrome",
        silent: "text-quiz-zinc",
        miss: "text-quiz-signwhite",
      };

      function verdict(text: string, tone: VerdictTone): void {
        setText("result-verdict", text);
        el("result-verdict").className = `${VERDICT_BASE} ${VERDICT_TONES[tone]}`;
      }

      /**
       * Paints the running total, and retires the returning line in the same breath
       * (roadmap S-09).
       *
       * One function rather than three call sites, because the retirement is not a
       * separate concern from the paint: the returning line exists precisely until a
       * fresher number arrives, and two places that both claim to be this device's score
       * is the thing it must never become.
       */
      function paintTotal(total: number): void {
        setText("result-total", `Twój wynik: ${total} pkt`);
        setText("resume-total", "");
      }

      function showResult(own: OwnResult, question: PublicQuestion): void {
        setHidden(resultPanel, false);
        // The panel arrives once per question. After the unhide, so a panel that is not on
        // screen this render never animates — the entrance stays out of the visibility
        // rule's way, which is the projector's rule too.
        renderEntrance(resultPanel, question.id, { enabled: true });

        /**
         * **`answered: false` is not a wrong answer**, and the two must not share a
         * line. The server reports it for a device that stayed silent *and* for one
         * whose submission was refused — a phone that tapped as the host advanced
         * reaches here believing it answered. Telling it "Tym razem nie." would score
         * it for a question it never got to answer, which is exactly what the plan
         * says must not happen.
         *
         * The running total still travels: it is true regardless, and it is the one
         * thing that keeps the panel worth showing.
         */
        if (!own.answered) {
          verdict("Bez odpowiedzi", "silent");
          award("Tym razem nie zdążyliśmy zapisać Twojej odpowiedzi.", "sentence");
          setText("result-answer", "");
          paintTotal(own.total);
          return;
        }

        /**
         * **Selected by question KIND before it is selected by `correct`** (roadmap
         * S-06), and the order is the whole point.
         *
         * For a number question `correct` is exact-hit-only, so a guess that earned 800
         * of 1000 points comes back `correct: false`. A kind-blind branch renders "Tym
         * razem nie." beside a positive award — the conflation the exact-hit definition
         * was chosen to avoid. Partial credit is the first of its kind in the system;
         * every other kind is still binary and reads correctly through the branch below.
         */
        if (question.kind === "number") {
          showNumberResult(own, question.id);
          return;
        }

        verdict(own.correct ? "Dobrze!" : "Tym razem nie.", own.correct ? "landed" : "miss");
        awardCountUp(own.correct ? (own.awarded ?? 0) : 0, question.id);
        /**
         * The echo, for a free-text answer only — `null` on every other kind.
         *
         * From the server, not from the `typed` Map: that map does not survive a reload,
         * and an attendee who answered and then reloaded should still see their own
         * words. Omitted rather than rendered empty when there is nothing to echo, so a
         * choice question's panel is unchanged.
         */
        setText("result-answer", own.text ? `Twoja odpowiedź: ${own.text}` : "");
        paintTotal(own.total);
      }

      /**
       * The reveal copy for a guess (roadmap S-06, FR-013).
       *
       * Three readings, not two: an exact hit, a guess that scored something, and one
       * that scored nothing. The middle one is the reason this function exists — it is
       * `correct: false` with a positive award, and the ordinary copy would call it
       * wrong.
       *
       * **The relative error and the band are deliberately not on screen.** The panel
       * shows the answer, the guess and the award; an arithmetic breakdown invites a
       * dispute at the busiest moment of the beat, and the thresholds are not something
       * an attendee was ever told.
       *
       * The correct value itself is not repeated here — it is already on screen above,
       * from the snapshot, where it reaches a device whose fetch failed too.
       */
      function showNumberResult(own: OwnResult, questionId: string): void {
        const awarded = own.awarded ?? 0;

        verdict(
          own.correct ? "Dokładnie!" : awarded > 0 ? "Blisko!" : "Tym razem daleko.",
          own.correct ? "landed" : awarded > 0 ? "partial" : "miss"
        );
        // Counted rather than stated: this is the kind that carries partial credit, so the
        // figure is the whole answer to "how close was I".
        awardCountUp(awarded, questionId);
        /**
         * The guess from the server, not from the field — a reload empties the field
         * and the attendee should still see what they sent. `null` only if the record
         * predates this shipping, in which case there is nothing honest to show.
         *
         * **Rendered, not re-formatted.** `toLocaleString` was wrong here twice: it
         * runs per device, one line below a value `reveal.ts` formats on the *server*
         * precisely so 150 phones and the projector cannot disagree; and its default
         * `maximumFractionDigits` is 3, so a guess of `9800,5678` came back as
         * `9800,568` — a number the attendee did not type, shown at the exact moment a
         * scoring dispute would start.
         */
        setText("result-answer", own.value === null ? "" : `Twoja odpowiedź: ${own.value}`);
        paintTotal(own.total);
      }

      /**
       * The answer submit path.
       *
       * The in-flight guard lives in `answer.ts`; this one owns what the attendee sees
       * while it is in flight, exactly as the join button does.
       */
      async function sendAnswer(): Promise<void> {
        const state = client.current();
        const questionId = state?.currentQuestionId;
        if (!player || !questionId || state?.phase !== "question-open") return;

        const position = indexOfQuestion(questionId);
        const question = position === -1 ? undefined : config.questions[position];
        if (!question) return;

        /**
         * The payload, decided by kind. Both arms refuse to send an empty answer — the
         * choice path because a selection of nothing is not an answer, the text path
         * because whitespace is not one either, and both because a submission that
         * lands burns FR-004's one-answer-per-question lock.
         */
        let payload: AnswerPayload;
        if (question.kind === "text") {
          const value = answerText.value;
          if (value.trim().length === 0) return;
          // Sent raw: the server trims, bounds and folds. One implementation of each.
          payload = { kind: "text", text: value };
        } else if (question.kind === "number") {
          const value = answerNumber.value;
          // The same loose gate the button uses. A parse here would be the second
          // parser this design exists to avoid.
          if (!/\d/.test(value)) return;
          // Raw, commas and spaces included — `parseGuess` decides what it means.
          payload = { kind: "number", value };
        } else if (question.kind === "word-cloud") {
          const value = answerWord.value;
          // The same loose gate the button uses, and the same reason a stricter one is not
          // here: `validateWord` is server-side and is the only judge.
          if (!hasTypedWord()) return;
          // Raw — the server trims, bounds, checks the character set and folds.
          payload = { kind: "word", word: value };
        } else {
          const selected = selections.get(questionId) ?? [];
          if (selected.length === 0) return;
          payload = { kind: "choice", optionIds: selected };
        }

        answerSubmit.disabled = true;
        answerSubmit.textContent = "Wysyłanie…";
        answerError("");

        // The device's own clock, from the paint this device recorded — not from the
        // host's advance, and not reset by a reload.
        const elapsedMs = Date.now() - markSeen(config.seenStorageKey, questionId);

        const outcome = await submitAnswer(player.id, questionId, payload, elapsedMs);

        answerSubmit.textContent = "Wyślij odpowiedź";

        // A typed answer — free text, a raw guess, or a word — is kept so a reload can put
        // it back in the locked field.
        const sentText =
          payload.kind === "text"
            ? payload.text
            : payload.kind === "number"
              ? payload.value
              : payload.kind === "word"
                ? payload.word
                : undefined;

        /**
         * And the choice kinds' equivalent, kept for the same reason.
         *
         * **Without it a reload loses which option this device picked.** The selection lives
         * in a `Map` that a reload empties, so an attendee who answered and then reloaded
         * reached the reveal with the correct option marked and nothing saying which one had
         * been theirs — worst on a question they got right, where the mark they were looking
         * for is the one that says *you* got it.
         */
        const sentOptionIds = payload.kind === "choice" ? payload.optionIds : undefined;

        const submission = { text: sentText, optionIds: sentOptionIds };

        if (outcome.outcome === "accepted") {
          markSubmitted(config.seenStorageKey, questionId, submission);
          render();
          return;
        }

        /**
         * **Nothing was written, so nothing is locked.** A validation refusal is the
         * one 4xx the attendee can act on: show the server's message, re-arm the
         * button, leave the field exactly as they typed it.
         *
         * `render()` is deliberately not called — it would rebuild the question
         * container and fight the field the attendee is about to correct.
         */
        if (outcome.outcome === "invalid") {
          answerError(outcome.error);
          answerSubmit.disabled = false;
          return;
        }

        if (outcome.outcome === "rejected") {
          // The server's own Polish message — "already answered", "no longer open".
          // Treated as final: the answer is not going to be accepted by retrying.
          markSubmitted(config.seenStorageKey, questionId, submission);
          answerError(outcome.error);
          render();
          return;
        }

        /**
         * **Final, like `rejected`, but nothing is marked as submitted** (roadmap S-11).
         *
         * The window closed while this request was in flight — a phone whose clock ran a
         * little slow, or a slow network. There is nothing to retry into, so the control
         * goes; but the store recorded no answer, and `markSubmitted` here would paint a
         * result panel at the reveal for an answer that never existed and label it
         * "Odpowiedź zapisana".
         *
         * `render()` re-runs the state machine, which now finds the clock at zero and
         * lands on the timed-out screen — so this branch does not have to reproduce it.
         */
        if (outcome.outcome === "expired") {
          answerError(outcome.error);
          render();
          return;
        }

        // The network, not the session. Let them try again.
        answerError("Nie udało się wysłać. Spróbuj ponownie.");
        answerSubmit.disabled = false;
      }

      answerSubmit.addEventListener("click", () => void sendAnswer());

      function showJoinForm(): void {
        setHidden(boot, true);
        setHidden(followSection, true);
        setHidden(joinSection, false);
        nameInput.focus();
      }

      async function enterSession(
        joining: { id: string; displayName: string },
        state: Parameters<SessionClient["apply"]>[0],
        /**
         * What a resuming device is coming back with; `null` for a fresh join, which has
         * nothing to come back with (roadmap S-09, FR-009).
         *
         * `null` rather than `0` on purpose — the two are different claims. A returning
         * player who has genuinely scored nothing is told so, which is reassuring in its
         * own way; a fresh joiner told "you are returning with 0 pkt" would be confused
         * by a line about a session they just entered.
         */
        resumedTotal: number | null = null
      ): Promise<void> {
        joined = true;
        // Held for the rest of the segment: every submission and every result fetch is
        // made in this id's name, and it is the only thing this device knows about
        // itself that the server also knows.
        player = joining;
        writePlayer(config.storageKey, joining);

        setHidden(boot, true);
        setHidden(joinSection, true);
        setHidden(followSection, false);
        setText("player-name", `Grasz jako ${joining.displayName}`);
        // Retired by `paintTotal` the moment a fresher number arrives.
        if (resumedTotal !== null) {
          setText("resume-total", `Wracasz z wynikiem ${resumedTotal} pkt`);
        }

        // Applied before connecting: the join response already carries the host's
        // current state, so the first render costs no extra round trip inside the
        // thirty seconds FR-002 allows.
        client.apply(state ?? null, "http");
        render();

        await client.start();
      }

      /** A device coming back after a reload, recognised by the id it stored. */
      async function resume(playerId: string): Promise<void> {
        const body = new FormData();
        body.set("playerId", playerId);

        let response: Response;
        try {
          response = await fetch("/api/quiz/join", { method: "POST", body });
        } catch {
          // The network, not the session. Offer the form rather than stranding the
          // device on "Ładowanie…" forever.
          showJoinForm();
          return;
        }

        const payload = (await response.json().catch(() => ({}))) as JoinResponse;

        if (response.ok && payload.player) {
          // Read explicitly rather than `payload.total ?? 0`: a response that omits the
          // field is one from a server before this shipped, and it has not told us this
          // device scored nothing — it has told us nothing. `null` shows no line at all.
          const total = typeof payload.total === "number" ? payload.total : null;
          await enterSession(payload.player, payload.state ?? null, total);
          return;
        }

        // **The store could not answer, so keep the id.** Same reasoning as the network
        // branch above: nothing here says the id is dead, and clearing it on a blip
        // would send an attendee back to a form to re-claim the name they are still
        // holding — refused as taken, locked out for the rest of the segment. Only a
        // 404, which is the server saying it looked and found nothing, may clear.
        if (response.status >= 500) {
          joinError(payload.error ?? "Chwilowy problem. Odśwież stronę.");
          showJoinForm();
          return;
        }

        // The stored id genuinely no longer resolves — a purged or expired session.
        // Drop it so this device does not carry a ghost player into the next one, and
        // let the attendee join afresh.
        clearPlayer(config.storageKey);
        // The paint times belonged to the session this id came from. Kept, they would
        // be read back by the next one and hand this device the speed floor.
        clearSeen(config.seenStorageKey);
        showJoinForm();
      }

      /**
       * The submit path.
       *
       * **The control disables on first press and stays disabled until the response
       * resolves.** Two fast taps mint two player ids: the first claims the name, the
       * second comes back `taken` — so the attendee is told their own just-claimed name
       * is unavailable, and the device may discard the valid id the first request
       * returned. Double-tapping a button that has not visibly responded is the ordinary
       * thing to do on a phone against a thirty-second clock, so this is the expected
       * path, not an edge case.
       */
      let inFlight = false;

      async function claim(): Promise<void> {
        if (inFlight) return;
        inFlight = true;
        submit.disabled = true;
        submit.textContent = "Dołączanie…";
        joinError("");

        const body = new FormData();
        body.set("displayName", nameInput.value);
        // Only on this path. The resume request below deliberately sends nothing but
        // the player id — the cap must never be able to refuse a returning device.
        body.set("deviceId", deviceId(config.deviceStorageKey));

        try {
          const response = await fetch("/api/quiz/join", { method: "POST", body });
          const payload = (await response.json().catch(() => ({}))) as JoinResponse;

          if (response.ok && payload.player) {
            await enterSession(payload.player, payload.state ?? null);
            return;
          }

          /**
           * A `taken` refusal on a device that cannot remember anything (roadmap S-09).
           *
           * The bare message is accurate and useless in one case: the attendee's storage
           * is unavailable — a private tab, or storage disabled — so they were shown the
           * form despite already holding this name, re-typed it, and were refused by
           * their own claim. Nothing can recover it (there is no id left to present), but
           * the view can stop looking like a bug and name the way forward.
           *
           * **Gated on storage, not on player absence** (impl review F1). The first
           * version asked `readPlayer(...) === null`, which is equally true of every
           * first-time joiner — so the ordinary case of two people in 150 picking "Anna"
           * was told its earlier points could not be recovered. That is the most common
           * refusal in the room, and it is exactly the absent-value conflation
           * `store.ts` documents for not-found versus failed.
           *
           * Narrower on purpose: site data cleared mid-session leaves working storage and
           * no player, and no code can tell that from a first join. Those attendees get
           * the plain message, which is at least always true.
           */
          const strandedByStorage =
            payload.refusal === "taken" && !deviceStoragePersists(config.deviceStorageKey);

          joinError(
            strandedByStorage
              ? "Ta nazwa jest już zajęta. Jeśli to Twoja — to urządzenie jej nie pamięta " +
                  "(tryb prywatny lub wyczyszczone dane). Wybierz inną nazwę, żeby grać " +
                  "dalej; wcześniejszych punktów nie odzyskamy."
              : (payload.error ?? "Nie udało się dołączyć.")
          );
        } catch {
          joinError("Brak połączenia. Spróbuj ponownie.");
        } finally {
          inFlight = false;
          submit.disabled = false;
          submit.textContent = "Dołącz";
          // The value is deliberately left in the field and focus returned to it: a
          // retry loop sits inside the window the 30-second target covers, and that is
          // the one place a lost input costs the most.
          if (!joined) {
            nameInput.focus();
            nameInput.select();
          }
        }
      }

      form.addEventListener("submit", (event) => {
        event.preventDefault();
        void claim();
      });

      /**
       * The clock stops when nobody can see it, and when the page goes away.
       *
       * It spends no commands, so this is hygiene rather than budget — the same handlers the
       * host page carries, added here so the two views do not differ for no reason (impl
       * review F10). `render` re-arms from the wall clock on the way back, and because every
       * tick recomputes rather than decrementing, a tab that was hidden for a minute returns
       * showing the truth rather than a minute of catching up.
       *
       * `session.ts` registers its own lifecycle listeners for the connection fallback; these
       * are separate and neither knows about the other.
       */
      document.addEventListener("visibilitychange", () => {
        if (document.visibilityState === "hidden") stopCountdown();
        else render();
      });
      window.addEventListener("pagehide", () => {
        stopCountdown();
        // The celebration owns timers of its own — six seconds of bursts that must not be
        // left queued against a page that is going away. Same exit, same reasoning as the
        // clock; `celebrate.ts` says why a demo page gets to skip this and a phone does not.
        celebration.stop();
      });

      const stored = readPlayer(config.storageKey);
      if (stored) {
        void resume(stored.id);
      } else {
        // Nothing stored: straight to the form, with no round trip to wait through.
        showJoinForm();
      }
    </script>
  </body>
</html>
