---
import "../../styles/global.css";

import {
  DEVICE_STORAGE_KEY,
  PLAYER_STORAGE_KEY,
  QUESTION_SEEN_STORAGE_KEY,
} from "../../lib/session/keys";
import { SESSION_CHANNEL, SNAPSHOT_EVENT } from "../../lib/session/realtime";
import { MAX_GUESS_INPUT_LENGTH } from "../../lib/session/guess";
import { MAX_TEXT_ANSWER_LENGTH } from "../../lib/session/scoring";
import { MAX_WORD_LENGTH } from "../../lib/session/words";
import { publicQuiz } from "../../quiz/public";

/**
 * The attendee view (roadmap S-02, PRD FR-002/FR-007/FR-008).
 *
 * Claim a name, then follow the host. Read on a phone held at arm's length in a dark
 * room, so the type is large and the contrast is high; all copy is Polish.
 *
 * **On demand — no `prerender` export.** It renders per request because the join and
 * the current session state are both request-time facts. See CLAUDE.md's route table.
 *
 * **Reads no secret of any kind.** Everything below reaches the browser deliberately:
 * the channel and event names (which a subscribe-only token already grants access to),
 * the `localStorage` key, the answer-length bound on the text input, and the *public*
 * quiz projection — prompts and option text, never an answer. The bound is read in
 * frontmatter and written straight into the markup's `maxlength`, so the `<script>`
 * block never needs it — which matters because that block may not value-import from
 * `src/lib/session/`. The server-side refusal in `/api/quiz/answer` is the real bound;
 * `maxlength` is only there to stop a phone typing past it.
 * `src/lib/client/boundary.test.ts` scans the `<script>` blocks below
 * and fails the suite if one reads env or value-imports `src/quiz/` or
 * `src/lib/session/`; this frontmatter is excluded from that scan because it runs
 * server-side, which is exactly how these values are fetched.
 *
 * **No `BaseLayout`.** That layout carries the site navbar, footer and OG metadata for
 * a content site. This is a full-screen single-purpose view, so it keeps its own
 * document shell — `spine-check.astro`'s precedent — but styled with Tailwind utilities
 * rather than an inline `<style>` block.
 */
---

<html lang="pl" class="bg-surface-primary">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>LiveQuiz — dołącz</title>
  </head>
  <body
    class="min-h-dvh bg-surface-primary text-text-primary font-archivo antialiased
           flex flex-col items-center px-5 py-8"
  >
    <main class="w-full max-w-md flex flex-col gap-6">
      <h1 class="text-brand-purple-light text-sm font-bold uppercase tracking-[0.2em]">
        LiveQuiz
      </h1>

      <!-- Shown until the stored-player check resolves, so a returning device never
           flashes the name form it is about to skip. -->
      <section id="boot" class="text-text-secondary text-lg">Ładowanie…</section>

      <noscript>
        <p class="text-lg">
          Ten quiz wymaga włączonego JavaScriptu. Włącz go i odśwież stronę.
        </p>
      </noscript>

      <section id="join" hidden class="flex flex-col gap-5">
        <p class="text-2xl font-semibold leading-tight">
          Wpisz swoją nazwę, żeby dołączyć do quizu.
        </p>

        <form id="join-form" class="flex flex-col gap-4" novalidate>
          <label for="display-name" class="text-text-secondary text-base">
            Twoja nazwa
          </label>
          <input
            id="display-name"
            name="displayName"
            type="text"
            inputmode="text"
            autocomplete="off"
            autocapitalize="words"
            autocorrect="off"
            spellcheck="false"
            maxlength="24"
            class="w-full rounded-xl border border-surface-border bg-surface-secondary
                   px-4 py-4 text-2xl text-text-primary placeholder:text-text-secondary
                   focus:border-brand-purple-light focus:outline-none"
            placeholder="np. Ania"
          />
          <button
            id="join-submit"
            type="submit"
            class="w-full rounded-xl bg-brand-purple px-4 py-4 text-2xl font-semibold
                   text-white disabled:opacity-50"
          >
            Dołącz
          </button>
          <p id="join-error" role="alert" aria-live="polite" class="text-lg text-red-400"></p>
        </form>
      </section>

      <section id="follow" hidden class="flex flex-col gap-6">
        <p id="player-name" class="text-text-secondary text-base"></p>
        <p id="follow-status" class="text-xl font-semibold"></p>

        <!-- The backup-mode banner. Shown only while the channel is unavailable *and*
             polling is working, so it is never on screen at the same time as the red
             `follow-status` failure line — the two describe mutually exclusive states.

             Static markup, sibling of the status line rather than something
             `renderQuestion` emits, for the same reason the answer fields below are:
             `render()` runs on every applied snapshot and `replaceChildren()` would
             destroy anything living inside the question container. -->
        <p
          id="degraded-note"
          hidden
          role="status"
          aria-live="polite"
          class="rounded-xl border border-amber-400 bg-amber-500/15 px-4 py-3 text-lg
                 text-amber-200"
        >
          Grasz w trybie zapasowym — odświeżamy pytania co kilka sekund. Odpowiedzi
          działają normalnie, ale punkty za czas mogą być niższe.
        </p>

        <div id="question" class="flex flex-col gap-4"></div>

        <!-- The answering controls. Hidden for every phase and kind that cannot be
             answered, so nothing tappable is ever on screen without a purpose. -->

        <!-- The free-text field (S-05). A STATIC element shown and hidden, deliberately
             not something `renderQuestion` emits: that function calls
             `replaceChildren()` and `render()` runs on every snapshot, so an input
             inside the question container would be destroyed and rebuilt while the
             attendee is typing — losing the value, the focus and the caret. Another
             attendee joining is enough to trigger it. -->
        <input
          id="answer-text"
          type="text"
          hidden
          inputmode="text"
          autocomplete="off"
          autocapitalize="off"
          autocorrect="off"
          spellcheck="false"
          maxlength={MAX_TEXT_ANSWER_LENGTH}
          class="w-full rounded-xl border border-surface-border bg-surface-secondary
                 px-4 py-4 text-2xl text-text-primary placeholder:text-text-secondary
                 focus:border-brand-purple-light focus:outline-none
                 disabled:opacity-60"
          placeholder="Wpisz odpowiedź"
        />

        <!-- The numeric field (S-06). Static and sibling to the text one, for exactly
             the same reason: `render()` runs on every snapshot and would otherwise
             destroy it mid-keystroke.

             **`type="text"` with `inputmode="decimal"`, and that is the decision.**
             `type="number"` picks its accepted decimal separator from the browser
             locale, so the same typed characters parse differently on two phones in
             the same room; and it reports an empty string for any value it considers
             invalid, which is precisely the absent-versus-hostile confusion
             `lessons.md` rule 2 is about. `inputmode` gets the numeric keypad with
             neither problem. -->
        <input
          id="answer-number"
          type="text"
          hidden
          inputmode="decimal"
          autocomplete="off"
          autocapitalize="off"
          autocorrect="off"
          spellcheck="false"
          maxlength={MAX_GUESS_INPUT_LENGTH}
          class="w-full rounded-xl border border-surface-border bg-surface-secondary
                 px-4 py-4 text-2xl text-text-primary placeholder:text-text-secondary
                 focus:border-brand-purple-light focus:outline-none
                 disabled:opacity-60"
          placeholder="Wpisz liczbę"
        />

        <!-- The word field (S-08). A third static sibling of the two above, for the same
             reason and with the same consequence: `render()` runs on every snapshot and
             `replaceChildren()` inside the question container would destroy the input
             mid-keystroke, losing the value, the focus and the caret.

             `maxlength` is `MAX_WORD_LENGTH`, not the text field's 80 — a word goes on a
             projector, so it is bounded by what fits a projected line, the same number
             `MAX_DISPLAY_NAME_LENGTH` uses for the same reason. Read in frontmatter and
             written straight into the markup, because the `<script>` block below may not
             value-import from `src/lib/session/`.

             `autocapitalize="off"` deliberately: the fold lowercases anyway, so a phone
             capitalising the first letter would show the attendee something other than
             what the projector renders. -->
        <input
          id="answer-word"
          type="text"
          hidden
          inputmode="text"
          autocomplete="off"
          autocapitalize="off"
          autocorrect="off"
          spellcheck="false"
          maxlength={MAX_WORD_LENGTH}
          class="w-full rounded-xl border border-surface-border bg-surface-secondary
                 px-4 py-4 text-2xl text-text-primary placeholder:text-text-secondary
                 focus:border-brand-purple-light focus:outline-none
                 disabled:opacity-60"
          placeholder="Wpisz jedno słowo"
        />

        <button
          id="answer-submit"
          type="button"
          hidden
          class="w-full rounded-xl bg-brand-purple px-4 py-4 text-2xl font-semibold
                 text-white disabled:opacity-50"
        >
          Wyślij odpowiedź
        </button>
        <p id="answer-note" hidden class="text-text-secondary text-lg"></p>
        <p id="answer-error" role="alert" aria-live="polite" class="text-lg text-red-400"></p>

        <!-- The accepted answer for a free-text question, from the snapshot. Sits
             OUTSIDE the result panel on purpose: the panel is gated on having answered
             and on the per-device fetch, while this must reach a device that stayed
             silent and one whose fetch failed. -->
        <p
          id="answer-accepted"
          hidden
          class="rounded-xl border border-green-400 bg-green-500/20 px-4 py-3 text-2xl font-semibold"
        >
        </p>

        <!-- The reveal panel. The verdict line is per device and arrives from
             /api/quiz/result; the correct answer above it came with the snapshot and
             is on screen whether or not that fetch succeeds. -->
        <section id="result" hidden class="flex flex-col gap-1">
          <p id="result-verdict" class="text-2xl font-bold"></p>
          <p id="result-award" class="text-xl"></p>
          <p id="result-answer" class="text-text-secondary text-lg"></p>
          <p id="result-total" class="text-text-secondary text-lg"></p>
        </section>

        <!--
          The leaderboard beat (roadmap S-07, FR-014).

          The same five rows the projector shows, in the same order, because both render
          the list the server published and neither sorts. Own row highlighted.

          `standings-you` sits OUTSIDE the board for the reason `answer-accepted` sits
          outside the result panel: the board comes with the snapshot and is on screen
          whichever way the per-device fetch goes, while this line depends on that fetch
          and must be able to say nothing without taking the board down with it.
        -->
        <section id="standings" hidden class="flex flex-col gap-3">
          <p class="text-xl font-semibold">Ranking</p>
          <div id="standings-board"></div>
          <p id="standings-you" class="text-text-secondary text-lg"></p>
        </section>
      </section>
    </main>

    <!--
      `define:vars` forces an inline, unprocessed script, so it cannot import from npm.
      The handoff is therefore split in two exactly as `spine-check.astro` does it: this
      block parks the server-rendered values on `window`, and the module script below
      picks them up.
    -->
    <script
      define:vars={{
        channelName: SESSION_CHANNEL,
        snapshotEvent: SNAPSHOT_EVENT,
        storageKey: PLAYER_STORAGE_KEY,
        seenStorageKey: QUESTION_SEEN_STORAGE_KEY,
        deviceStorageKey: DEVICE_STORAGE_KEY,
        questions: publicQuiz.questions,
      }}
    >
      window.__liveQuiz = {
        channelName,
        snapshotEvent,
        storageKey,
        seenStorageKey,
        deviceStorageKey,
        questions,
      };
    </script>

    <script>
      import {
        createSessionClient,
        type ConnectionCause,
        type ConnectionStatus,
        type SessionClient,
      } from "../../lib/client/session";
      import { clearPlayer, readPlayer, writePlayer } from "../../lib/client/player";
      import { deviceId } from "../../lib/client/device";
      import {
        clearSeen,
        fetchResult,
        hasSubmitted,
        markSeen,
        markSubmitted,
        submitAnswer,
        submittedText,
        type AnswerPayload,
        type OwnResult,
      } from "../../lib/client/answer";
      import {
        el,
        renderQuestion,
        renderStandings,
        setHidden,
        setText,
        standingsPositionText,
        wordEchoText,
      } from "../../lib/client/render";
      import type { PublicQuestion } from "../../quiz/public";

      type Config = {
        channelName: string;
        snapshotEvent: string;
        storageKey: string;
        seenStorageKey: string;
        deviceStorageKey: string;
        questions: PublicQuestion[];
      };

      type JoinResponse = {
        player?: { id: string; displayName: string };
        state?: Parameters<SessionClient["apply"]>[0];
        error?: string;
      };

      const config = (window as unknown as { __liveQuiz: Config }).__liveQuiz;

      const boot = el("boot");
      const joinSection = el("join");
      const followSection = el("follow");
      const questionBox = el("question");
      const nameInput = el("display-name") as HTMLInputElement;
      const submit = el("join-submit") as HTMLButtonElement;
      const form = el("join-form") as HTMLFormElement;
      const answerSubmit = el("answer-submit") as HTMLButtonElement;
      const answerText = el("answer-text") as HTMLInputElement;
      const answerNumber = el("answer-number") as HTMLInputElement;
      const answerWord = el("answer-word") as HTMLInputElement;
      const answerNote = el("answer-note");
      const answerError = el("answer-error");
      const standingsBox = el("standings");
      const standingsBoard = el("standings-board");
      const answerAccepted = el("answer-accepted");
      const degradedNote = el("degraded-note");
      const resultPanel = el("result");

      let connection: ConnectionStatus = "connecting";
      /**
       * Why the connection is unhealthy, held beside the status because the `lost` branch
       * picks its wording from it. Deliberately not folded into `connection`: the status
       * decides what is on screen, the cause decides only what it says.
       */
      let connectionCause: ConnectionCause = null;
      let joined = false;
      let player: { id: string; displayName: string } | null = null;

      /**
       * Everything the answering beats need, keyed by question id.
       *
       * Per question rather than a single "current" value, because the snapshot is what
       * decides which question is current and it can move under us. Keyed state means
       * an out-of-order or replayed snapshot renders the right thing rather than
       * mixing one question's selection into another — the property `render()` already
       * had and that these additions must not cost.
       */
      const selections = new Map<string, string[]>();
      /**
       * What this device has typed, per question — the text equivalent of `selections`,
       * and keyed for the same reason: the snapshot decides which question is current
       * and it can move underneath us.
       */
      const typed = new Map<string, string>();
      const results = new Map<string, OwnResult>();
      /** Questions whose result fetch has already been issued — one per device, ever. */
      const resultRequested = new Set<string>();

      /**
       * This device's own position, and which beat it belongs to (roadmap S-07).
       *
       * Keyed by the snapshot **version** rather than by question id, unlike `results`
       * above. A host may show the standings more than once between the same pair of
       * questions, and each beat is a fresh board — a question-keyed cache would paint the
       * first beat's position under the second one's board, which is plausible and wrong.
       * Every accepted transition bumps the version, so it identifies a beat exactly.
       *
       * `rank === null` with `rankVersion` set is the failed-fetch state, and it must stay
       * distinguishable from "not asked yet": it is the difference between a neutral line
       * and one more request.
       */
      let rank: number | null = null;
      let rankVersion: number | null = null;
      /**
       * Whether a rank request for `rankVersion` is still open.
       *
       * **A third state, because two collapse into a lie** (impl review F2). `rank === null`
       * is the *failure* state, and it is also what this device holds while the request is
       * in flight — so any re-render at the same version painted "we couldn't get your
       * position" over a request that was still running. Re-rendering at the same version is
       * routine: a connection transition calls `render()`, and a venue Wi-Fi flap during the
       * beat is exactly when it happens.
       */
      let rankPending = false;

      const OPTION_CLASS =
        "rounded-xl border border-surface-border bg-surface-secondary px-4 py-3 text-xl";

      const client = createSessionClient({
        channelName: config.channelName,
        snapshotEvent: config.snapshotEvent,
        /**
         * The whole point of this change: a device Ably refused — most plausibly one that
         * did not fit under the free tier's 200-connection ceiling — keeps playing over
         * HTTP instead of sitting out the segment behind a red banner.
         */
        fallbackPolling: true,
        onSnapshot: () => render(),
        onConnection: (status, info) => {
          connection = status;
          connectionCause = info.cause;
          render();
        },
      });

      function indexOfQuestion(id: string): number {
        return config.questions.findIndex((question) => question.id === id);
      }

      /**
       * The whole attendee-facing state machine, in one function driven by the snapshot
       * and the connection status. Rendering from state rather than from events is what
       * makes an out-of-order or duplicated snapshot harmless.
       */
      function render(): void {
        if (!joined) return;

        const state = client.current();

        // Lost connection wins over everything: whatever is on screen is no longer
        // known to be current, and saying so is the difference between a quiet room and
        // a broken phone. The three states `ended` exists to separate are exactly these.
        if (connection === "lost") {
          /**
           * **Two causes, two sentences, and the difference is a promise we can keep.**
           * "Próbujemy połączyć ponownie" is true of a network wobble, which the SDK
           * retries on its own. It is not true of an exhausted account limit: there may be
           * no retry, and the wait is on someone else's action, not this phone's.
           *
           * The limit itself is deliberately unnamed. An attendee can do nothing with
           * "the account's connection ceiling is full", and a message that reads as "there
           * is no room for you" invites them to put the phone away. The diagnosis belongs
           * on the host's screen, where someone can act on it.
           */
          setText(
            "follow-status",
            connectionCause === "account-limit"
              ? "Nie możemy Cię teraz podłączyć na żywo. Spróbuj odświeżyć stronę za chwilę."
              : "Utracono połączenie. Próbujemy połączyć ponownie…"
          );
          el("follow-status").className = "text-xl font-semibold text-red-400";
          setHidden(degradedNote, true);
          hideAnswerControls();
          return;
        }

        /**
         * **`degraded` falls through to the ordinary rendering path, and that is the
         * entire fix.** The snapshot arrives on a timer instead of instantly, but it is
         * the same snapshot, and everything the controls below do — submitting, locking,
         * fetching a result — is HTTP and unaffected by the channel being gone.
         *
         * The banner is suppressed once the session is over: `ended` already says
         * everything, and "we refresh every few seconds" beside "that's it, thanks" is
         * noise about a transport nobody is waiting on any more.
         */
        setHidden(
          degradedNote,
          !(connection === "degraded" && state !== null && state.phase !== "ended")
        );

        el("follow-status").className = "text-xl font-semibold";

        /**
         * Hidden here, once, rather than in each of the branches below (roadmap S-07).
         *
         * Every other branch returns early, so a hide placed inside them would be five
         * copies of one rule and the next branch added would inherit none of them — the
         * board would then survive into a question and sit under it. The standings branch
         * unhides it as its first act.
         */
        setHidden(standingsBox, state === null || state.phase !== "standings");

        // `null` here is what a purge looks like from a phone. Render it as the end of
        // the session, never as the name form — the session really is over, and sending
        // someone back to a form they cannot complete is the worse of the two wrongs.
        if (state === null || state.phase === "ended") {
          setText("follow-status", "To już koniec. Dzięki za grę!");
          setHidden(questionBox, true);
          hideAnswerControls();
          // Question ids are stable across sessions, so paint times left behind here
          // would be read back by the next one and score this device at the floor.
          // This is the one moment every still-watching device agrees it is over.
          clearSeen(config.seenStorageKey);
          /**
           * The in-memory half of the same cleanup, for the same reason.
           *
           * `clearSeen` only reaches storage. A host who purges and restarts mid-event
           * while this device stays on the page would otherwise re-open a question with
           * the previous answer still in the field and the previous result still in the
           * panel — question ids being stable is exactly what makes them line up again.
           * A reload happens to clear all four, which is why this went unnoticed.
           */
          typed.clear();
          selections.clear();
          results.clear();
          resultRequested.clear();
          /**
           * The same cleanup for the same reason, and it is not hypothetical (roadmap
           * S-07). A host who purges and restarts mid-event gets a session whose versions
           * begin again at 1, so a stale `rankVersion` from the previous room can match a
           * beat in the new one — and this device would then show a position it earned in
           * a session that no longer exists, without issuing a fetch that would correct it.
           */
          rank = null;
          rankVersion = null;
          rankPending = false;
          // The field itself is a live DOM element and holds its own value; without
          // this the reconciliation guard sees an unchanged question id and never
          // rewrites it.
          answerText.value = "";
          delete answerText.dataset.questionId;
          answerNumber.value = "";
          delete answerNumber.dataset.questionId;
          answerWord.value = "";
          delete answerWord.dataset.questionId;
          return;
        }

        if (state.phase === "lobby") {
          setText("follow-status", "Jesteś w grze. Czekamy na prowadzącego…");
          setHidden(questionBox, true);
          hideAnswerControls();
          return;
        }

        if (state.phase === "standings") {
          renderStandingsBeat(state);
          return;
        }

        const id = state.currentQuestionId;
        const position = id === null ? -1 : indexOfQuestion(id);
        const label =
          position === -1
            ? "Pytanie"
            : `Pytanie ${position + 1} z ${config.questions.length}`;

        setText(
          "follow-status",
          state.phase === "question-revealed" ? `${label} — odpowiedź ujawniona` : label
        );

        setHidden(questionBox, false);

        // An id absent from the projection means the definition changed under a live
        // session. `renderQuestion` shows a neutral placeholder rather than an error.
        const question = position === -1 ? undefined : config.questions[position];

        if (state.phase === "question-revealed") {
          renderRevealed(
            question,
            state.revealedOptionIds ?? null,
            state.revealedAnswerText ?? null
          );
          return;
        }

        renderOpen(question);
      }

      /**
       * The leaderboard beat, on the attendee's own phone (roadmap S-07, FR-014).
       *
       * Two halves that fail independently, and keeping them independent is the point:
       *
       * - **The board comes with the snapshot** and is painted unconditionally, in the
       *   order received. Same list, same order, same five names as the projector, because
       *   neither sorts. A device that never joined, or whose own fetch fails, still sees
       *   the standings the room is looking at.
       * - **The position is per device** and arrives from `/api/quiz/result`. A failure
       *   costs this one line and nothing else — the same split S-03 established for the
       *   accepted answer and the score, and for the same reason.
       */
      function renderStandingsBeat(state: NonNullable<ReturnType<SessionClient["current"]>>): void {
        setText("follow-status", "Ranking");
        setHidden(questionBox, true);
        hideAnswerControls();
        setHidden(resultPanel, true);
        setHidden(answerAccepted, true);

        const board = state.standings;

        renderStandings(standingsBoard, board?.rows, {
          // Its own row, matched on the name this device stored — which is the one the
          // server returned, so exact equality is enough and no fold is needed. See
          // `renderStandings`.
          ownDisplayName: player?.displayName ?? null,
          list: "flex flex-col gap-2",
          row: "grid grid-cols-[auto_1fr_auto] items-baseline gap-4 rounded-xl border border-surface-border bg-surface-secondary px-4 py-3 text-xl",
          rowOwn: "border-brand-purple-light bg-brand-purple/20 font-semibold",
          rank: "tabular-nums text-text-secondary",
          name: "truncate",
          points: "tabular-nums font-semibold",
          empty: "text-text-secondary text-lg",
        });

        // A device with no claim is a spectator: it can watch the board, and there is no
        // position to tell it about.
        if (!player) {
          setText("standings-you", "");
          return;
        }

        // A fresh beat. Keyed by version rather than by question, because the host may
        // show the standings twice between the same pair of questions and each is a new
        // board — see the note on `rankVersion`.
        if (rankVersion !== state.version) {
          rankVersion = state.version;
          rank = null;
          rankPending = true;
          renderOwnPosition(state.playerCount);

          const beat = state.version;

          void fetchResult(player.id, state.currentQuestionId ?? "").then((own) => {
            /**
             * **Guarded against the LIVE state, not against `rankVersion`** (impl review F6).
             *
             * The first version compared `rankVersion` — a module value this function is the
             * only writer of — against the version captured in this closure, and claimed to
             * discard a reply that landed after the room moved on. It could not: those two
             * are equal unless a *newer standings beat* arrived, so a reply landing during
             * the next question passed the guard and painted a position. It was invisible
             * only because `#standings-you` is hidden by then, two functions away — a
             * safety property provided by something other than the line claiming it.
             *
             * Reading `client.current()` asks the question the comment always meant to ask.
             * The phase check also closes the purge hole: versions restart at 1, so a reply
             * captured at version 7 could otherwise land inside a new session's version-7
             * beat.
             */
            const live = client.current();
            if (live === null || live.phase !== "standings" || live.version !== beat) return;
            rankPending = false;
            rank = own?.rank ?? null;
            // From the live snapshot rather than the captured one — same field either way
            // (F3), and this is the fresher of the two.
            renderOwnPosition(live.playerCount);
          });
          return;
        }

        renderOwnPosition(state.playerCount);
      }

      /**
       * The attendee's own line under the board.
       *
       * The copy itself lives in `standingsPositionText`, where it is unit-tested — the
       * absent-rank branch is one `lessons.md` has an entry about, and a page has no
       * harness to reach it from.
       *
       * **The denominator is the snapshot's `playerCount`, not the board's** (impl review
       * F3). The board carries its own count, taken in the same read as the rows, and using
       * it looks like the more consistent choice — that was the first implementation and it
       * was wrong. The host screen renders the *snapshot's* count, which `applyHostAction`
       * refreshes with a fresh `HLEN` after the board is built, so the two numbers genuinely
       * differ when a join lands between the reads. Phones reading "z 149" beside a projector
       * reading "150" is the divergence the PRD guardrail is about; a denominator one beat
       * fresher than the rows it describes is invisible.
       */
      function renderOwnPosition(playerCount: number | null): void {
        setText("standings-you", standingsPositionText(rank, playerCount, rankPending));
      }

      /** Every answering control off, in one call, so no branch can leave one behind. */
      function hideAnswerControls(): void {
        setHidden(answerSubmit, true);
        setHidden(answerText, true);
        setHidden(answerNumber, true);
        setHidden(answerWord, true);
        setHidden(answerNote, true);
        setHidden(answerAccepted, true);
        setHidden(resultPanel, true);
        setText("answer-error", "");
      }

      /**
       * `question-open` — the answering beat.
       *
       * The paint time is recorded first and read back if this device has seen the
       * question before, which is what makes a reload keep its original clock rather
       * than restarting it at full speed weight.
       */
      function renderOpen(question: PublicQuestion | undefined): void {
        setHidden(resultPanel, true);
        setHidden(answerAccepted, true);

        /**
         * **Every kind is answerable now (roadmap S-08 took the last one).** The branch is
         * kept rather than collapsed to `question !== undefined`, because the thing it
         * actually guards is a question id absent from the projection — a definition changed
         * under a live session — and a sixth kind added later must land in the static
         * placeholder rather than in whichever branch happens to fall through.
         */
        const answerable =
          question !== undefined &&
          (question.kind === "single-choice" ||
            question.kind === "multiple-choice" ||
            question.kind === "text" ||
            question.kind === "number" ||
            question.kind === "word-cloud");

        if (!question || !answerable) {
          // Static text, and no control — something tappable that does nothing reads as a
          // broken quiz.
          renderQuestion(questionBox, question, {
            prompt: "text-3xl font-bold leading-tight",
            list: "flex flex-col gap-3",
            option: OPTION_CLASS,
          });
          hideAnswerControls();
          return;
        }

        if (question.kind === "text") {
          renderOpenText(question);
          return;
        }

        if (question.kind === "number") {
          renderOpenNumber(question);
          return;
        }

        if (question.kind === "word-cloud") {
          renderOpenWord(question);
          return;
        }

        // A choice question has no field. Hidden explicitly because this branch does not
        // call `hideAnswerControls`.
        setHidden(answerText, true);
        setHidden(answerNumber, true);
        setHidden(answerWord, true);

        markSeen(config.seenStorageKey, question.id);

        const selected = selections.get(question.id) ?? [];
        // Read from storage, not from memory: a reload mid-question must not re-offer
        // the controls for an answer the store has already accepted.
        const locked = hasSubmitted(config.seenStorageKey, question.id);

        renderQuestion(questionBox, question, {
          prompt: "text-3xl font-bold leading-tight",
          list: "flex flex-col gap-3",
          option: OPTION_CLASS,
          optionSelected: "border-brand-purple-light bg-brand-purple/30 font-semibold",
          mode: locked ? "static" : "answerable",
          selectedOptionIds: selected,
          onSelect: (next) => {
            selections.set(question.id, next);
            render();
          },
        });

        setHidden(answerNote, false);
        if (locked) {
          // Confirmed, and nothing about correctness — that waits for the host.
          answerNote.textContent = "Odpowiedź zapisana. Czekamy na prowadzącego…";
          setHidden(answerSubmit, true);
          return;
        }

        // FR-017: say up front that a warm-up is a warm-up. Driven by `scored` from the
        // projection, never inferred from a zero award — the payloads are identical.
        answerNote.textContent = question.scored
          ? question.kind === "multiple-choice"
            ? "Możesz wybrać kilka odpowiedzi. Liczy się też czas."
            : "Liczy się też czas — im szybciej, tym więcej punktów."
          : "To pytanie na rozgrzewkę — bez punktów.";

        setHidden(answerSubmit, false);
        answerSubmit.disabled = selected.length === 0;
      }

      /**
       * `question-open` for a free-text question (roadmap S-05, FR-011).
       *
       * Same beats as the choice path — paint clock, lock, note, disabled-until-valid
       * submit — with a field instead of buttons.
       */
      function renderOpenText(question: PublicQuestion): void {
        // Prompt only. A text question has no options, so `renderQuestion` draws the
        // prompt and returns; the field lives outside this container on purpose.
        renderQuestion(questionBox, question, {
          prompt: "text-3xl font-bold leading-tight",
        });

        markSeen(config.seenStorageKey, question.id);

        const locked = hasSubmitted(config.seenStorageKey, question.id);

        /**
         * **The reconciliation rule, and both of the obvious readings are wrong.**
         *
         * The input is a live DOM element holding its own value; the Map is the
         * per-question record. Written from the Map on every `render()`, it would
         * clobber whatever the attendee is mid-way through typing — and `render()` fires
         * on every snapshot, so another attendee joining is enough to trigger it.
         * Written never, advancing between two text questions would leave the previous
         * answer sitting in the field.
         *
         * So: write it only when the question being rendered is not the one the element
         * currently holds, tracked by `data-question-id` on the element itself.
         */
        if (answerText.dataset.questionId !== question.id) {
          answerText.dataset.questionId = question.id;
          // Storage first, memory second. The Map does not survive a reload, and the
          // server will not serve this device its own answer back until the reveal — so
          // without the stored copy a reloaded, locked field would sit empty under
          // "Odpowiedź zapisana", which is the one moment it needs to show something.
          answerText.value =
            submittedText(config.seenStorageKey, question.id) ?? typed.get(question.id) ?? "";
        }

        setHidden(answerText, false);
        setHidden(answerNumber, true);
        // Disabled rather than hidden once locked: the attendee should still see what
        // they sent.
        answerText.disabled = locked;

        setHidden(answerNote, false);
        if (locked) {
          answerNote.textContent = "Odpowiedź zapisana. Czekamy na prowadzącego…";
          setHidden(answerSubmit, true);
          return;
        }

        // FR-017, same rule as the choice path: driven by `scored`, never inferred from
        // a zero award.
        answerNote.textContent = question.scored
          ? "Wpisz odpowiedź. Liczy się też czas — im szybciej, tym więcej punktów."
          : "To pytanie na rozgrzewkę — bez punktów.";

        setHidden(answerSubmit, false);
        answerSubmit.disabled = !hasTypedAnswer();
      }

      /**
       * `question-open` for a number question (roadmap S-06, FR-013).
       *
       * The text path with one field swapped and one rule changed — the submit gate is
       * "contains a digit" rather than "contains anything". Kept as its own function
       * rather than parameterising `renderOpenText`, because the two differ in the note
       * copy, the enable rule and the element, which is most of the body.
       */
      function renderOpenNumber(question: PublicQuestion): void {
        // Prompt only; the field lives outside the container that `render()` rebuilds.
        renderQuestion(questionBox, question, {
          prompt: "text-3xl font-bold leading-tight",
        });

        markSeen(config.seenStorageKey, question.id);

        const locked = hasSubmitted(config.seenStorageKey, question.id);

        // The same reconciliation rule as the text field, and for the same reason —
        // see `renderOpenText`. Written only when the element is holding a different
        // question, so a snapshot mid-keystroke cannot clobber what is being typed.
        if (answerNumber.dataset.questionId !== question.id) {
          answerNumber.dataset.questionId = question.id;
          answerNumber.value =
            submittedText(config.seenStorageKey, question.id) ?? typed.get(question.id) ?? "";
        }

        setHidden(answerNumber, false);
        setHidden(answerText, true);
        // Disabled rather than hidden once locked, so the attendee still sees the
        // number they sent.
        answerNumber.disabled = locked;

        setHidden(answerNote, false);
        if (locked) {
          answerNote.textContent = "Odpowiedź zapisana. Czekamy na prowadzącego…";
          setHidden(answerSubmit, true);
          return;
        }

        /**
         * FR-017 as everywhere else, driven by `scored`. The scored line says closeness
         * counts **without naming a threshold**: the bands are deliberately not exposed
         * to the attendee, because a number on screen is something to argue with at the
         * busiest moment of the beat.
         */
        answerNote.textContent = question.scored
          ? "Nie musisz trafić idealnie — im bliżej, tym więcej punktów. Liczy się też czas."
          : "To pytanie na rozgrzewkę — bez punktów.";

        setHidden(answerSubmit, false);
        answerSubmit.disabled = !hasTypedGuess();
      }

      /**
       * `question-open` for a word-cloud question (roadmap S-08, FR-012).
       *
       * The same five beats as the text and number paths — paint clock, reconciliation,
       * lock, note, disabled-until-valid submit — and its own function for the same reason
       * `renderOpenNumber` is: the copy, the enable rule and the element are what differ,
       * which is most of the body.
       *
       * **The copy is the one real difference and it is deliberate.** Every other unscored
       * beat says "bez punktów", which frames the question as something the attendee missed
       * out on. This is the question the PRD kept knowing it was the most expensive view in
       * the set, because watching your own word land on the big screen is what proves the
       * session is live — so the note points at the screen instead of apologising for the
       * absence of points.
       */
      function renderOpenWord(question: PublicQuestion): void {
        // Prompt only; the field is a static sibling outside the container `render()`
        // rebuilds.
        renderQuestion(questionBox, question, {
          prompt: "text-3xl font-bold leading-tight",
        });

        markSeen(config.seenStorageKey, question.id);

        const locked = hasSubmitted(config.seenStorageKey, question.id);

        // The same reconciliation rule as the other two fields, and for the same reason —
        // see `renderOpenText`. Written only when the element holds a different question, so
        // a snapshot arriving mid-keystroke cannot clobber what is being typed.
        if (answerWord.dataset.questionId !== question.id) {
          answerWord.dataset.questionId = question.id;
          answerWord.value =
            submittedText(config.seenStorageKey, question.id) ?? typed.get(question.id) ?? "";
        }

        setHidden(answerWord, false);
        setHidden(answerText, true);
        setHidden(answerNumber, true);
        // Disabled rather than hidden once locked, so the attendee still sees the word they
        // sent — and can compare it with the chip on the projector.
        answerWord.disabled = locked;

        setHidden(answerNote, false);
        if (locked) {
          answerNote.textContent = "Słowo wysłane! Zobacz duży ekran.";
          setHidden(answerSubmit, true);
          return;
        }

        // No `scored` branch, unlike every other kind: the build gate refuses a scored
        // word-cloud question, so there is no second case to write copy for.
        answerNote.textContent = "Napisz jedno słowo — pojawi się na dużym ekranie.";

        setHidden(answerSubmit, false);
        answerSubmit.disabled = !hasTypedWord();
      }

      /** Whether the field holds anything but whitespace. The server is the real judge. */
      function hasTypedAnswer(): boolean {
        return answerText.value.trim().length > 0;
      }

      /**
       * Whether the word field holds something that could be one word.
       *
       * **A loose test, deliberately not a copy of `validateWord`.** That function is
       * server-side and lives under `src/lib/session/`, which `boundary.test.ts` refuses to
       * let this script value-import — and two validators that disagree would refuse an
       * answer the server would have accepted, or enable a button for one it will not. All
       * this decides is whether the button is tappable: an over-permissive gate costs a
       * refusal the attendee can read, an over-strict one silently blocks a legitimate word.
       *
       * It checks the two rules an attendee can *see* they broke — nothing typed, or a space
       * in the middle. The length bound is enforced by the input's `maxlength` and by the
       * server; the character allowlist is the server's alone, because a disallowed
       * character is not something a greyed-out button explains.
       */
      function hasTypedWord(): boolean {
        const value = answerWord.value.trim();
        return value.length > 0 && !/\s/.test(value);
      }

      /**
       * Whether the numeric field holds anything that could be a number.
       *
       * **A loose test, deliberately not a parse.** `src/lib/session/guess.ts` is the
       * only parser and it is server-side; a client-side one would either duplicate it
       * or cross the boundary `boundary.test.ts` enforces, and two parsers that
       * disagree is a scoring dispute on stage. All this decides is whether the submit
       * button is tappable — an over-permissive gate costs a refusal the attendee can
       * read, while an over-strict one silently blocks a legitimate answer.
       */
      function hasTypedGuess(): boolean {
        return /\d/.test(answerNumber.value);
      }

      /**
       * Typing updates the Map and the submit button directly — **never through
       * `render()`**, which would rebuild the question container and fight the field.
       */
      answerText.addEventListener("input", () => {
        const questionId = answerText.dataset.questionId;
        if (questionId) typed.set(questionId, answerText.value);

        answerSubmit.disabled = answerText.disabled || !hasTypedAnswer();
      });

      /** The same, for the numeric field. Same reason it bypasses `render()`. */
      answerNumber.addEventListener("input", () => {
        const questionId = answerNumber.dataset.questionId;
        if (questionId) typed.set(questionId, answerNumber.value);

        answerSubmit.disabled = answerNumber.disabled || !hasTypedGuess();
      });

      /** And for the word field. Same reason again: `render()` would fight the input. */
      answerWord.addEventListener("input", () => {
        const questionId = answerWord.dataset.questionId;
        if (questionId) typed.set(questionId, answerWord.value);

        answerSubmit.disabled = answerWord.disabled || !hasTypedWord();
      });

      /**
       * `question-revealed` — the payoff beat.
       *
       * The correct answer comes from the snapshot, so it is on screen before any
       * request is made. **If the per-device fetch fails, that is what stays on
       * screen** — the split between broadcast correctness and per-device scoring
       * exists precisely so a failed fetch costs the score line and nothing more.
       */
      function renderRevealed(
        question: PublicQuestion | undefined,
        revealedOptionIds: readonly string[] | null,
        revealedAnswerText: string | null
      ): void {
        setHidden(answerSubmit, true);
        setHidden(answerText, true);
        setHidden(answerNumber, true);
        setHidden(answerWord, true);
        setHidden(answerNote, true);
        setText("answer-error", "");

        renderQuestion(questionBox, question, {
          prompt: "text-3xl font-bold leading-tight",
          list: "flex flex-col gap-3",
          option: OPTION_CLASS,
          optionSelected: "border-brand-purple-light font-semibold",
          optionCorrect: "border-green-400 bg-green-500/20 font-semibold",
          optionWrong: "border-red-400 bg-red-500/20",
          mode: "revealed",
          selectedOptionIds: selections.get(question?.id ?? "") ?? [],
          correctOptionIds: revealedOptionIds,
        });

        /**
         * **The accepted answer, and it is rendered before and independently of the
         * fetch.** That is the whole reason it rides the snapshot: a device that stayed
         * silent, and one whose per-device fetch fails, must still learn the answer. A
         * failed fetch costs the score line and the echo, never this.
         */
        const hasAccepted = revealedAnswerText !== null && revealedAnswerText.length > 0;
        setHidden(answerAccepted, !hasAccepted);
        if (hasAccepted) {
          answerAccepted.textContent = `Poprawna odpowiedź: ${revealedAnswerText}`;
        }

        if (!question) {
          setHidden(resultPanel, true);
          return;
        }

        // A device that stayed silent sees the correct answer and no verdict. Read
        // from storage so a reload between answering and the reveal does not turn an
        // attendee who answered into one who apparently did not.
        if (!hasSubmitted(config.seenStorageKey, question.id)) {
          setHidden(resultPanel, true);
          return;
        }

        /**
         * The word cloud's own reveal (roadmap S-08, FR-012).
         *
         * **Branched on KIND before `scored`, and the order is the point** — the ordering
         * S-06 established for the number kind, here for a different conflation. Both
         * unscored kinds fall through the same `scored` gate below, but the copy there says
         * "To była rozgrzewka — bez punktów", which frames the question as something the
         * attendee missed out on. This is the question the PRD kept *because* it is the
         * moment that proves the session is live, so it gets its own line pointing at the
         * cloud the room is looking at.
         *
         * **No result fetch**, exactly as the unscored branch below: there is no award to
         * ask for, and this keeps the fan-in gate intact — 2 of the 14 questions removed
         * from 150 devices per reveal.
         *
         * The word comes from storage rather than from the server, unlike the free-text
         * echo: `/api/quiz/result` would serve it, but spending a request to be told
         * something this device already wrote down is the fetch the gate exists to avoid.
         * A device that cleared storage sees the line without the word, which is honest.
         */
        if (question.kind === "word-cloud") {
          setHidden(resultPanel, false);
          setText("result-verdict", "Dzięki za słowo!");
          /**
           * **Says the screen shows it in lower case, rather than pretending it matches** (impl
           * review F10). The echo below is the word as *typed*; the projector renders the fold,
           * so someone who typed `KAWA` sees `kawa` up there. The two genuinely differ and the
           * honest fix is to say so — this device cannot compute the fold, because `foldWord`
           * lives under `src/lib/session/` and `boundary.test.ts` refuses a value import from
           * there. A second, client-side fold would be the "two implementations that can
           * disagree" shape this project rejects for the guess parser, for a cosmetic line.
           */
          setText("result-award", "Na dużym ekranie zobaczysz je małymi literami.");
          // Through `wordEchoText`, which owns the absent-word branch — see that function.
          setText("result-answer", wordEchoText(submittedText(config.seenStorageKey, question.id)));
          setText("result-total", "");
          return;
        }

        // An unscored question has no award to fetch, so asking would spend a request
        // to be told nothing — and this is 2 of the 14 questions removed from a fan-in
        // of 150 devices per reveal. The warm-up gets its own line instead.
        if (!question.scored) {
          setHidden(resultPanel, false);
          setText("result-verdict", "Dzięki za odpowiedź!");
          setText("result-award", "To była rozgrzewka — bez punktów.");
          setText("result-answer", "");
          setText("result-total", "");
          return;
        }

        const known = results.get(question.id);
        if (known) {
          showResult(known, question);
          return;
        }

        // Not yet fetched. Issue it once — `render()` runs on every snapshot and every
        // tap, and an ungated fetch here would issue one per render.
        setHidden(resultPanel, true);
        if (!resultRequested.has(question.id) && player) {
          resultRequested.add(question.id);
          void fetchResult(player.id, question.id).then((own) => {
            // A failure leaves the correct answer on screen and says nothing else. It
            // is deliberately not retried and deliberately not an error message: the
            // attendee has the answer, and a red line about a score they cannot see is
            // worse than a missing one.
            if (own) {
              results.set(question.id, own);
              render();
            }
          });
        }
      }

      function showResult(own: OwnResult, question: PublicQuestion): void {
        setHidden(resultPanel, false);

        /**
         * **`answered: false` is not a wrong answer**, and the two must not share a
         * line. The server reports it for a device that stayed silent *and* for one
         * whose submission was refused — a phone that tapped as the host advanced
         * reaches here believing it answered. Telling it "Tym razem nie." would score
         * it for a question it never got to answer, which is exactly what the plan
         * says must not happen.
         *
         * The running total still travels: it is true regardless, and it is the one
         * thing that keeps the panel worth showing.
         */
        if (!own.answered) {
          setText("result-verdict", "Bez odpowiedzi");
          setText("result-award", "Tym razem nie zdążyliśmy zapisać Twojej odpowiedzi.");
          setText("result-answer", "");
          setText("result-total", `Twój wynik: ${own.total} pkt`);
          return;
        }

        /**
         * **Selected by question KIND before it is selected by `correct`** (roadmap
         * S-06), and the order is the whole point.
         *
         * For a number question `correct` is exact-hit-only, so a guess that earned 800
         * of 1000 points comes back `correct: false`. A kind-blind branch renders "Tym
         * razem nie." beside a positive award — the conflation the exact-hit definition
         * was chosen to avoid. Partial credit is the first of its kind in the system;
         * every other kind is still binary and reads correctly through the branch below.
         */
        if (question.kind === "number") {
          showNumberResult(own);
          return;
        }

        setText("result-verdict", own.correct ? "Dobrze!" : "Tym razem nie.");
        setText("result-award", own.correct ? `+${own.awarded ?? 0} pkt` : "+0 pkt");
        /**
         * The echo, for a free-text answer only — `null` on every other kind.
         *
         * From the server, not from the `typed` Map: that map does not survive a reload,
         * and an attendee who answered and then reloaded should still see their own
         * words. Omitted rather than rendered empty when there is nothing to echo, so a
         * choice question's panel is unchanged.
         */
        setText("result-answer", own.text ? `Twoja odpowiedź: ${own.text}` : "");
        setText("result-total", `Twój wynik: ${own.total} pkt`);
      }

      /**
       * The reveal copy for a guess (roadmap S-06, FR-013).
       *
       * Three readings, not two: an exact hit, a guess that scored something, and one
       * that scored nothing. The middle one is the reason this function exists — it is
       * `correct: false` with a positive award, and the ordinary copy would call it
       * wrong.
       *
       * **The relative error and the band are deliberately not on screen.** The panel
       * shows the answer, the guess and the award; an arithmetic breakdown invites a
       * dispute at the busiest moment of the beat, and the thresholds are not something
       * an attendee was ever told.
       *
       * The correct value itself is not repeated here — it is already on screen above,
       * from the snapshot, where it reaches a device whose fetch failed too.
       */
      function showNumberResult(own: OwnResult): void {
        const awarded = own.awarded ?? 0;

        setText(
          "result-verdict",
          own.correct ? "Dokładnie!" : awarded > 0 ? "Blisko!" : "Tym razem daleko."
        );
        setText("result-award", `+${awarded} pkt`);
        /**
         * The guess from the server, not from the field — a reload empties the field
         * and the attendee should still see what they sent. `null` only if the record
         * predates this shipping, in which case there is nothing honest to show.
         *
         * **Rendered, not re-formatted.** `toLocaleString` was wrong here twice: it
         * runs per device, one line below a value `reveal.ts` formats on the *server*
         * precisely so 150 phones and the projector cannot disagree; and its default
         * `maximumFractionDigits` is 3, so a guess of `9800,5678` came back as
         * `9800,568` — a number the attendee did not type, shown at the exact moment a
         * scoring dispute would start.
         */
        setText("result-answer", own.value === null ? "" : `Twoja odpowiedź: ${own.value}`);
        setText("result-total", `Twój wynik: ${own.total} pkt`);
      }

      /**
       * The answer submit path.
       *
       * The in-flight guard lives in `answer.ts`; this one owns what the attendee sees
       * while it is in flight, exactly as the join button does.
       */
      async function sendAnswer(): Promise<void> {
        const state = client.current();
        const questionId = state?.currentQuestionId;
        if (!player || !questionId || state?.phase !== "question-open") return;

        const position = indexOfQuestion(questionId);
        const question = position === -1 ? undefined : config.questions[position];
        if (!question) return;

        /**
         * The payload, decided by kind. Both arms refuse to send an empty answer — the
         * choice path because a selection of nothing is not an answer, the text path
         * because whitespace is not one either, and both because a submission that
         * lands burns FR-004's one-answer-per-question lock.
         */
        let payload: AnswerPayload;
        if (question.kind === "text") {
          const value = answerText.value;
          if (value.trim().length === 0) return;
          // Sent raw: the server trims, bounds and folds. One implementation of each.
          payload = { kind: "text", text: value };
        } else if (question.kind === "number") {
          const value = answerNumber.value;
          // The same loose gate the button uses. A parse here would be the second
          // parser this design exists to avoid.
          if (!/\d/.test(value)) return;
          // Raw, commas and spaces included — `parseGuess` decides what it means.
          payload = { kind: "number", value };
        } else if (question.kind === "word-cloud") {
          const value = answerWord.value;
          // The same loose gate the button uses, and the same reason a stricter one is not
          // here: `validateWord` is server-side and is the only judge.
          if (!hasTypedWord()) return;
          // Raw — the server trims, bounds, checks the character set and folds.
          payload = { kind: "word", word: value };
        } else {
          const selected = selections.get(questionId) ?? [];
          if (selected.length === 0) return;
          payload = { kind: "choice", optionIds: selected };
        }

        answerSubmit.disabled = true;
        answerSubmit.textContent = "Wysyłanie…";
        setText("answer-error", "");

        // The device's own clock, from the paint this device recorded — not from the
        // host's advance, and not reset by a reload.
        const elapsedMs = Date.now() - markSeen(config.seenStorageKey, questionId);

        const outcome = await submitAnswer(player.id, questionId, payload, elapsedMs);

        answerSubmit.textContent = "Wyślij odpowiedź";

        // A typed answer — free text, a raw guess, or a word — is kept so a reload can put
        // it back in the locked field. A choice answer passes nothing and the stored entry
        // stays exactly as it was before.
        const sentText =
          payload.kind === "text"
            ? payload.text
            : payload.kind === "number"
              ? payload.value
              : payload.kind === "word"
                ? payload.word
                : undefined;

        if (outcome.outcome === "accepted") {
          markSubmitted(config.seenStorageKey, questionId, { text: sentText });
          render();
          return;
        }

        /**
         * **Nothing was written, so nothing is locked.** A validation refusal is the
         * one 4xx the attendee can act on: show the server's message, re-arm the
         * button, leave the field exactly as they typed it.
         *
         * `render()` is deliberately not called — it would rebuild the question
         * container and fight the field the attendee is about to correct.
         */
        if (outcome.outcome === "invalid") {
          setText("answer-error", outcome.error);
          answerSubmit.disabled = false;
          return;
        }

        if (outcome.outcome === "rejected") {
          // The server's own Polish message — "already answered", "no longer open".
          // Treated as final: the answer is not going to be accepted by retrying.
          markSubmitted(config.seenStorageKey, questionId, { text: sentText });
          setText("answer-error", outcome.error);
          render();
          return;
        }

        // The network, not the session. Let them try again.
        setText("answer-error", "Nie udało się wysłać. Spróbuj ponownie.");
        answerSubmit.disabled = false;
      }

      answerSubmit.addEventListener("click", () => void sendAnswer());

      function showJoinForm(): void {
        setHidden(boot, true);
        setHidden(followSection, true);
        setHidden(joinSection, false);
        nameInput.focus();
      }

      async function enterSession(
        joining: { id: string; displayName: string },
        state: Parameters<SessionClient["apply"]>[0]
      ): Promise<void> {
        joined = true;
        // Held for the rest of the segment: every submission and every result fetch is
        // made in this id's name, and it is the only thing this device knows about
        // itself that the server also knows.
        player = joining;
        writePlayer(config.storageKey, joining);

        setHidden(boot, true);
        setHidden(joinSection, true);
        setHidden(followSection, false);
        setText("player-name", `Grasz jako ${joining.displayName}`);

        // Applied before connecting: the join response already carries the host's
        // current state, so the first render costs no extra round trip inside the
        // thirty seconds FR-002 allows.
        client.apply(state ?? null, "http");
        render();

        await client.start();
      }

      /** A device coming back after a reload, recognised by the id it stored. */
      async function resume(playerId: string): Promise<void> {
        const body = new FormData();
        body.set("playerId", playerId);

        let response: Response;
        try {
          response = await fetch("/api/quiz/join", { method: "POST", body });
        } catch {
          // The network, not the session. Offer the form rather than stranding the
          // device on "Ładowanie…" forever.
          showJoinForm();
          return;
        }

        const payload = (await response.json().catch(() => ({}))) as JoinResponse;

        if (response.ok && payload.player) {
          await enterSession(payload.player, payload.state ?? null);
          return;
        }

        // **The store could not answer, so keep the id.** Same reasoning as the network
        // branch above: nothing here says the id is dead, and clearing it on a blip
        // would send an attendee back to a form to re-claim the name they are still
        // holding — refused as taken, locked out for the rest of the segment. Only a
        // 404, which is the server saying it looked and found nothing, may clear.
        if (response.status >= 500) {
          setText("join-error", payload.error ?? "Chwilowy problem. Odśwież stronę.");
          showJoinForm();
          return;
        }

        // The stored id genuinely no longer resolves — a purged or expired session.
        // Drop it so this device does not carry a ghost player into the next one, and
        // let the attendee join afresh.
        clearPlayer(config.storageKey);
        // The paint times belonged to the session this id came from. Kept, they would
        // be read back by the next one and hand this device the speed floor.
        clearSeen(config.seenStorageKey);
        showJoinForm();
      }

      /**
       * The submit path.
       *
       * **The control disables on first press and stays disabled until the response
       * resolves.** Two fast taps mint two player ids: the first claims the name, the
       * second comes back `taken` — so the attendee is told their own just-claimed name
       * is unavailable, and the device may discard the valid id the first request
       * returned. Double-tapping a button that has not visibly responded is the ordinary
       * thing to do on a phone against a thirty-second clock, so this is the expected
       * path, not an edge case.
       */
      let inFlight = false;

      async function claim(): Promise<void> {
        if (inFlight) return;
        inFlight = true;
        submit.disabled = true;
        submit.textContent = "Dołączanie…";
        setText("join-error", "");

        const body = new FormData();
        body.set("displayName", nameInput.value);
        // Only on this path. The resume request below deliberately sends nothing but
        // the player id — the cap must never be able to refuse a returning device.
        body.set("deviceId", deviceId(config.deviceStorageKey));

        try {
          const response = await fetch("/api/quiz/join", { method: "POST", body });
          const payload = (await response.json().catch(() => ({}))) as JoinResponse;

          if (response.ok && payload.player) {
            await enterSession(payload.player, payload.state ?? null);
            return;
          }

          setText("join-error", payload.error ?? "Nie udało się dołączyć.");
        } catch {
          setText("join-error", "Brak połączenia. Spróbuj ponownie.");
        } finally {
          inFlight = false;
          submit.disabled = false;
          submit.textContent = "Dołącz";
          // The value is deliberately left in the field and focus returned to it: a
          // retry loop sits inside the window the 30-second target covers, and that is
          // the one place a lost input costs the most.
          if (!joined) {
            nameInput.focus();
            nameInput.select();
          }
        }
      }

      form.addEventListener("submit", (event) => {
        event.preventDefault();
        void claim();
      });

      const stored = readPlayer(config.storageKey);
      if (stored) {
        void resume(stored.id);
      } else {
        // Nothing stored: straight to the form, with no round trip to wait through.
        showJoinForm();
      }
    </script>
  </body>
</html>
