---
import "../../styles/global.css";

import { readSession } from "../../lib/session/store";
import { getQuizById } from "../../quiz/index";

/**
 * `/quiz` — the address that keeps working (multiple-quizzes).
 *
 * The attendee view moved to `/quiz/<slug>`, and this page replaces the address it
 * vacated. That address is on QR codes already printed, in the runbook, and in the
 * browser history of everyone who has played before, so it may not 404 — and it is also
 * the honest answer to "just go to /quiz", which is what a host says out loud when a
 * phone cannot scan.
 *
 * **It redirects to whatever is running**, read from the session document rather than
 * guessed from the registry. With no session it renders the copy below instead of a 404:
 * arriving before the host presses start is normal, not an error, and this is the one
 * page in LiveQuiz an attendee is likely to reach *early*.
 *
 * **On demand — no `prerender` export.** The running quiz is a request-time fact.
 *
 * One store read, in frontmatter, on a page a phone opens once. It is not on any polled
 * path, so it adds nothing to the per-session command budget the two polled routes
 * document.
 */
const session = await readSession();

/**
 * The quiz to send the phone to, or `undefined` for "nothing to send it to".
 *
 * Three states collapse into that `undefined`, deliberately: no session at all, a store
 * that could not answer, and a session whose `quizId` does not resolve — which is what a
 * document written before quizzes had identity looks like (`PRE_IDENTITY_QUIZ_ID`). A
 * phone can act on none of them differently, and the honest thing to show is the same
 * "not started yet" screen with a reload. The host's own panel is where a store outage
 * is diagnosable; this page has no business guessing.
 */
const running =
  session.outcome === "ok" && session.state !== null
    ? getQuizById(session.state.quizId)
    : undefined;

if (running !== undefined) {
  return Astro.redirect(`/quiz/${running.id}`);
}
---

<html lang="pl" class="bg-quiz-ink">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>LiveQuiz — dołącz</title>
  </head>
  <body
    class="flex min-h-dvh flex-col bg-quiz-ink px-7 pb-8 pt-6 font-archivo
           text-quiz-signwhite antialiased"
  >
    <main class="mx-auto flex w-full max-w-md flex-1 flex-col gap-6">
      <h1
        class="text-[20px] font-semibold uppercase tracking-[0.14em] text-quiz-zinc"
      >
        LiveQuiz
      </h1>

      <!--
        The status line sits in the growing column so it lands in the thumb zone, the
        same arrangement the attendee view's waiting screens use.
      -->
      <div class="flex flex-1 flex-col justify-center gap-4">
        <p class="text-[32px] font-bold leading-tight">
          Quiz jeszcze nie wystartował.
        </p>
        <p class="text-[24px] leading-relaxed text-quiz-zinc">
          Poczekaj na prowadzącego i odśwież tę stronę — albo zeskanuj kod QR z
          ekranu.
        </p>
      </div>
    </main>
  </body>
</html>
