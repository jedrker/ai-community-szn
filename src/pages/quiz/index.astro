---
import "../../styles/global.css";

import { PLAYER_STORAGE_KEY, QUESTION_SEEN_STORAGE_KEY } from "../../lib/session/keys";
import { SESSION_CHANNEL, SNAPSHOT_EVENT } from "../../lib/session/realtime";
import { publicQuiz } from "../../quiz/public";

/**
 * The attendee view (roadmap S-02, PRD FR-002/FR-007/FR-008).
 *
 * Claim a name, then follow the host. Read on a phone held at arm's length in a dark
 * room, so the type is large and the contrast is high; all copy is Polish.
 *
 * **On demand — no `prerender` export.** It renders per request because the join and
 * the current session state are both request-time facts. See CLAUDE.md's route table.
 *
 * **Reads no secret of any kind.** Everything below reaches the browser deliberately:
 * the channel and event names (which a subscribe-only token already grants access to),
 * the `localStorage` key, and the *public* quiz projection — prompts and option text,
 * never an answer. `src/lib/client/boundary.test.ts` scans the `<script>` blocks below
 * and fails the suite if one reads env or value-imports `src/quiz/` or
 * `src/lib/session/`; this frontmatter is excluded from that scan because it runs
 * server-side, which is exactly how these values are fetched.
 *
 * **No `BaseLayout`.** That layout carries the site navbar, footer and OG metadata for
 * a content site. This is a full-screen single-purpose view, so it keeps its own
 * document shell — `spine-check.astro`'s precedent — but styled with Tailwind utilities
 * rather than an inline `<style>` block.
 */
---

<html lang="pl" class="bg-surface-primary">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>LiveQuiz — dołącz</title>
  </head>
  <body
    class="min-h-dvh bg-surface-primary text-text-primary font-archivo antialiased
           flex flex-col items-center px-5 py-8"
  >
    <main class="w-full max-w-md flex flex-col gap-6">
      <h1 class="text-brand-purple-light text-sm font-bold uppercase tracking-[0.2em]">
        LiveQuiz
      </h1>

      <!-- Shown until the stored-player check resolves, so a returning device never
           flashes the name form it is about to skip. -->
      <section id="boot" class="text-text-secondary text-lg">Ładowanie…</section>

      <noscript>
        <p class="text-lg">
          Ten quiz wymaga włączonego JavaScriptu. Włącz go i odśwież stronę.
        </p>
      </noscript>

      <section id="join" hidden class="flex flex-col gap-5">
        <p class="text-2xl font-semibold leading-tight">
          Wpisz swoją nazwę, żeby dołączyć do quizu.
        </p>

        <form id="join-form" class="flex flex-col gap-4" novalidate>
          <label for="display-name" class="text-text-secondary text-base">
            Twoja nazwa
          </label>
          <input
            id="display-name"
            name="displayName"
            type="text"
            inputmode="text"
            autocomplete="off"
            autocapitalize="words"
            autocorrect="off"
            spellcheck="false"
            maxlength="24"
            class="w-full rounded-xl border border-surface-border bg-surface-secondary
                   px-4 py-4 text-2xl text-text-primary placeholder:text-text-secondary
                   focus:border-brand-purple-light focus:outline-none"
            placeholder="np. Ania"
          />
          <button
            id="join-submit"
            type="submit"
            class="w-full rounded-xl bg-brand-purple px-4 py-4 text-2xl font-semibold
                   text-white disabled:opacity-50"
          >
            Dołącz
          </button>
          <p id="join-error" role="alert" aria-live="polite" class="text-lg text-red-400"></p>
        </form>
      </section>

      <section id="follow" hidden class="flex flex-col gap-6">
        <p id="player-name" class="text-text-secondary text-base"></p>
        <p id="follow-status" class="text-xl font-semibold"></p>
        <div id="question" class="flex flex-col gap-4"></div>

        <!-- The answering controls. Hidden for every phase and kind that cannot be
             answered, so nothing tappable is ever on screen without a purpose. -->
        <button
          id="answer-submit"
          type="button"
          hidden
          class="w-full rounded-xl bg-brand-purple px-4 py-4 text-2xl font-semibold
                 text-white disabled:opacity-50"
        >
          Wyślij odpowiedź
        </button>
        <p id="answer-note" hidden class="text-text-secondary text-lg"></p>
        <p id="answer-error" role="alert" aria-live="polite" class="text-lg text-red-400"></p>

        <!-- The reveal panel. The verdict line is per device and arrives from
             /api/quiz/result; the correct answer above it came with the snapshot and
             is on screen whether or not that fetch succeeds. -->
        <section id="result" hidden class="flex flex-col gap-1">
          <p id="result-verdict" class="text-2xl font-bold"></p>
          <p id="result-award" class="text-xl"></p>
          <p id="result-total" class="text-text-secondary text-lg"></p>
        </section>
      </section>
    </main>

    <!--
      `define:vars` forces an inline, unprocessed script, so it cannot import from npm.
      The handoff is therefore split in two exactly as `spine-check.astro` does it: this
      block parks the server-rendered values on `window`, and the module script below
      picks them up.
    -->
    <script
      define:vars={{
        channelName: SESSION_CHANNEL,
        snapshotEvent: SNAPSHOT_EVENT,
        storageKey: PLAYER_STORAGE_KEY,
        seenStorageKey: QUESTION_SEEN_STORAGE_KEY,
        questions: publicQuiz.questions,
      }}
    >
      window.__liveQuiz = { channelName, snapshotEvent, storageKey, seenStorageKey, questions };
    </script>

    <script>
      import {
        createSessionClient,
        type ConnectionStatus,
        type SessionClient,
      } from "../../lib/client/session";
      import { clearPlayer, readPlayer, writePlayer } from "../../lib/client/player";
      import {
        fetchResult,
        markSeen,
        submitAnswer,
        type OwnResult,
      } from "../../lib/client/answer";
      import { el, renderQuestion, setHidden, setText } from "../../lib/client/render";
      import type { PublicQuestion } from "../../quiz/public";

      type Config = {
        channelName: string;
        snapshotEvent: string;
        storageKey: string;
        seenStorageKey: string;
        questions: PublicQuestion[];
      };

      type JoinResponse = {
        player?: { id: string; displayName: string };
        state?: Parameters<SessionClient["apply"]>[0];
        error?: string;
      };

      const config = (window as unknown as { __liveQuiz: Config }).__liveQuiz;

      const boot = el("boot");
      const joinSection = el("join");
      const followSection = el("follow");
      const questionBox = el("question");
      const nameInput = el("display-name") as HTMLInputElement;
      const submit = el("join-submit") as HTMLButtonElement;
      const form = el("join-form") as HTMLFormElement;
      const answerSubmit = el("answer-submit") as HTMLButtonElement;
      const answerNote = el("answer-note");
      const answerError = el("answer-error");
      const resultPanel = el("result");

      let connection: ConnectionStatus = "connecting";
      let joined = false;
      let player: { id: string; displayName: string } | null = null;

      /**
       * Everything the answering beats need, keyed by question id.
       *
       * Per question rather than a single "current" value, because the snapshot is what
       * decides which question is current and it can move under us. Keyed state means
       * an out-of-order or replayed snapshot renders the right thing rather than
       * mixing one question's selection into another — the property `render()` already
       * had and that these additions must not cost.
       */
      const selections = new Map<string, string[]>();
      const submitted = new Set<string>();
      const results = new Map<string, OwnResult>();
      /** Questions whose result fetch has already been issued — one per device, ever. */
      const resultRequested = new Set<string>();

      const OPTION_CLASS =
        "rounded-xl border border-surface-border bg-surface-secondary px-4 py-3 text-xl";

      const client = createSessionClient({
        channelName: config.channelName,
        snapshotEvent: config.snapshotEvent,
        onSnapshot: () => render(),
        onConnection: (status) => {
          connection = status;
          render();
        },
      });

      function indexOfQuestion(id: string): number {
        return config.questions.findIndex((question) => question.id === id);
      }

      /**
       * The whole attendee-facing state machine, in one function driven by the snapshot
       * and the connection status. Rendering from state rather than from events is what
       * makes an out-of-order or duplicated snapshot harmless.
       */
      function render(): void {
        if (!joined) return;

        const state = client.current();

        // Lost connection wins over everything: whatever is on screen is no longer
        // known to be current, and saying so is the difference between a quiet room and
        // a broken phone. The three states `ended` exists to separate are exactly these.
        if (connection === "lost") {
          setText("follow-status", "Utracono połączenie. Próbujemy połączyć ponownie…");
          el("follow-status").className = "text-xl font-semibold text-red-400";
          hideAnswerControls();
          return;
        }

        el("follow-status").className = "text-xl font-semibold";

        // `null` here is what a purge looks like from a phone. Render it as the end of
        // the session, never as the name form — the session really is over, and sending
        // someone back to a form they cannot complete is the worse of the two wrongs.
        if (state === null || state.phase === "ended") {
          setText("follow-status", "To już koniec. Dzięki za grę!");
          setHidden(questionBox, true);
          hideAnswerControls();
          return;
        }

        if (state.phase === "lobby") {
          setText("follow-status", "Jesteś w grze. Czekamy na prowadzącego…");
          setHidden(questionBox, true);
          hideAnswerControls();
          return;
        }

        const id = state.currentQuestionId;
        const position = id === null ? -1 : indexOfQuestion(id);
        const label =
          position === -1
            ? "Pytanie"
            : `Pytanie ${position + 1} z ${config.questions.length}`;

        setText(
          "follow-status",
          state.phase === "question-revealed" ? `${label} — odpowiedź ujawniona` : label
        );

        setHidden(questionBox, false);

        // An id absent from the projection means the definition changed under a live
        // session. `renderQuestion` shows a neutral placeholder rather than an error.
        const question = position === -1 ? undefined : config.questions[position];

        if (state.phase === "question-revealed") {
          renderRevealed(question, state.revealedOptionIds ?? null);
          return;
        }

        renderOpen(question);
      }

      /** Every answering control off, in one call, so no branch can leave one behind. */
      function hideAnswerControls(): void {
        setHidden(answerSubmit, true);
        setHidden(answerNote, true);
        setHidden(resultPanel, true);
        setText("answer-error", "");
      }

      /**
       * `question-open` — the answering beat.
       *
       * The paint time is recorded first and read back if this device has seen the
       * question before, which is what makes a reload keep its original clock rather
       * than restarting it at full speed weight.
       */
      function renderOpen(question: PublicQuestion | undefined): void {
        setHidden(resultPanel, true);

        const answerable =
          question !== undefined &&
          (question.kind === "single-choice" || question.kind === "multiple-choice");

        if (!question || !answerable) {
          // Text, number and word cloud are S-05, S-06 and S-08. Static text, and no
          // control — something tappable that does nothing reads as a broken quiz.
          renderQuestion(questionBox, question, {
            prompt: "text-3xl font-bold leading-tight",
            list: "flex flex-col gap-3",
            option: OPTION_CLASS,
          });
          hideAnswerControls();
          return;
        }

        markSeen(config.seenStorageKey, question.id);

        const selected = selections.get(question.id) ?? [];
        const locked = submitted.has(question.id);

        renderQuestion(questionBox, question, {
          prompt: "text-3xl font-bold leading-tight",
          list: "flex flex-col gap-3",
          option: OPTION_CLASS,
          optionSelected: "border-brand-purple-light bg-brand-purple/30 font-semibold",
          mode: locked ? "static" : "answerable",
          selectedOptionIds: selected,
          onSelect: (next) => {
            selections.set(question.id, next);
            render();
          },
        });

        setHidden(answerNote, false);
        if (locked) {
          // Confirmed, and nothing about correctness — that waits for the host.
          answerNote.textContent = "Odpowiedź zapisana. Czekamy na prowadzącego…";
          setHidden(answerSubmit, true);
          return;
        }

        // FR-017: say up front that a warm-up is a warm-up. Driven by `scored` from the
        // projection, never inferred from a zero award — the payloads are identical.
        answerNote.textContent = question.scored
          ? question.kind === "multiple-choice"
            ? "Możesz wybrać kilka odpowiedzi. Liczy się też czas."
            : "Liczy się też czas — im szybciej, tym więcej punktów."
          : "To pytanie na rozgrzewkę — bez punktów.";

        setHidden(answerSubmit, false);
        answerSubmit.disabled = selected.length === 0;
      }

      /**
       * `question-revealed` — the payoff beat.
       *
       * The correct answer comes from the snapshot, so it is on screen before any
       * request is made. **If the per-device fetch fails, that is what stays on
       * screen** — the split between broadcast correctness and per-device scoring
       * exists precisely so a failed fetch costs the score line and nothing more.
       */
      function renderRevealed(
        question: PublicQuestion | undefined,
        revealedOptionIds: readonly string[] | null
      ): void {
        setHidden(answerSubmit, true);
        setHidden(answerNote, true);
        setText("answer-error", "");

        renderQuestion(questionBox, question, {
          prompt: "text-3xl font-bold leading-tight",
          list: "flex flex-col gap-3",
          option: OPTION_CLASS,
          optionSelected: "border-brand-purple-light font-semibold",
          optionCorrect: "border-green-400 bg-green-500/20 font-semibold",
          optionWrong: "border-red-400 bg-red-500/20",
          mode: "revealed",
          selectedOptionIds: selections.get(question?.id ?? "") ?? [],
          correctOptionIds: revealedOptionIds,
        });

        if (!question) {
          setHidden(resultPanel, true);
          return;
        }

        // A device that stayed silent sees the correct answer and no verdict.
        if (!submitted.has(question.id)) {
          setHidden(resultPanel, true);
          return;
        }

        // An unscored question has no award to fetch, so asking would spend a request
        // to be told nothing — and this is 2 of the 14 questions removed from a fan-in
        // of 150 devices per reveal. The warm-up gets its own line instead.
        if (!question.scored) {
          setHidden(resultPanel, false);
          setText("result-verdict", "Dzięki za odpowiedź!");
          setText("result-award", "To była rozgrzewka — bez punktów.");
          setText("result-total", "");
          return;
        }

        const known = results.get(question.id);
        if (known) {
          showResult(known);
          return;
        }

        // Not yet fetched. Issue it once — `render()` runs on every snapshot and every
        // tap, and an ungated fetch here would issue one per render.
        setHidden(resultPanel, true);
        if (!resultRequested.has(question.id) && player) {
          resultRequested.add(question.id);
          void fetchResult(player.id, question.id).then((own) => {
            // A failure leaves the correct answer on screen and says nothing else. It
            // is deliberately not retried and deliberately not an error message: the
            // attendee has the answer, and a red line about a score they cannot see is
            // worse than a missing one.
            if (own) {
              results.set(question.id, own);
              render();
            }
          });
        }
      }

      function showResult(own: OwnResult): void {
        setHidden(resultPanel, false);
        setText("result-verdict", own.correct ? "Dobrze!" : "Tym razem nie.");
        setText("result-award", own.correct ? `+${own.awarded ?? 0} pkt` : "+0 pkt");
        setText("result-total", `Twój wynik: ${own.total} pkt`);
      }

      /**
       * The answer submit path.
       *
       * The in-flight guard lives in `answer.ts`; this one owns what the attendee sees
       * while it is in flight, exactly as the join button does.
       */
      async function sendAnswer(): Promise<void> {
        const state = client.current();
        const questionId = state?.currentQuestionId;
        if (!player || !questionId || state?.phase !== "question-open") return;

        const selected = selections.get(questionId) ?? [];
        if (selected.length === 0) return;

        answerSubmit.disabled = true;
        answerSubmit.textContent = "Wysyłanie…";
        setText("answer-error", "");

        // The device's own clock, from the paint this device recorded — not from the
        // host's advance, and not reset by a reload.
        const elapsedMs = Date.now() - markSeen(config.seenStorageKey, questionId);

        const outcome = await submitAnswer(player.id, questionId, selected, elapsedMs);

        answerSubmit.textContent = "Wyślij odpowiedź";

        if (outcome.outcome === "accepted") {
          submitted.add(questionId);
          render();
          return;
        }

        if (outcome.outcome === "rejected") {
          // The server's own Polish message — "already answered", "no longer open".
          // Treated as final: the answer is not going to be accepted by retrying.
          submitted.add(questionId);
          setText("answer-error", outcome.error);
          render();
          return;
        }

        // The network, not the session. Let them try again.
        setText("answer-error", "Nie udało się wysłać. Spróbuj ponownie.");
        answerSubmit.disabled = false;
      }

      answerSubmit.addEventListener("click", () => void sendAnswer());

      function showJoinForm(): void {
        setHidden(boot, true);
        setHidden(followSection, true);
        setHidden(joinSection, false);
        nameInput.focus();
      }

      async function enterSession(
        joining: { id: string; displayName: string },
        state: Parameters<SessionClient["apply"]>[0]
      ): Promise<void> {
        joined = true;
        // Held for the rest of the segment: every submission and every result fetch is
        // made in this id's name, and it is the only thing this device knows about
        // itself that the server also knows.
        player = joining;
        writePlayer(config.storageKey, joining);

        setHidden(boot, true);
        setHidden(joinSection, true);
        setHidden(followSection, false);
        setText("player-name", `Grasz jako ${joining.displayName}`);

        // Applied before connecting: the join response already carries the host's
        // current state, so the first render costs no extra round trip inside the
        // thirty seconds FR-002 allows.
        client.apply(state ?? null, "http");
        render();

        await client.start();
      }

      /** A device coming back after a reload, recognised by the id it stored. */
      async function resume(playerId: string): Promise<void> {
        const body = new FormData();
        body.set("playerId", playerId);

        let response: Response;
        try {
          response = await fetch("/api/quiz/join", { method: "POST", body });
        } catch {
          // The network, not the session. Offer the form rather than stranding the
          // device on "Ładowanie…" forever.
          showJoinForm();
          return;
        }

        const payload = (await response.json().catch(() => ({}))) as JoinResponse;

        if (response.ok && payload.player) {
          await enterSession(payload.player, payload.state ?? null);
          return;
        }

        // **The store could not answer, so keep the id.** Same reasoning as the network
        // branch above: nothing here says the id is dead, and clearing it on a blip
        // would send an attendee back to a form to re-claim the name they are still
        // holding — refused as taken, locked out for the rest of the segment. Only a
        // 404, which is the server saying it looked and found nothing, may clear.
        if (response.status >= 500) {
          setText("join-error", payload.error ?? "Chwilowy problem. Odśwież stronę.");
          showJoinForm();
          return;
        }

        // The stored id genuinely no longer resolves — a purged or expired session.
        // Drop it so this device does not carry a ghost player into the next one, and
        // let the attendee join afresh.
        clearPlayer(config.storageKey);
        showJoinForm();
      }

      /**
       * The submit path.
       *
       * **The control disables on first press and stays disabled until the response
       * resolves.** Two fast taps mint two player ids: the first claims the name, the
       * second comes back `taken` — so the attendee is told their own just-claimed name
       * is unavailable, and the device may discard the valid id the first request
       * returned. Double-tapping a button that has not visibly responded is the ordinary
       * thing to do on a phone against a thirty-second clock, so this is the expected
       * path, not an edge case.
       */
      let inFlight = false;

      async function claim(): Promise<void> {
        if (inFlight) return;
        inFlight = true;
        submit.disabled = true;
        submit.textContent = "Dołączanie…";
        setText("join-error", "");

        const body = new FormData();
        body.set("displayName", nameInput.value);

        try {
          const response = await fetch("/api/quiz/join", { method: "POST", body });
          const payload = (await response.json().catch(() => ({}))) as JoinResponse;

          if (response.ok && payload.player) {
            await enterSession(payload.player, payload.state ?? null);
            return;
          }

          setText("join-error", payload.error ?? "Nie udało się dołączyć.");
        } catch {
          setText("join-error", "Brak połączenia. Spróbuj ponownie.");
        } finally {
          inFlight = false;
          submit.disabled = false;
          submit.textContent = "Dołącz";
          // The value is deliberately left in the field and focus returned to it: a
          // retry loop sits inside the window the 30-second target covers, and that is
          // the one place a lost input costs the most.
          if (!joined) {
            nameInput.focus();
            nameInput.select();
          }
        }
      }

      form.addEventListener("submit", (event) => {
        event.preventDefault();
        void claim();
      });

      const stored = readPlayer(config.storageKey);
      if (stored) {
        void resume(stored.id);
      } else {
        // Nothing stored: straight to the form, with no round trip to wait through.
        showJoinForm();
      }
    </script>
  </body>
</html>
