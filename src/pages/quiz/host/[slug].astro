---
import "../../../styles/global.css";

import QRCode from "qrcode";

import { HOST_SECRET_HEADER } from "../../../lib/session/host";
import { SESSION_CHANNEL, SNAPSHOT_EVENT } from "../../../lib/session/realtime";
import { getQuizById } from "../../../quiz/index";
import { getPublicQuizById, publicQuizzes } from "../../../quiz/public";
import { getThemeForQuiz, themeRootCss } from "../../../lib/theme";

/**
 * The host view (roadmap S-02).
 *
 * Drives the segment from the stage and shows the room what it needs to see. Read from
 * the back of a venue room, so the phase, the prompt and the join count are set at a
 * scale well past the site's ordinary body type. All copy is Polish.
 *
 * **On demand — no `prerender` export.**
 *
 * ## The secret is typed, never shipped
 *
 * This page reads no secret in its frontmatter and embeds none in its HTML. The host
 * types it into a field once, it is held in `sessionStorage` for the tab's lifetime,
 * and every action sends it as the `x-livequiz-host-secret` header to the existing
 * `/api/quiz/host/*` routes. So the page stays as unprotected as the PRD wants — there
 * is nothing on it worth guarding — while the write path stays guarded by the routes
 * that already do it. A missing or wrong secret surfaces those routes' own Polish 401
 * rather than a second message that could disagree with it.
 *
 * That is the difference from `spine-check.astro`, which ships the secret to the
 * browser and is therefore only allowed to exist behind `LIVEQUIZ_HARNESS`.
 *
 * **The field it is typed into is not on the projector.** It lives in `#host-menu`, a modal
 * opened by clicking the join QR in the top strip — a password box on a 1080p screen in front
 * of 150 people is one being typed in front of 150 people, and this one is touched twice a
 * session at most. This is presentation, not protection: the secret was never in the HTML and
 * still is not, and the routes remain the thing that guards the write path. Three doors lead
 * in, all through `openHostMenu`: the QR, the 401 branch of `fire`, and the first paint of a
 * tab with nothing in `sessionStorage`.
 *
 * ## `end` is here now. `purge` is still not
 *
 * **This section previously read "`end` and `purge` are deliberately not here", and S-10
 * reversed half of it.** The original reasoning is kept rather than deleted, because a
 * reader checking why an irreversible verb sits on a stage screen should meet the position
 * it overturned: *F-03 set the two irreversible verbs apart from the flow verbs on purpose.
 * They stay on the harness page with its confirmation flow, which the runbook and the
 * rehearsal recovery path both lean on. A mis-click at the front of a room is not
 * recoverable.*
 *
 * What changed is that FR-006 asks the **host** to trigger the closing beat, and a terminal
 * window in front of a room is not a trigger. The mis-click risk is answered rather than
 * avoided: the button is set apart from the flow verbs, carries no `data-action` so the
 * blanket handler cannot reach it, requires two taps, disarms whenever the session moves,
 * and sends a version the route refuses if it is stale. See the button's own note below.
 *
 * **It is also not on the bar all session.** Its home is `#host-menu`; `syncEndButton` moves
 * it out to `#end-slot-bar` on the last question, the one beat where closing is the next step
 * rather than an escape hatch. Both halves matter: for thirteen questions the verb with no
 * undo takes opening a menu on purpose, and on the fourteenth it is exactly where the host has
 * always found it. Reaching it through the menu is a route, not a bypass — the phase rule that
 * mirrors what `end` accepts is unchanged in either place.
 *
 * `purge` stays on the harness page. It deletes with no undo and no ten-minute window, and
 * nothing about FR-006 asks for it on stage.
 */

/**
 * The quiz this panel drives, resolved from the address (multiple-quizzes).
 *
 * `Astro.params.slug` is `string | undefined` under `astro/tsconfigs/strict`, so the
 * guard is explicit rather than a `!`. An unknown slug is a **404**, not a fallback to
 * some other quiz: a host who mistyped the address has to find out here, in the lobby,
 * rather than by starting the wrong questions in front of the room.
 *
 * No `getStaticPaths` and no `prerender` export — this route is on-demand, as it has
 * always been. `getStaticPaths` is required for a *prerendered* dynamic route and is
 * meaningless on this one.
 */
const slug = Astro.params.slug;
const quiz = slug === undefined ? undefined : getPublicQuizById(slug);

/**
 * The four-digit join code, read from the *source* quiz rather than the projection.
 *
 * `PublicQuiz` deliberately omits `code` — it is a routing concern, and nothing on a
 * phone needs it once the phone has arrived. This page is the one surface that does: the
 * code exists to be read off the projector out loud. Two lookups over a registry parsed
 * once at module scope, which narrows both without a `!` and without a can't-happen
 * fallback standing in for the 404 below.
 */
const joinCode = slug === undefined ? undefined : getQuizById(slug)?.code;

/**
 * The evening's palette, or `undefined` for a quiz that registered none (change
 * `quiz-color-scheme`).
 *
 * A second frontmatter lookup beside `joinCode`'s, and for the same reason: the registry is
 * parsed once at module scope, and the alternative is threading a presentation field through the
 * public projection that exists to keep answers off the phones.
 *
 * It reaches **only the nine themeable tokens**. The closing inversion below, the rail's
 * four-colour register, the connection lamp and the reveal all read frozen tokens, so they are
 * identical on every quiz — which is what keeps the runbook's colour table true.
 */
const theme = getThemeForQuiz(slug);

/**
 * An unknown slug is a 404 **with something on it** (impl-review F6). A host mistypes a panel
 * address off a phone or a chat message minutes before a session, and a bare text body tells
 * them nothing about where the list of quizzes is.
 *
 * **Deliberately not the shared `QuizNotice` component**, which is what `/q/<code>`, `/quiz`
 * and the attendee route use. Rendering a component means the template below has to become
 * conditional, and this page's frontmatter derives `attendeeUrl`, `questionTotal` and the QR
 * from a *definite* quiz — so without the early return every one of them needs a placeholder
 * that is never rendered, which is a nonsense value living in the file permanently. The
 * alternative, extracting the panel into a component, would move the inline script out of the
 * file `host/[slug].test.ts` scans by path and silently disarm ninety assertions. Six lines of
 * duplicated shell is the cheaper of the three.
 *
 * If this copy and `QuizNotice`'s drift, the component is the canonical one.
 */
if (quiz === undefined || joinCode === undefined) {
  return new Response(
    `<!doctype html><html lang="pl"><head><meta charset="utf-8">` +
      `<meta name="viewport" content="width=device-width, initial-scale=1">` +
      `<meta name="robots" content="noindex"><title>LiveQuiz — nie ma takiego quizu</title>` +
      `</head><body style="margin:0;padding:2rem;background:#12121c;color:#e8e8f0;` +
      `font-family:system-ui,sans-serif">` +
      `<p style="font-size:1.75rem;font-weight:700">Nie ma takiego quizu.</p>` +
      `<p style="font-size:1.25rem;color:#9ca3af">Sprawdź adres panelu.</p>` +
      `<p><a href="/quiz/host" style="font-size:1.25rem;color:#e8e8f0">Wybierz quiz</a></p>` +
      `</body></html>`,
    { status: 404, headers: { "Content-Type": "text/html; charset=utf-8" } },
  );
}

/**
 * Every quiz's title, keyed by slug (impl-review F2).
 *
 * The panel compares the snapshot's `quizId` with the quiz it rendered, and a mismatch has
 * to be sayable: a host looking at the wrong panel needs the *name* of the session that is
 * running, not its slug. Only the server knows that mapping, so it travels through
 * `define:vars` — the sanctioned hand-off, since a `<script>` may not value-import from
 * `src/quiz/`.
 *
 * Titles and slugs only, exactly as on the attendee page: authored content already listed
 * unauthenticated on `/quiz/host`, saying nothing about who played. `code` stays out.
 */
const quizTitles = Object.fromEntries(
  publicQuizzes.map((entry) => [entry.id, entry.title]),
);

/**
 * Where the room goes. Built from the request so preview and production agree, and
 * slug-bearing so the QR and the printed address land on *this* quiz.
 */
const attendeeUrl = new URL(`/quiz/${quiz.id}`, Astro.url);

/**
 * The join address as the room reads it (plan §7, open question 1).
 *
 * `www.` is stripped **for display only** — four characters that carry no meaning to
 * someone typing the address, on the one line of this page that is set for the back of
 * the room. The QR below still encodes `attendeeUrl.href`, so the canonical URL is what
 * a scan resolves; a phone that types the shortened form is redirected by the host.
 */
const joinDisplayUrl = `${attendeeUrl.host.replace(/^www\./, "")}${attendeeUrl.pathname}`;

/**
 * The short address, for anyone whose phone will not scan (multiple-quizzes).
 *
 * The same host as the QR with `/q/<code>` after it, so the room can type four digits
 * instead of a slug. The **QR keeps pointing at `/quiz/<slug>`** — it is scanned, not
 * typed, so it loses nothing by being long, and the canonical URL is what a scan should
 * resolve to.
 *
 * Frontmatter only: no new client state, no change to `define:vars`. Nothing about this
 * value moves during a session.
 */
const shortJoinUrl = `${attendeeUrl.host.replace(/^www\./, "")}/q/${joinCode}`;

/**
 * How many questions the segment has, for the top strip's counter.
 *
 * Read in frontmatter rather than from the `questions` array the `<script>` already
 * receives, because the total never changes and the strip should carry it on first paint —
 * before any snapshot has arrived to say which question is current.
 */
const questionTotal = quiz.questions.length;

/**
 * THE FLOW VERBS' PILL, WRITTEN ONCE AND SIZED TO THE ARTBOARD.
 *
 * Stated here rather than four times in the markup for the reason `verbsFor` states it
 * once: four copies of a geometry are four chances for one of them to drift, and the row is
 * read as a row — a pill a step out of scale reads as a different kind of control.
 *
 * **The sizes are fixed px, and they went back to fixed px on purpose.** They were `clamp`ed
 * against `vw` — `text-[clamp(26px,2.08vw,40px)]` and friends — because the four verbs come to
 * ~1120px at 1920 and to ~1570px at 1440, so on the host's own window `flex-wrap` did what it
 * was told and the bar the room had learnt the shape of became two stacked lines mid-session.
 *
 * The canvas in `<head>` removed the premise: the bar is laid out on a 1920-wide artboard on
 * every screen, so there is no window in which this row has 1440px to fit into. Worse, a `vw`
 * inside the canvas resolves against the *real* viewport and is then scaled a second time — at
 * a 1794px window `2.08vw` is 37px and paints at 32px, where the artboard called for 40px
 * painting at 34px. A clamp here is now a way to be wrong, not a way to fit.
 *
 * `data-[next=true]` still sets no geometry — the filled and outlined states must stay the
 * same size, or the row reflows when a step becomes the next one.
 */
const FLOW_PILL = `rounded-full border-2 border-quiz-pill-border
  px-8 py-2 text-[40px]
  font-semibold tracking-[-0.01em] text-quiz-signwhite
  data-[next=true]:border-quiz-chrome data-[next=true]:bg-quiz-chrome
  data-[next=true]:font-bold data-[next=true]:text-quiz-ink
  disabled:border-quiz-divider disabled:text-quiz-pill-disabled`;

/**
 * The join QR (added 2026-08-08, from the first two-device run).
 *
 * The URL as text was the only way in, and typing it is the slowest step in a flow
 * PRD FR-002 gives thirty seconds — 150 people transcribing a hostname is the join
 * target spent before anyone has picked a name.
 *
 * Rendered **server-side into inline SVG**, so nothing extra ships to the phones and
 * the projector needs no network of its own to draw it. Dark modules on white rather
 * than the page's dark palette: an inverted QR is readable by many scanners and
 * reliably readable by fewer, and the venue is not the place to find out which kind
 * someone brought.
 *
 * The generator is server-only. `boundary.test.ts` would fail the suite if a
 * `<script>` block below ever imported it.
 */
const joinQrSvg = await QRCode.toString(attendeeUrl.href, {
  type: "svg",
  errorCorrectionLevel: "M",
  margin: 1,
  color: { dark: "#0b0b0c", light: "#ffffff" },
});
---

<html lang="pl" class="bg-quiz-ink">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>LiveQuiz — prowadzący</title>

    <!--
      THE THEME (change `quiz-color-scheme`), present only for a quiz that registered one.

      Re-declares the nine themeable tokens on `:root`, which is where they have to land: the
      ground is on `<html>` (`class="bg-quiz-ink"` above) and so is the canvas rule below, so a
      `body`-scoped override would theme the artboard and leave the letterbox around it at the
      global colour.

      **It deliberately does not reach the closing screen.** `--color-quiz-chrome` is frozen, so
      `html:has(body[data-phase="ended"])` below and the body's `data-[phase=ended]:bg-quiz-chrome`
      both still resolve to the global yellow on every quiz — the room's signal that the session
      ended, which the runbook tells the host they will see "without reading anything". What the
      theme *does* reach there is the type: `data-[phase=ended]:text-quiz-ink` paints the winner in
      this palette's ink on that yellow, so `theme.test.ts` asserts that one pair explicitly.

      `is:inline` keeps the rule in this response instead of a bundle shared by every quiz.
    -->
    {theme !== undefined && <style is:inline set:html={themeRootCss(theme)} />}

    <!--
      THE CANVAS: the artboard is 1920x1080, so the page is 1920x1080 and the window scales it.

      Every figure below this line — the 96px counter, the lobby's 264px tally, the bands'
      `min-h-[92px]`, the rail's `w-[440px]` — was measured against that artboard, and the shell
      was `h-dvh`, which is the host's window and not the artboard. At the 1794x919 the panel is
      actually driven from, 1080px of design had 919px to live in: the lobby column overflowed
      *upwards* across the top strip, and the option list lost its last band under the control bar.
      Neither was a fact about the content.

      So `<body>` is the artboard at its true size and `<html>` is the window, centring it and
      scaling it down to fit. Nothing inside changes — that is the whole point of doing it here
      rather than by converting two hundred fixed figures to relative units, which would have
      rewritten every class string on a page whose guards read them as literal text.

      **`tan(atan2(A, B))` is how you divide two lengths in CSS.** `scale()` takes a number, and
      `calc(100dvw / 1920)` is a length; the trig functions are the only route to a unitless ratio
      without JavaScript. Baseline: Chrome 111+, Safari 15.4+, Firefox 108+.

      **The bare `--fit: 1` above it is a deliberate fallback, not a leftover.** On an engine
      without `atan2()` the second declaration is invalid at computed-value time and dropped, the
      ratio stays 1, and the page renders exactly as it did before this change — the degradation
      is to the old behaviour, never to something worse.

      **`position: fixed` on the artboard, rather than centring it in flow.** A 1920x1080 box
      in normal flow inside a smaller window is scrollable overflow even with `overflow: hidden`
      on the window — the bars are gone but `scrollTop` still moves, so anything that scrolls an
      element into view (a focus ring landing on a control at the foot of the bar, say) slides
      the whole projector sideways under a room that is reading it. A fixed box contributes no
      scrollable overflow at all, so there is nothing to slide.

      Hence `translate(-50%, -50%)` before the scale rather than `place-items: center`: the
      translate is by the artboard's own half-size, and the scale then runs about the point it
      lands on, so the canvas is centred at any ratio.

      The chrome inversion has to reach the letterbox. `data-phase` stays on `<body>` — every
      descendant variant reads `[[data-phase=ended]_&]:` — so the window matches on it rather
      than carrying a second source of truth for which phase the view is in.

      The host menu is a modal `<dialog>` and therefore renders in the top layer, outside this
      transform. That is wanted: it is the one surface the host reads from arm's length rather
      than the room reads from the back, so it stays at its authored size and its `max-w-[90vw]`
      keeps meaning the window.
    -->
    <style is:global>
      html {
        height: 100dvh;
        overflow: hidden;
      }

      html:has(body[data-phase="ended"]) {
        background-color: var(--color-quiz-chrome);
      }

      body {
        --fit: 1;
        --fit: min(tan(atan2(100dvw, 1920px)), tan(atan2(100dvh, 1080px)));
        position: fixed;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%) scale(var(--fit));
      }
    </style>
  </head>
  <!--
    THE PROJECTOR SHELL (signage redesign, step 2).

    Three fixed regions — a top strip, a body split into stage and rail, and a control bar
    at the foot — rather than the single scrolling column this page was. The shell is what
    makes the later steps mechanical: every phase now paints into a slot whose size the
    room has already learnt, so nothing on the projector moves between questions except the
    content that is supposed to.

    **That last clause is now doing real work, and the two halves of it point in opposite
    directions.** *Geometry* is still and stays still — a region that appears and folds is a
    defect here, which is what `rail-empty-at-reveal` was about and why `FLOW_PILL` refuses
    to change size when a verb becomes the next step. *Content* arrives on purpose: the
    question, the revealed answer, the board and each new word-cloud chip land through
    `motion.ts` rather than blinking into their slot. The slot itself does not move while
    they do. See `motion-contract.md`.

    A fixed 1080px tall with `overflow-hidden`, deliberately. A projector has no scrollbar and
    nobody is going to reach for one mid-session, so content that overflows must be *visibly*
    wrong here rather than quietly parked below the fold.

    **The height is the artboard's, not the window's, and that distinction is the whole of the
    canvas rule in `<head>`.** It was `h-dvh`, and the two are only the same on a 1080p screen —
    everywhere else this rule was reporting the host's window size as a defect in the content.
    Now an overflow here is a fact about what was authored, which is what it was always meant
    to be.
  -->
  <!--
    `data-phase` on the body is how the closing screen inverts (roadmap S-10, FR-006).

    The ground goes chrome and the type goes ink for one phase and one phase only, and that
    inversion is the room's signal that the session is over — it works *because* chrome was
    rationed to a single accent everywhere else. A descendant reads it as
    `[[data-phase=ended]_&]:…`, which is a variant and therefore always wins over the base
    utility it overrides; the same ordering reasoning as `data-next` and `data-correct`.

    Set from `render` alongside every other phase decision, so there is no second place that
    decides what phase the view is in.
  -->
  <body
    data-phase="none"
    class="flex h-[1080px] w-[1920px] flex-col overflow-hidden bg-quiz-ink font-archivo
           text-quiz-signwhite antialiased data-[phase=ended]:bg-quiz-chrome
           data-[phase=ended]:text-quiz-ink"
  >
    <!--
      THE TOP STRIP: where the room is, and how to get in.

      Both halves stay up for the whole segment, which is the point. The counter answers
      "how much is left" without the host being asked, and the join address stays reachable
      for the person who arrives at question four — the previous layout put the QR in a
      header that scrolled with everything else.
    -->
    <!-- Hidden on the closing screen, both halves being wrong there: there is no current
         question to count and nothing left to join. That is what gives the winner the
         height the artboard sets them at. -->
    <header
      id="top-strip"
      class="flex shrink-0 items-center justify-between border-b-2 border-quiz-divider
             pt-[40px] pr-[72px] pb-[28px] pl-[72px]"
    >
      <!-- Hidden when no question is current — the lobby, and the gap between a purge and
           the next `start`. A counter reading "— / 14" is not a fact about the session; it is
           a slot waiting to be filled, and it reads from the back of the room as debris. -->
      <p id="question-counter" hidden class="flex items-baseline gap-4 leading-none">
        <span
          id="question-index"
          class="text-[96px] font-extrabold tracking-[-0.035em] tabular-nums text-quiz-chrome"
        >
          —
        </span>
        <span class="text-[48px] font-semibold tabular-nums text-quiz-zinc">
          / {questionTotal}
        </span>
      </p>

      <!-- Scan, or read the address off the same block. Both routes to the same place,
           side by side, at a size that survives the back of the room.

           `ml-auto` rather than relying on the strip's `justify-between`: both siblings above
           are `hidden` in the states that matter most for joining — the lobby, and the
           sessionless `brak sesji` fallback — and a lone flex child under `justify-between`
           sits at the *start*, so the QR slid to the left edge exactly when the room was
           looking for it. The margin pins it right regardless of how many siblings are up. -->
      <div class="ml-auto flex items-center gap-8">
        <div class="flex flex-col items-end gap-2">
          <p class="text-[26px] font-semibold uppercase tracking-[0.16em] text-quiz-zinc">
            Wejdź
          </p>
          <!-- The **short** address, not the canonical one. This line is on screen for the
               whole session and is the one somebody at the back actually retypes, and
               `ai-community.szczecin.pl/quiz/unaited` at this weight is wider than the space
               the strip can give it beside the QR. The full address is in the lobby, where
               there is room to set it properly. -->
          <p class="text-[56px] font-extrabold leading-none tracking-[-0.02em]">
            {shortJoinUrl}
          </p>
        </div>
        <!--
          THE QR IS ALSO THE DOOR TO THE HOST'S MENU.

          Clicking it opens `#host-menu`, which is where the host secret is typed. Nothing
          about the button says so — no cursor change, no hover, no label the room can read —
          because the point is that the projector shows the room a join code and shows them
          nothing about how this screen is driven. The secret field used to sit on the
          control bar in front of 150 people; the QR is the one element that is on screen in
          every phase, so it is the one target that always works.

          A `<button>` rather than a click handler on a `<div>`: it is keyboard-reachable and
          announces itself to a screen reader through `aria-label`, and it carries no
          `data-action`, so the blanket handler that drives the flow verbs cannot fire it and
          `allButtons` (an explicit list) never disables it mid-action.
        -->
        <button
          id="host-menu-open"
          type="button"
          aria-label="Menu prowadzącego"
          class="h-[112px] w-[112px] cursor-default rounded-[20px] bg-white p-2
                 [&>svg]:h-full [&>svg]:w-full"
        >
          <Fragment set:html={joinQrSvg} />
        </button>
      </div>
    </header>

    <!--
      THE HOST MENU: everything the host types, off the projector.

      One modal `<dialog>`, opened from the QR above and from the 401 branch of `fire` — the
      two moments it is needed: setting up, and being told the secret is wrong. `showModal`
      rather than a hand-rolled overlay, so Escape closes it and focus is trapped without this
      page growing a focus manager.

      It holds the secret field and its note, the session version, and the closing button —
      which lives here for every question but the last, and is the one thing in the dialog
      that moves the session. That is the point rather than an exception to it: the flow verbs
      and `odśwież` stay on the control bar where the host has learnt where they are and where
      a mis-reach cannot be hidden behind a dialog, while the verb with no undo is reached on
      purpose. On the last question it leaves and takes its place on the bar; see
      `#end-slot-menu` below.
    -->
    <dialog
      id="host-menu"
      class="m-auto w-[720px] max-w-[90vw] rounded-[24px] border-2 border-quiz-divider
             bg-quiz-asphalt p-[40px] text-quiz-signwhite backdrop:bg-black/70"
    >
      <div class="flex flex-col gap-6">
        <p class="text-[26px] font-semibold uppercase tracking-[0.16em] text-quiz-zinc">
          Menu prowadzącego
        </p>

        <div class="flex flex-col gap-3">
          <label
            for="secret"
            class="text-[26px] font-semibold uppercase tracking-[0.16em] text-quiz-zinc"
          >
            Sekret hosta
          </label>
          <input
            id="secret"
            type="password"
            autocomplete="off"
            class="rounded-[18px] border-2 border-quiz-field-border bg-quiz-ink px-4 py-2
                   text-[26px] text-quiz-signwhite focus:border-quiz-chrome focus:outline-none"
          />
          <span id="secret-note" class="text-[26px] text-quiz-zinc"></span>
        </div>

        <!--
          The session's version, off the projector for the same reason the secret is: the room
          cannot act on `v7`, and a number that ticks up beside the phase invites being read as
          if it meant something to them.

          It stays *somewhere*, because it is what a 409 is about and what the closing
          confirmation quotes — but the beat that needs it reads `state.version` in the script,
          never this element, so nothing depends on the menu being open. It is written on every
          render regardless, and is simply current whenever the host looks.
        -->
        <p class="text-[26px] text-quiz-zinc">
          wersja sesji:
          <span id="version" class="tabular-nums text-quiz-signwhite">—</span>
        </p>

        <!--
          THE MENU'S BUTTONS: one column, each under its own sentence.

          **Stacked rather than in a row, and every one of them explained.** The control bar
          can leave its verbs unlabelled — the host presses those fourteen times a session and
          the sequence teaches them. These are the opposite: opened twice, pressed rarely, and
          one of them cannot be undone. A row of unlabelled pills in a dialog nobody has built
          a habit around is where a host clicks the wrong thing under time pressure, so each
          one says what the tap does, in the room's language, before it is pressed.

          The sentences are 22px against the buttons' 26px — the only place on this page that
          goes below the host scale, and it is deliberate: this is read leaning in at a
          keyboard, not glanced at from a metre away, and a description set at the same size as
          its control competes with it.
        -->
        <div class="flex flex-col gap-6">
          <!--
            **`odśwież` is off the bar because the bar is for the room's beat, and this is not
            part of it.** A join publishes nothing, so this button was the lobby's manual pump
            — but S-11 gave the lobby a polled target on the one loop, so the count now climbs
            on its own and this is the fallback for when it does not. A fallback belongs where
            the host goes on purpose, not in the row their hand lives in for the whole segment.

            Its sentence is the one that has to say *nothing happens to the room*, because that
            is the question a host asks before pressing anything during a live segment.
          -->
          <div class="flex flex-col items-start gap-2">
            <button
              id="refresh"
              class="rounded-full border-2 border-quiz-divider px-5 py-1 text-[26px]
                     font-semibold text-quiz-zinc disabled:text-quiz-pill-disabled"
            >
              odśwież
            </button>
            <p class="text-[22px] leading-[28px] text-quiz-zinc">
              Pobiera aktualny stan sesji i odświeża liczby na tym ekranie. Niczego nie zmienia
              — sala niczego nie zobaczy.
            </p>
          </div>

          <!--
          THE CLOSING BEAT (roadmap S-10, FR-006), and **the reversal of a deliberate F-03
          decision** — see this page's docstring, which used to say `end` was not here.

          Four things keep that reversal defensible, and all four are load-bearing:

          - **It is set apart.** Never in the row of flow verbs, outlined in `signal`, and it
            carries no `data-action` — so a mis-reach lands on a flow verb and the blanket
            handler that drives them cannot fire it.
          - **It takes two taps.** The first arms it and rewrites the label; the second fires.
            Any action that moves the session disarms it again, so it can never fire into a
            state the host has not looked at.
          - **The route still guards it.** The second tap sends the version the host is
            looking at, which `end` refuses if it has moved. The interaction is the first
            line; the 409 is the backstop.
          - **It is not on the bar until the bar is where it belongs.** This is its home for
            every question but the last: reaching it mid-quiz means opening the menu on
            purpose, which is the deliberateness a one-way action wants, while the last
            question moves it out to `#end-slot-bar` where the host expects the closing verb
            to be. Menu access is a *route*, not a bypass — `syncEndButton`'s phase rule
            still refuses it outside `question-revealed` and `standings`, here as there.

          Authored here rather than on the bar so that the element the script moves has one
          birthplace, and so the sessionless first paint — which opens this menu anyway —
          finds it where the host is already looking.

          `purge` is deliberately still NOT here. S-10 reversed the placement for the verb a
          host needs on stage, not for the one that deletes without an undo, and a menu the
          host opens twice a session is not the argument that would change that.
        -->
        <!-- Disabled in the markup, not only by script: the page renders before the first
             snapshot arrives, and the one button that cannot be undone must not be live
             while the view still knows nothing about the session. -->
        <!-- `data-next` in its own palette, for the reason the flow verbs carry one: on the
             last question this is the only step left, and the bar has to say so. Filled in
             `signal` rather than in `chrome`, so the button that cannot be undone never
             looks like an ordinary flow verb even while it is the next one. -->
          <div id="end-slot-menu" class="flex flex-col items-start gap-2">
            <button
              id="end"
              disabled
              data-next="false"
              class="rounded-full border-2 border-quiz-signal px-5 py-1 text-[26px] font-semibold
                     text-quiz-signal data-[next=true]:bg-quiz-signal data-[next=true]:font-bold
                     data-[next=true]:text-quiz-ink
                     disabled:border-quiz-divider disabled:text-quiz-pill-disabled"
            >
              zakończ sesję i pokaż wyniki
            </button>
            <!--
              **The one sentence here that has to name a consequence rather than an effect.**
              The others describe what appears on a screen; this one is about a door closing —
              two taps, no undo, and the room's data on a short lifetime from that moment. It
              says the second tap is the real one, because the arming interaction is invisible
              until it has already happened once.

              It hides when the button is away on the bar (`syncEndButton` owns that, as it
              owns the move) — an explanation with no control under it is worse than none, and
              on the bar the button is the ringed next step and needs no sentence at all.
            -->
            <p id="end-note" class="text-[22px] leading-[28px] text-quiz-zinc">
              Kończy sesję i pokazuje zwycięzców na ekranie. Pierwsze kliknięcie tylko pyta o
              potwierdzenie, drugie kończy naprawdę. Tego nie da się cofnąć.
            </p>
          </div>

          <div class="flex flex-col items-start gap-2">
            <button
              id="host-menu-close"
              type="button"
              class="rounded-full border-2 border-quiz-divider px-5 py-1 text-[26px]
                     font-semibold text-quiz-zinc"
            >
              zamknij
            </button>
            <p class="text-[22px] leading-[28px] text-quiz-zinc">
              Chowa to menu i wraca do widoku sali. Sekret zostaje zapamiętany w tej karcie.
            </p>
          </div>
        </div>
      </div>
    </dialog>

    <!--
      THE LOBBY: two plates, and nothing else on the screen.

      This is the only beat where the whole room is doing one thing, and it is the thing PRD
      FR-002 gives thirty seconds. So the body is replaced rather than decorated: a white
      plate carrying a QR big enough to scan from the back row, and the ink plate carrying
      the two facts a person who cannot scan needs — where to type, and that people are
      already arriving.

      The QR is the same server-rendered SVG the strip carries, inlined a second time. Dark
      modules on white rather than the page's palette: an inverted QR is readable by many
      scanners and reliably readable by fewer, and a venue is not the place to find out which
      kind someone brought.

      It sizes off the available height rather than the artboard's flat 700px — the plate has
      to share 1080 with the strip and the control bar, and a QR that overflows is a QR that
      is cropped.
    -->
    <div id="lobby" hidden class="flex min-h-0 flex-1">
      <div
        class="flex w-[860px] shrink-0 items-center justify-center bg-quiz-signwhite p-[48px]"
      >
        <div class="aspect-square h-full [&>svg]:h-full [&>svg]:w-full">
          <Fragment set:html={joinQrSvg} />
        </div>
      </div>

      <div class="flex min-w-0 flex-1 flex-col justify-center gap-[48px] px-[72px]">
        <div class="flex flex-col gap-3">
          <p class="text-[26px] font-semibold uppercase tracking-[0.16em] text-quiz-zinc">
            Wejdź na
          </p>
          <!--
            THE TYPED ROUTE IS THE SHORT ONE, AND IT TAKES THE HERO LINE.

            This used to be `joinDisplayUrl`, and that address did not fit — not on the host's
            window and not on a real 1920 projector either. `ai-community.szczecin.pl/quiz/unaited`
            at 56px Archivo 800 is ~1110px of text in a column that is ~916px wide (1920 less the
            860px QR plate less 144px of padding), so it ran off the right edge on the artboard
            this page is measured against. The canvas does not fix that one; it is the line that
            is too long, not the screen that is too small.

            Which of the two leads is the fix. Somebody reading a line off a projector rather
            than scanning the QR beside it is typing on a phone, and `/q/1990` is four characters
            after the hostname against a slug they have to hear correctly. It fits, it is faster,
            and it lands in the same place.
          -->
          <p
            class="text-[56px] font-extrabold leading-none tracking-[-0.02em] text-quiz-chrome"
          >
            {shortJoinUrl}
          </p>
        </div>

        <!-- The canonical address, kept and demoted. It is what the QR encodes and what a
             bookmark or a link in the chat will carry, so the room seeing it once is worth a
             line; it is not what anyone should be typing, so it is not set at the size of one.

             `[overflow-wrap:anywhere]` is load-bearing rather than defensive: the whole address
             is a single token with no space in it, so without a rule that permits a break inside
             a word it cannot wrap at all — it can only overflow, which is what it was doing. -->
        <div class="flex flex-col gap-3">
          <p class="text-[26px] font-semibold uppercase tracking-[0.16em] text-quiz-zinc">
            Pełny adres
          </p>
          <p
            class="text-[34px] font-semibold leading-[40px] tracking-[-0.01em] text-quiz-zinc
                   [overflow-wrap:anywhere]"
          >
            {joinDisplayUrl}
          </p>
        </div>

        <div class="flex flex-col gap-3">
          <p class="text-[26px] font-semibold uppercase tracking-[0.16em] text-quiz-zinc">
            W sali
          </p>
          <!-- The join count is the lobby's whole feedback loop: nobody's join publishes
               anything (that would be the O(N^2) fan-out the spine contract forbids), so this
               number moving is how the room learns the thing works. -->
          <p
            id="lobby-count"
            class="text-[264px] font-extrabold leading-[244px] tracking-[-0.05em] tabular-nums"
          >
            —
          </p>
        </div>
      </div>
    </div>

    <div id="body-split" class="flex min-h-0 flex-1">
      <!--
        THE STAGE: what the room is reading. One question's worth of content, nothing else.

        `justify-between` so the prompt sits under the strip and the accepted answer lands
        at the foot of the stage rather than floating wherever the option list happens to
        end.
      -->
      <main
        id="stage"
        class="flex min-w-0 flex-1 flex-col justify-between overflow-hidden
               [[data-phase=ended]_&]:justify-center pt-[32px]
               pr-[72px] pb-[24px] pl-[72px]"
      >
        <div class="flex min-h-0 flex-col gap-[24px]">
          <section id="question" class="flex flex-col gap-[24px]"></section>

          <!-- The way out of the wrong panel (impl-review F2).

               A link, never a redirect: the host is mid-session on *some* quiz and a panel
               that navigated itself would move a screen somebody is reading. Static markup
               beside the stage rather than something `renderQuestion` emits, for the reason
               the answer fields on the attendee page are: `render()` runs on every applied
               snapshot and `replaceChildren()` would destroy anything living inside
               `#question`.

               Hidden by `render()` on every other path, so it cannot outlive the one branch
               that shows it; `href` and text are written there, never here. -->
          <a
            id="quiz-mismatch-link"
            hidden
            href="/quiz/host"
            class="self-start rounded-[16px] border-2 border-quiz-chrome px-8 py-5
                   text-[40px] font-semibold text-quiz-signwhite"></a>

          <!--
            The multiple-choice sentence used to be a `<p>` here, and is now emitted by
            `renderQuestion` between the prompt and the bands — see `MULTIPLE_NOTE_TEXT` in
            the script. A sibling in this column could only ever sit above the prompt or
            below the bands, and below the bands put it inside the stage's `overflow-hidden`,
            where any screen shorter than the projector cut it off.
          -->

          <!--
            The distribution bars, at a reveal (roadmap S-04, FR-005).

            **On the stage, not in the rail**: `renderQuestion` drops the option list when a
            distribution exists, so these bars *are* the option list at that moment and they
            carry the same text the room was reading a second earlier. Its own panel, because
            the count line beside it moved to the rail and the two now hide independently.
          -->
          <section id="distribution-panel" hidden>
            <div id="distribution"></div>
          </section>

          <!--
            The word cloud's chips (roadmap S-08, FR-012/FR-015).

            The one panel that fills continuously rather than on a host action, and the
            reason it exists at all: watching your own word land on the big screen is what
            proves the session is live. Fed by a **poll**, not by the snapshot — publishing
            per submission is the O(N^2) fan-out the spine contract forbids. See
            `/api/quiz/host/words`.

            The chips are stage content; the two counters that say how full the cloud is are
            rail content, because they are figures about the room rather than about the
            question.
          -->
          <section id="word-cloud-panel" hidden>
            <div id="word-cloud-words"></div>
          </section>

          <!--
            The leaderboard (roadmap S-07, FR-014), and the closing board (S-10, FR-006).

            The published top five, straight off the snapshot — the host's screen sorts
            nothing, and neither does any phone. That is what makes "no divergence in
            standings between devices" a property of the design rather than an agreement
            between four renderers.

            The heading carries an id because the closing beat renames it: the same board is
            a leaderboard between questions and a result at the end, and a projector that
            still says "Ranking" after the session closed leaves the room unsure whether
            anything has finished.
          -->
          <section id="standings" hidden class="flex flex-col gap-3">
            <p
              id="standings-title"
              class="text-[26px] font-semibold uppercase tracking-[0.16em] text-quiz-zinc"
            >
              Ranking
            </p>
            <div id="standings-board"></div>
          </section>
        </div>

        <!--
          The accepted answer for a free-text question, at reveal (roadmap S-05, FR-016).

          A choice question marks its correct option in the list above; a text question has
          no list to mark, so without this the room sees the answer on 150 phones and
          nothing on the projector — the failure the host notices from the stage.

          Hidden whenever the field is null, which the schema guarantees for every phase but
          `question-revealed`.
        -->
        <section
          id="accepted-answer"
          hidden
          class="rounded-[20px] border-2 border-quiz-mint bg-quiz-mint-tint px-8 py-6"
        >
          <p class="text-[26px] font-semibold uppercase tracking-[0.16em] text-quiz-zinc">
            Poprawna odpowiedź
          </p>
          <p
            id="accepted-answer-value"
            class="text-[72px] font-extrabold leading-tight tracking-[-0.035em] text-quiz-mint"
          >
          </p>
        </section>
      </main>

      <!--
        THE RAIL: at most two blocks, and never three.

        The room's participation on top — the answered count for any question that takes an
        answer, the cloud's two figures for a word one, only ever one of them visible — and the
        clock at the bottom.
        Everything here is a figure *about the room*; anything about the question belongs on
        the stage. That division is what keeps the rail readable at a glance from the stage,
        which is the only reason it is a separate column at all.

        `hidden` from the start, like the three sections inside it: `syncRail` owns whether it
        is on screen, and the first paint is a state it has an answer for — the sessionless
        one, where the rail is gone. Without it the server paints a 440px empty column that
        the first `render` folds away, and a column that appears and collapses is the motion
        the redesign spent its effort removing.
      -->
      <aside
        id="rail"
        hidden
        class="flex w-[440px] shrink-0 flex-col justify-between border-l-2 border-quiz-divider
               pt-[48px] pr-[72px] pb-[40px] pl-[56px]"
      >
        <div class="flex flex-col gap-[40px]">
          <!--
            `answered / joined` while a question is open — for every kind that takes an answer,
            the typed ones included. The word cloud has its own pair of counters below; nothing
            else has answers to count.

            Hidden with the `hidden` attribute, which needs no CSS to work — the same reason
            `setHidden` exists.
          -->
          <section id="participation" hidden class="flex flex-col gap-3">
            <div id="participation-count-box" class="flex flex-col gap-2">
              <p class="text-[26px] font-semibold uppercase tracking-[0.16em] text-quiz-zinc">
                Odpowiedzi
              </p>
              <!-- The two halves are separate elements because they are set at different
                   sizes: `12 / 40` as one string at the hero size does not fit a 440px rail,
                   and dropping the size to make it fit costs the figure the room's attention
                   more than the denominator is worth. -->
              <p class="flex items-baseline gap-3">
                <span
                  id="participation-count"
                  class="text-[116px] font-extrabold leading-[112px] tracking-[-0.05em] tabular-nums"
                >
                  —
                </span>
                <span id="participation-total" class="text-[40px] font-semibold text-quiz-zinc">
                  z —
                </span>
              </p>
              <!-- Beside the number, not in place of it: the count keeps its last value on a
                   failed poll, and this is what says the value is not fresh. -->
              <span id="participation-stale" hidden class="text-[26px] text-quiz-chrome">
                (nieaktualne)
              </span>
            </div>
          </section>

          <!--
            The word cloud's two counters.

            How much of the room has written is the figure the host reads to judge when to
            reveal (impl review F4). Distinct from the word count beside it: thirty attendees
            can write five words, so the two answer different questions and the cloud alone
            cannot say how many people have taken part. Both numbers come from the same poll
            reply, so this costs no extra command.

            It carries the same staleness marker the participation count does, because a
            cloud that has quietly stopped filling is indistinguishable from a room that has
            stopped writing.
          -->
          <section id="word-cloud" hidden class="flex flex-col gap-[32px]">
            <div class="flex flex-col gap-2">
              <p class="text-[26px] font-semibold uppercase tracking-[0.16em] text-quiz-zinc">
                Odpowiedzi
              </p>
              <p class="flex items-baseline gap-3">
                <span
                  id="word-cloud-answered"
                  class="text-[116px] font-extrabold leading-[112px] tracking-[-0.05em] tabular-nums"
                >
                  —
                </span>
                <span id="word-cloud-total" class="text-[40px] font-semibold text-quiz-zinc">
                  z —
                </span>
              </p>
            </div>
            <div class="flex flex-col gap-2">
              <p class="text-[26px] font-semibold uppercase tracking-[0.16em] text-quiz-zinc">
                Chmura słów
              </p>
              <p id="word-cloud-count" class="text-[40px] font-bold leading-none">—</p>
            </div>
            <span id="word-cloud-stale" hidden class="text-[26px] text-quiz-chrome">
              (nieaktualne)
            </span>
          </section>
        </div>

        <!--
          The countdown (roadmap S-11, FR-020).

          At the foot of the rail, away from the prompt: the room is reading the question,
          and a clock beside it makes the screen about the clock. Sized to be read from the
          back of the room, which is the whole point of putting it here rather than leaving
          it on 150 phones. It counts the same window the server enforces, from the same
          timestamp every phone uses, so the projector and the room cannot disagree about how
          long is left.

          Present only while a scored question is open — the two unscored questions carry no
          limit, and the word cloud in particular fills until the host reveals it.
        -->
        <section id="host-countdown" hidden class="flex flex-col gap-4">
          <p class="text-[26px] font-semibold uppercase tracking-[0.16em] text-quiz-zinc">
            Pozostały czas
          </p>
          <p
            data-countdown-text
            class="text-[116px] font-extrabold leading-[112px] tracking-[-0.05em] tabular-nums
                   text-quiz-chrome"
          >
            —
          </p>
          <div class="h-[14px] w-[312px] overflow-hidden rounded-full bg-quiz-divider">
            <div
              data-countdown-bar
              class="h-full rounded-full bg-quiz-chrome transition-[width] duration-1000 ease-linear"
              style="width: 100%"
            >
            </div>
          </div>
        </section>
      </aside>
    </div>

    <!--
      THE CONTROL BAR: the host's half of the screen, on its own plane.

      Everything the host touches lives here, below a hairline, on `asphalt` — so the room
      reads the stage and the host reads the bar, and neither has to filter the other out.
      The flow verbs keep a **fixed order** and never move between phases: which one is
      reachable changes, where it sits does not, because a button that migrates is one the
      host has to find again mid-session.
    -->
    <footer
      class="relative flex shrink-0 flex-col gap-4 border-t-2 border-quiz-divider
             bg-quiz-asphalt px-[72px] py-[24px]"
    >
      <!--
        THE MESSAGE TOAST (signage redesign step 5; made transient afterwards, with the user).

        **It was a docked first row of the control bar, and is now a floating toast that
        dismisses itself.** Two things changed together, and both were decisions taken with
        the user against the earlier ones:

        - *Transient.* Every register now goes away on its own, `refused` included. The
          previous rule kept the last thing said on screen indefinitely so a host who looked
          away still found it — the cost being that "start: OK" sat under the room's eyes for
          the rest of the segment. Accepted trade: an outcome the host missed entirely is
          gone, and the way back is to repeat the action. The durations are in
          `MESSAGE_HIDE_MS`, and the arming clock is `src/lib/client/toast.ts`.
        - *Floating.* `absolute bottom-full right-0` lifts it out of the bar's flex flow and
          parks it in the stage's bottom-right corner, above the control bar. Anchored to
          the footer rather than to the viewport so it never covers the host's own buttons —
          the bar keeps its height whether or not there is anything to say, so nothing in the
          layout moves when a message arrives or leaves. It does now overlay the foot of the
          stage, which the docked version existed to avoid; it is bounded to `max-w` and
          right-aligned, and it clears itself within seconds.

        **Sized for the host, not for the room** — 26px copy, the same scale as the secret and
        connection line under it, rather than the stage's 40px. It was stage-sized while it was
        a docked row of the bar, where it read as signage; floating over the projector, that
        size made every "start: OK" an announcement to 150 people. The host stands a metre from
        this screen and is the only person the sentence is for.

        The register is carried by the **left border**, not by a bar element inside the bubble.
        It was a `<span>` while the bubble was stage-sized and the marker was a piece of signage
        in its own right; at 26px that span was a stripe with a gap either side of it, which is
        a lot of structure for one bit of information. The border is the same signal with no box
        around it — one colour down the edge, so the shape of the toast *is* the register.

        Colour still does the work words cannot at this size: the host reads the edge from where
        they are standing and only then decides whether to read the sentence.

        Hidden while there is nothing to say. `say` is the only writer — including the hide,
        which reaches this element through the callback `say` installs and nowhere else.

        `role="status"` sits on the copy rather than on the bubble: the live region should
        announce the sentence, not the coloured edge around it.
      -->
      <div
        id="message-bubble"
        hidden
        class="absolute bottom-full right-[72px] z-30 mb-4 flex max-w-[640px] rounded-[14px]
               border border-l-[6px] border-quiz-field-border border-l-quiz-pill-border
               bg-quiz-float py-2 pl-4 pr-4 shadow-[0_10px_28px_rgba(0,0,0,0.45)]"
      >
        <p
          id="message"
          role="status"
          aria-live="polite"
          class="text-[26px] font-medium leading-[34px] tracking-[-0.01em] text-quiz-signwhite"
        >
        </p>
      </div>

      <!--
        The host's own line: a slot, and nothing else in it for most of the session.

        It carried three things and now carries none of them full-time. **The secret field**
        moved into `#host-menu`, behind the QR in the top strip — a password box on a projector
        is a password box 150 people are watching being typed, and it is touched twice a
        session at most; the 401 branch of `fire` opens the menu, so the recovery path is
        unchanged in effect. **The connection report** became the lamp in the footer's corner,
        below. **`odśwież`** went into the menu too, beside the version it refreshes: S-11 gave
        the lobby a polled target, so the count climbs on its own and the button is a fallback
        rather than the pump it used to be. **The closing button** lives in that same menu and
        comes back out here on the last question, which is the one beat it is the next step of.

        **It is `hidden` while it is empty, and it briefly was not.** A `min-h` held the row's
        44px open so the bar's height never moved — the shell's own principle, that nothing
        shifts between questions except the content that is supposed to. The trade it actually
        made is worse than the one it avoided: the bar reserved a band of empty asphalt above
        the verbs for thirteen questions out of fourteen, which reads as the docked message row
        that used to be there and is now a floating toast. Reserved emptiness is a thing the
        room looks at all session; the bar growing once, at the final beat, is a thing the room
        sees for a moment.

        So the row collapses entirely — `hidden`, so the footer's `gap-4` collapses with it
        rather than leaving 16px of the same emptiness behind. **`syncEndButton` is its only
        writer**, from the same reading that places the button: the row is on screen exactly
        when it has the button in it, which is one rule rather than two that can disagree.
        The stage above absorbs the ~60px at the last question; it is `flex-1` and its content
        is centred.
      -->
      <div
        id="end-row"
        hidden
        class="flex flex-wrap items-center justify-end gap-x-6 gap-y-3"
      >
        <!--
          WHERE THE CLOSING BUTTON LANDS ON THE LAST QUESTION — and nowhere else.

          The button itself is authored in `#host-menu` (see there for what it is and what
          guards it); this is the slot `syncEndButton` moves it into once `atLastQuestion`
          holds. **An empty slot rather than a `hidden` button**, because the button has to be
          in exactly one place at a time: two copies would be two labels to keep armed, two
          `disabled` states and a second reader of a rule this file keeps to one owner.

          `display: contents`, so the slot itself is not a flex child — an empty box would
          still take the row's `gap-x-6` with it, and the bar is measured for a projector. The
          row's `justify-end` is what puts the button against the right edge when it arrives;
          it used to inherit that position from `odśwież`'s `ml-auto`, which left with it.

          The move is what makes the bar mean something: for thirteen questions the utility
          line offers *nothing*, so the one control that cannot be undone is not sitting under
          the host's thumb for the whole session. On the last one it appears exactly where it
          has always been, ringed as the only step left.
        -->
        <div id="end-slot-bar" class="contents"></div>
      </div>

      <!--
        On `ended` the verbs are replaced by a sentence (plan §3).

        Every one of them is refused in that phase, so a row of four dark pills says only
        "nothing works" — where the row is the host's own reading of what to do next. The
        sentence says the same thing in the register the room is in.
      -->
      <p
        id="ended-note"
        hidden
        class="text-[40px] font-semibold leading-[52px] tracking-[-0.015em] text-quiz-zinc"
      >
        Sesja zakończona. Dziękujemy za grę!
      </p>

      <div id="control-row" class="flex flex-wrap items-center gap-4">
        <!--
          The flow verbs. Which one is offered — and which one is ringed as the next step —
          is decided by `verbsFor` and applied by `syncControls`, which is that decision's
          only reader. Nothing here states a phase condition of its own.

          `data-next` rather than a class toggle: the filled and outlined treatments set the
          same three properties, and two competing utility classes on one element are
          resolved by stylesheet order rather than by the order they were added. A variant
          always wins over the base utility, so the state is unambiguous.
        -->
        <button
          data-action="start"
          data-next="false"
          class={FLOW_PILL}
        >
          start
        </button>
        <button
          data-action="advance"
          data-next="false"
          class={FLOW_PILL}
        >
          dalej
        </button>
        <button
          data-action="reveal"
          data-next="false"
          class={FLOW_PILL}
        >
          pokaż odpowiedź
        </button>
        <!-- The FR-014 beat. Reachable only from a reveal, which is why it is disabled
             everywhere else rather than relying on the route's 409 — the refusal is the
             backstop, not the interaction. -->
        <button
          data-action="standings"
          data-next="false"
          class={FLOW_PILL}
        >
          pokaż ranking
        </button>
        <!-- The phase, which used to be a metric of its own above the prompt. It is the
             host's own reading of where the session is, so it belongs on the host's plane.

             **The version used to sit beside it and now lives in the host menu.** It is a
             debugging figure — the room cannot act on `v7` and should not be reading it off
             the projector at all — and the one beat that genuinely needs it, the closing
             confirmation, quotes the number back in its own sentence and reads it from
             `state.version` rather than from any element. So the display had no reader left
             on this bar.

             The join count sits here too for the phases where nothing else shows it. It is
             the *denominator* of the rail's `answered / joined` while a question is open,
             and the lobby will put it on the stage at full size — between the two, this is
             the host's own copy of a figure they should never have to ask for.

             Each number carries a word, because a bare `0 6` beside a phase name reads as
             debris rather than as two facts. -->
        <p class="ml-auto flex items-baseline gap-6 text-[26px]">
          <span id="phase" class="font-semibold uppercase tracking-[0.16em]">—</span>
          <span class="text-quiz-zinc">
            <span id="player-count" class="tabular-nums">—</span> w sali
          </span>
        </p>
      </div>

      <!--
        THE CONNECTION LAMP, in the bottom-right corner of the shell.

        **A sentence became a dot.** It read `połączenie: tryb zapasowy — limit Ably
        wyczerpany (40011) — sala pełna, potrzebny wyższy plan` at 26px on the bar, which is a
        paragraph of diagnosis parked permanently under the projector for a fact that is
        "fine" for the whole of a good segment. The dot carries the same three-way meaning in
        18px, and the sentence is one hover away.

        **The colour is the message; the words are the detail.** That is the same division the
        toast's marker makes and it holds for the same reason — colour survives being small in
        a way that words do not, and what the host needs across the room is *whether* to look,
        not what it says.

        **Out of the utility row and into the corner**, positioned against the footer rather
        than laid out in it: it is the one thing here that is not read in sequence with
        anything else, so a slot in a row of buttons costs the row its rhythm for a fact the
        host checks by glancing at a colour. Inside the footer's padding, so it clears the
        `zakończ sesję` button's outline and stays inside the shell — the page is `h-dvh` with
        `overflow-hidden` and `fixed` would put it in a different coordinate space for no gain.

        The tooltip opens *leftwards* (`right-0`), which is the whole reason the corner needs
        its own rule: anchored `left-0` it would grow off the right edge of a page that cannot
        scroll to reach it.

        The reveal is CSS-only, off `group-hover` and `group-focus-within` on the wrapper: no
        listener, no timer, nothing for this page's one-timer guards to have to reason about.
        `opacity` rather than `hidden`, deliberately — `role="status"` on a `display: none`
        element announces nothing, so the live region keeps working for a host who cannot see
        the colour at all, and `pointer-events-none` keeps the bubble from eating clicks aimed
        at the buttons beside it.

        `tabindex="0"` because a lamp nobody can focus is a lamp with no keyboard route to its
        own text.
      -->
      <div class="group absolute bottom-[14px] right-[20px] flex items-center">
        <span
          id="connection-dot"
          tabindex="0"
          role="img"
          aria-labelledby="connection"
          class="block h-[18px] w-[18px] rounded-full bg-quiz-zinc focus:outline-none
                 focus-visible:ring-2 focus-visible:ring-quiz-signwhite"
        ></span>
        <p
          id="connection"
          role="status"
          aria-live="polite"
          class="pointer-events-none absolute bottom-full right-0 z-30 mb-3 w-max
                 max-w-[560px] rounded-[14px] border border-quiz-field-border
                 bg-quiz-float px-4 py-2 text-[26px] text-quiz-signwhite opacity-0
                 transition-opacity group-hover:opacity-100 group-focus-within:opacity-100"
        >
          połączenie: —
        </p>
      </div>
    </footer>

    <script
      define:vars={{
        channelName: SESSION_CHANNEL,
        snapshotEvent: SNAPSHOT_EVENT,
        secretHeader: HOST_SECRET_HEADER,
        quizId: quiz.id,
        quizTitles,
        questions: quiz.questions,
      }}
    >
      window.__liveQuizHost = { channelName, snapshotEvent, secretHeader, quizId, quizTitles, questions };
    </script>

    <script>
      import {
        createSessionClient,
        type ConnectionInfo,
        type ConnectionStatus,
      } from "../../../lib/client/session";
      import { createCountdown } from "../../../lib/client/countdown";
      import { cancelMotion, forgetMotion } from "../../../lib/client/motion";
      import { createAutoHide } from "../../../lib/client/toast";
      import {
        atLastQuestion,
        NO_SESSION,
        pollTargetFor,
        verbsFor,
        type FlowAction,
        type PollTarget,
      } from "../../../lib/client/controls";
      import {
        el,
        quizMismatch,
        renderCountdown,
        renderDistribution,
        renderEntrance,
        renderFigureCountUp,
        renderQuestion,
        renderStandings,
        renderWordCloud,
        setHidden,
        setText,
        wordCloudCountText,
        type WordCount,
      } from "../../../lib/client/render";
      import type { PublicQuestion } from "../../../quiz/public";

      type Config = {
        channelName: string;
        snapshotEvent: string;
        secretHeader: string;
        /**
         * The quiz this panel rendered (multiple-quizzes), handed down through
         * `define:vars` — the sanctioned server-to-client hand-off. A `<script>` block
         * may not value-import `src/quiz/` or read `import.meta.env`, and
         * `boundary.test.ts` fails the suite if one does.
         */
        quizId: string;
        /** Slug to title, for naming the session that IS running. See the frontmatter. */
        quizTitles: Record<string, string>;
        questions: PublicQuestion[];
      };

      type ActionResponse = {
        state?: unknown;
        applied?: boolean;
        note?: string;
        error?: string;
      };

      /**
       * `sessionStorage`, not `localStorage`: the secret should not outlive the tab the
       * host opened for this segment. Outside the session namespace on purpose: it is
       * not session data, nothing in `keys.ts` governs it, and no purge has any business
       * with it — it is a convenience for one browser tab.
       */
      const SECRET_STORAGE_KEY = "quiz-host-secret";

      const config = (window as unknown as { __liveQuizHost: Config }).__liveQuizHost;

      const secretField = el("secret") as HTMLInputElement;
      const hostMenu = el("host-menu") as HTMLDialogElement;
      const questionBox = el("question");
      const mismatchLink = el("quiz-mismatch-link") as HTMLAnchorElement;
      const refresh = el("refresh") as HTMLButtonElement;
      const participationBox = el("participation");
      const countBox = el("participation-count-box");
      const staleMark = el("participation-stale");
      const distributionBox = el("distribution");
      /**
       * The stage-side panels the redesign split off from their rail-side counters.
       *
       * `participation` and `word-cloud` are figures about the room and live in the rail;
       * the bars and the chips are about the question and live on the stage. Two boxes mean
       * two visibility decisions where there used to be one — both are made from the same
       * predicate below, so the halves cannot come apart.
       */
      const distributionPanel = el("distribution-panel");
      const acceptedAnswerBox = el("accepted-answer");
      const standingsBox = el("standings");
      const standingsBoard = el("standings-board");
      const wordCloudBox = el("word-cloud");
      const wordCloudPanel = el("word-cloud-panel");
      /**
       * The three regions the lobby and the closing screen swap between them.
       *
       * `hidden` rather than a class, for the reason `setHidden` exists at all: it needs no
       * CSS to work, so a stylesheet that failed to load on a venue network leaves the page
       * ugly rather than showing the lobby underneath a question.
       */
      const topStrip = el("top-strip");
      const questionCounter = el("question-counter");
      const lobbyBox = el("lobby");
      const lobbyCountBox = el("lobby-count");
      const bodySplit = el("body-split");
      const railBox = el("rail");
      const controlRow = el("control-row");
      const endedNote = el("ended-note");
      const messageBubble = el("message-bubble");
      const wordCloudWords = el("word-cloud-words");
      const wordCloudStale = el("word-cloud-stale");
      const hostCountdownBox = el("host-countdown");
      const endButton = el("end") as HTMLButtonElement;
      /**
       * The closing button's two homes — the host's menu, and the utility line.
       *
       * **One button, moved**, rather than one per place. Two elements would be two labels to
       * keep in step with the arming state, two `disabled` flags for the phase rule to write
       * and two listeners to keep the two-tap confirmation identical across — and the copy
       * that fell behind would be the one that fired unarmed. `syncEndButton` is the only
       * caller of `append` on either of these.
       */
      const endSlotBar = el("end-slot-bar");
      const endSlotMenu = el("end-slot-menu");
      const endNote = el("end-note");
      /** The bar's row around the slot, on screen exactly when the slot has the button. */
      const endRow = el("end-row");

      const actionButtons = (): HTMLButtonElement[] =>
        Array.from(document.querySelectorAll<HTMLButtonElement>("button[data-action]"));

      /**
       * `endButton` is listed here but is deliberately **not** in `actionButtons` — it has
       * no `data-action`, so the blanket click handler that drives the flow verbs cannot
       * reach it. It belongs in this list because everything here is disabled while a
       * request is open, and closing the session on top of an action still in flight is
       * exactly the race the version confirmation would then have to catch.
       */
      const allButtons = (): HTMLButtonElement[] => [...actionButtons(), refresh, endButton];

      /**
       * The one opener, so every route into the menu lands the host in the same place with
       * the same field focused: the QR in the strip, a 401 from `fire`, and the first paint
       * of a tab that has no secret stored yet.
       *
       * Guarded on `open` because `showModal` on an already-open dialog throws, and the 401
       * path can fire while the host is looking at the menu — that is the *likeliest* moment
       * for it, since a wrong secret is what they came here to fix.
       */
      function openHostMenu(): void {
        if (!hostMenu.open) hostMenu.showModal();
        secretField.focus();
        secretField.select();
      }

      function readSecret(): string {
        try {
          return window.sessionStorage.getItem(SECRET_STORAGE_KEY) ?? "";
        } catch {
          return "";
        }
      }

      function storeSecret(value: string): void {
        try {
          window.sessionStorage.setItem(SECRET_STORAGE_KEY, value);
        } catch {
          // Storage disabled. The field still holds the value for this page load,
          // which is enough to run the segment.
        }
      }

      /**
       * The join count as of the last time anything told us one.
       *
       * Two sources feed it and both are legitimate: a snapshot carries the count that
       * was embedded when the host last acted, and `/api/quiz/state` carries one read
       * live. Whichever spoke most recently wins, because neither is authoritative over
       * the other — the count is informational by design, and the only failure that
       * matters is showing a stale number forever, which is what happened before the
       * live read existed.
       *
       * `null` means nothing has told us yet.
       */
      let liveCount: number | null = null;

      /**
       * THE FIRST OF THE PROJECT'S TWO SANCTIONED POLLING LOOPS (roadmap S-04, FR-005).
       *
       * The runbook's command tripwire is described there as a polling detector, so every
       * loop that exists has to be nameable. This one is bounded on purpose: **one
       * device**, only in the phases `pollTargetFor` names — the lobby's join count, an open
       * question's answered count, a word cloud — ~2.5s, so an unexpected pattern in the
       * command counter is still detectable as one.
       *
       * The second is the connection fallback in `src/lib/client/session.ts`, which polls
       * `/api/quiz/state` on any device whose Ably channel is unavailable. It is bounded
       * differently — by the outage, by tab visibility and by the session ending — and its
       * budget is recorded in `src/pages/api/quiz/state.ts`. The two are independent and
       * may run at once on this device; neither knows about the other.
       *
       * It is a read. `/api/quiz/host/participation` writes nothing, and that is
       * load-bearing rather than incidental: during `question-open` the session
       * document's `updatedAt` is the moment the question opened and bounds the speed
       * clamp, so a host-side write here would inflate every award after it. See the
       * warning in `src/pages/api/quiz/answer.ts`.
       */
      const POLL_BASE_MS = 2_500;
      const POLL_MAX_MS = 20_000;
      /**
       * The lobby target's floor, applied in `schedulePoll` rather than as a second delay.
       *
       * Slower than the 2.5 s a question's participation count needs, and much faster than
       * the 10 s this started at: the lobby is the one beat the *room* is watching the figure
       * on, and at ten seconds a person who had just joined could stand there through two
       * host sentences before the projector agreed they were in the room. See `schedulePoll`
       * for why this raises a floor instead of replacing the interval.
       */
      const LOBBY_POLL_MS = 3_000;
      /**
       * How long a tick is given before it is abandoned (impl review F1).
       *
       * **Without this a stall is indistinguishable from a healthy poll, and worse than a
       * failure.** `polling` stays `true`, so `schedulePoll` returns early and no further tick
       * re-arms; and `pollFailed` never runs, so the staleness marker never appears. The
       * projector then shows a frozen count or a frozen cloud that *looks live* — precisely
       * what `(nieaktualne)` exists to prevent, and the same class as the back-forward-cache
       * gap `pageshow` closes below.
       *
       * Ten seconds, matching `REQUEST_TIMEOUT_MS` in `src/lib/client/answer.ts`, whose
       * docstring states the rule this borrows: a request that never returns is worse than one
       * that fails, because nothing downstream can tell the difference. Generous against a
       * venue network and still well short of a host advance.
       */
      const POLL_TIMEOUT_MS = 10_000;
      /**
       * How many consecutive `401`s keep the fast interval before the loop starts backing
       * off. Five ticks is ~12.5 s — comfortably longer than a host takes to type the
       * secret, and short enough that a page which is never going to be authorised stops
       * hammering. See the `401` branch in `runPoll` for what this is protecting.
       */
      const UNAUTHORIZED_FAST_RETRIES = 5;

      let pollTimer: number | null = null;
      let pollDelay = POLL_BASE_MS;
      let unauthorizedPolls = 0;
      /**
       * The word cloud's per-question state (roadmap S-08).
       *
       * Held beside `answered` below and reset by the same `panelQuestionId` change, because
       * the two panels are two views of the same beat and a cloud left over from the previous
       * question under a new prompt is exactly as wrong as a stale count.
       *
       * `null` means the poll has not answered yet, which `renderWordCloud` draws as its
       * waiting sentence rather than as an empty room.
       */
      let cloudWords: WordCount[] | null = null;
      let cloudDistinct = 0;
      let cloudStale = false;
      /**
       * Which question's cloud has already had its final, post-reveal read.
       *
       * **Without this the loop never stops.** The word-cloud target below deliberately
       * covers `question-revealed` so the host keeps a complete cloud to talk over — but no
       * submission can arrive in that phase, so every tick after the first is guaranteed to
       * return the same bytes. This is what makes the final read a read rather than a loop.
       */
      let cloudFinalReadFor: string | null = null;
      /**
       * Whether a request is in flight.
       *
       * **`pollTimer` alone does not answer this**, and that gap is the bug this exists to
       * close: the timer callback clears the handle *before* awaiting, so for the whole
       * duration of a fetch there is no timer — and `render` runs on every snapshot, which
       * means every host action. Without this flag each such render scheduled another
       * tick, and a slow venue network could hold several requests open at once. Worst
       * exactly when the network is worst, which is when the backoff was meant to be
       * reducing load rather than racing it.
       */
      let polling = false;
      /** The last count the endpoint gave us. `null` means it has not answered yet. */
      let answered: number | null = null;
      let answeredStale = false;
      /** Which question the panel's numbers belong to, so a new one resets them. */
      let panelQuestionId: string | null = null;

      /**
       * WHAT THE CONNECTION LAMP IS LIT WITH.
       *
       * Every `ConnectionStatus` answered here, so the lamp can never hold a colour from a
       * status that no longer applies — and a status added upstream fails the build rather
       * than falling through to whatever was on screen.
       */
      const CONNECTION_COLOURS: Record<ConnectionStatus, string> = {
        connecting: "bg-quiz-chrome",
        connected: "bg-quiz-mint",
        degraded: "bg-quiz-chrome",
        lost: "bg-quiz-signal",
      };

      /**
       * The colour the markup opens with, before the first connection event — it is *no
       * report yet*, which is neither health nor failure. It has to be in the removal list
       * even though nothing ever sets it: two background utilities on one element are
       * resolved by their order in the stylesheet, not in the attribute, so leaving it on
       * would make the lamp's colour a Tailwind implementation detail.
       */
      const CONNECTION_UNLIT = "bg-quiz-zinc";

      const client = createSessionClient({
        channelName: config.channelName,
        snapshotEvent: config.snapshotEvent,
        /**
         * On for the same reason as the attendee view, with a sharper edge: this is the
         * one device whose failure stops the room. The host's own actions already return
         * authoritative state over HTTP, so a host with no channel can still run the
         * segment — the fallback is what keeps the panel from freezing between them.
         *
         * Independent of the participation loop below: that one is bounded to a choice
         * question on this device, this one to a channel outage. Both may run at once;
         * neither knows about the other.
         */
        fallbackPolling: true,
        onSnapshot: (state) => {
          if (state) liveCount = state.playerCount;
          render();
        },
        onCount: (count) => {
          // Fires even when the snapshot was dropped as not-newer, which is the
          // ordinary case for a refresh in a lobby nobody has advanced out of.
          if (count !== null) liveCount = count;
          render();
        },
        onConnection: (status: ConnectionStatus, info: ConnectionInfo) => {
          /**
           * **This is the one screen where the cause is named outright, code included.**
           * The host is the only person who can act on an exhausted Ably limit — the fix
           * is a plan upgrade, not patience — and `połączenie: disconnected` says nothing
           * about which of the two situations they are in. The code travels so it can be
           * matched against Ably's dashboard without guessing.
           *
           * Attendee phones get the neutral wording instead; see `index.astro`.
           */
          /**
           * Cause and mode are composed rather than chosen between. Picking one would
           * lose the diagnosis exactly when it is most useful: a host running on the
           * fallback *because* the account limit is exhausted needs to see both, or the
           * amber line reads as a network hiccup and the plan never gets raised.
           */
          const reason =
            info.cause === "account-limit"
              ? `limit Ably wyczerpany (${info.code ?? "?"}) — sala pełna, potrzebny wyższy plan`
              : info.detail;

          setText(
            "connection",
            status === "degraded"
              ? `połączenie: tryb zapasowy — ${reason}`
              : `połączenie: ${reason}`
          );
          /**
           * Three colours for three situations, because two would merge the one that
           * needs an action with the one that does not. Amber says the segment is running
           * on the fallback: worth knowing, not worth stopping for.
           *
           * **Swapped on the dot, not rebuilt.** The lamp carries its size, shape and focus
           * ring in the markup; a `className =` here would be a second copy of that layout
           * kept in step by hand — the same reasoning, and the same failure, as the toast's
           * marker. `classList` has nothing to drift.
           *
           * The table is a `Record<ConnectionStatus, …>`, so a fifth status added upstream is
           * a type error here rather than a lamp that silently keeps its last colour.
           * `connecting` shares amber with `degraded` rather than the red the old line gave
           * it: the first seconds of every page load pass through it, and a lamp that opens
           * red teaches the host to ignore red.
           */
          el("connection-dot").classList.remove(
            CONNECTION_UNLIT,
            ...Object.values(CONNECTION_COLOURS)
          );
          el("connection-dot").classList.add(CONNECTION_COLOURS[status]);
        },
      });

      /**
       * THE STAGE'S TYPE AND THE ANSWER BANDS (signage redesign, step 3).
       *
       * `render.ts` owns no styling — every class it applies arrives from here — so the
       * projector's whole visual language is these few strings. They are written once and
       * shared by the two call sites, because a second copy is how the sessionless first
       * paint ends up a different size from every subsequent one.
       *
       * ## The letter is a CSS counter, not markup
       *
       * The band's slab carries A, B, C… and `renderQuestion` renders an option as one
       * element with `textContent` — there is no child to put a letter in. Rather than
       * change the renderer for a presentational detail, the slab is a `::before` fed by a
       * counter on the list. The letters therefore follow the *rendered* order, which is what
       * the room reads and what the public projection deliberately shuffles; nothing derives them from
       * the definition's order, so the two cannot disagree.
       *
       * The distribution rows use the same counter over the same options in the same order,
       * so a band and its bar carry the same letter at the reveal.
       *
       * ## State travels by `data-` attribute, never by an appended class
       *
       * `renderQuestion` marks a correct option with `data-correct` and `renderDistribution`
       * marks its row the same way. Both are read here as Tailwind variants rather than
       * through the `optionCorrect` / `rowCorrect` hooks, because an appended utility and the
       * base utility it means to override are the same kind of rule — which of them wins is
       * decided by stylesheet order, not by the order they were joined. A variant always
       * wins. The same reasoning as the control bar's `data-next`.
       */
      const PROMPT_BASE = "font-extrabold tracking-[-0.035em] text-balance";
      /**
       * Where the prompt drops a step, in characters.
       *
       * The stage is ~1336px wide and 92px Archivo at weight 800 averages close to 26
       * characters a line, so a prompt past two lines takes the next setting down rather than
       * pushing the option list off a screen with no scrollbar. A character count is a coarse
       * stand-in for measuring the rendered line count — which nothing here can do before
       * paint — and the two thresholds are calibrated against the definition's own prompts,
       * the longest of which is 71 characters.
       *
       * The plan's rule is *cut words or drop a line, do not go smaller*, and this does not
       * contradict it: the two sizes below are both from the plan's own table, and everything
       * that could be spent instead of the prompt — the strip's height, the bar's padding,
       * the gaps between bands — already was.
       */
      const PROMPT_LONG_THRESHOLD = 52;
      const PROMPT_LONGEST_THRESHOLD = 58;

      function promptClass(prompt: string | undefined): string {
        const length = prompt?.length ?? 0;
        if (length > PROMPT_LONGEST_THRESHOLD) return `${PROMPT_BASE} text-[60px] leading-[62px]`;
        if (length > PROMPT_LONG_THRESHOLD) return `${PROMPT_BASE} text-[72px] leading-[74px]`;
        return `${PROMPT_BASE} text-[92px] leading-[92px]`;
      }

      /**
       * **The one thing the band shapes cannot say on their own** (plan §3).
       *
       * A multiple-choice question's slabs are outlined rather than filled, and the rule the
       * room is meant to read off that is "an empty square means more than one is allowed".
       * Nobody derives that from the first question they see, so the shape carries the
       * distinction *after* this sentence has taught it once.
       *
       * It travels into `renderQuestion` as a note, which is the only thing that can place a
       * line *between* the prompt and the list it explains. Sized at the strip's 26px rather
       * than the stage's own scale: it is an aside about the shapes, and a line the size of
       * the question competes with it.
       */
      const MULTIPLE_NOTE_TEXT = "Możesz wybrać więcej niż jedną";
      const MULTIPLE_NOTE_CLASS =
        "text-[26px] font-semibold uppercase tracking-[0.16em] text-quiz-chrome";

      /** The band itself: geometry and type, with no colour and no slab fill. */
      const BAND_BASE =
        "flex min-h-[92px] items-center overflow-hidden rounded-[20px] pr-8 text-[50px] " +
        "font-semibold leading-[58px] tracking-[-0.02em] [counter-increment:option] " +
        "before:mr-8 before:flex before:shrink-0 before:items-center before:justify-center " +
        "before:text-[48px] before:font-extrabold before:tracking-[-0.02em] " +
        "before:[--tw-content:counter(option,_upper-alpha)]";

      /**
       * The slab, and the one place the two choice kinds are told apart.
       *
       * **Filled means pick one; outlined means more than one is allowed.** That is the whole
       * distinction, it is load-bearing, and it is why a multiple-choice question does not
       * simply reuse the single-choice band with a different sentence above it.
       */
      const SLAB_SINGLE =
        "before:w-[92px] before:self-stretch before:bg-quiz-chrome before:text-quiz-ink";
      const SLAB_MULTIPLE =
        "ml-0 pl-3 before:h-[80px] before:w-[80px] before:rounded-[8px] before:border-4 " +
        "before:border-quiz-chrome before:text-quiz-chrome";

      /**
       * The reveal's colours, keyed on the renderer's `data-correct`.
       *
       * The correct band takes mint and its tint; every other band steps back to `#C9C9C4`
       * with an inactive slab — a reveal in which the wrong answers look exactly as they did
       * a second earlier makes the room hunt for what changed.
       */
      /**
       * The reveal, as variants keyed on `#question`'s `data-revealed` (impl review F10).
       *
       * **This used to be a second plain class string joined onto the slab's**, and the two
       * set the same properties on the same pseudo-element at the same specificity — the
       * exact hazard this file's own note above says it avoids. It resolved correctly only
       * because Tailwind sorts same-utility rules by theme-token declaration order and
       * `slab-inactive` happens to be declared after `chrome`: **reordering the
       * `--color-quiz-*` block would have silently flipped the revealed slabs back to
       * chrome**, with nothing failing.
       *
       * Now the two are mutually exclusive by selector rather than by luck. The stepped-back
       * band excludes `[data-correct=true]`, so the correct band's own `data-` variants own
       * that row outright — the same construction the phone's own-pick-versus-correct rule
       * uses, and for the same reason.
       */
      const REVEALED = "[[data-revealed=true]_&:not([data-correct=true])]:";
      const BAND_REVEALED =
        `${REVEALED}text-quiz-echo ${REVEALED}before:bg-quiz-slab-inactive ` +
        `${REVEALED}before:text-quiz-zinc ${REVEALED}before:border-quiz-slab-inactive ` +
        "data-[correct=true]:bg-quiz-mint-tint data-[correct=true]:text-quiz-mint " +
        "data-[correct=true]:before:bg-quiz-mint data-[correct=true]:before:border-quiz-mint " +
        "data-[correct=true]:before:text-quiz-ink";

      /**
       * One string for both phases now: the ground and the open-question type are the base,
       * and the reveal only ever *overrides* through the variants above. `revealed` is no
       * longer a parameter here — the DOM carries it.
       */
      function bandClass(kind: string | undefined): string {
        return [
          BAND_BASE,
          "bg-quiz-asphalt text-quiz-signwhite",
          kind === "multiple-choice" ? SLAB_MULTIPLE : SLAB_SINGLE,
          BAND_REVEALED,
        ].join(" ");
      }

      /** Shared by the bands and the bars, so their letters line up. */
      const BAND_LIST = "flex flex-col gap-2 [counter-reset:option]";

      const PHASE_LABELS: Record<string, string> = {
        lobby: "poczekalnia",
        "question-open": "pytanie otwarte",
        "question-revealed": "odpowiedź ujawniona",
        standings: "ranking",
        ended: "zakończona",
      };

      /**
       * WHAT THE CHIP SAYS WHILE A QUESTION IS OPEN.
       *
       * The phase word is right and reads wrong. `pytanie otwarte` means *the question is
       * accepting answers*, and on a multiple-choice question a host glancing at the bar reads
       * it as *this is an open-ended question* — the one phase where the label is ambiguous is
       * the one it is looked at in. So `question-open` names the kind instead, which is the
       * fact the host actually wants there: what the room is being asked to do right now.
       *
       * The other four phases keep their phase word. They have no question to name, and
       * `question-revealed` is about the beat rather than the kind.
       *
       * A table rather than a chain of `kind === …` tests, deliberately: `pollTargetFor` is
       * this file's single *predicate* over kinds and `host/[slug].test.ts` fails a second one. A
       * lookup decides nothing — it only spells five nouns — so it cannot drift from the rule
       * that decides which panel is on screen.
       *
       * `Record<PublicQuestion["kind"], string>` makes a sixth kind a type error here rather
       * than a chip that quietly falls back to the phase.
       */
      const KIND_LABELS: Record<PublicQuestion["kind"], string> = {
        "single-choice": "jednokrotny wybór",
        "multiple-choice": "wielokrotny wybór",
        // The kind the phase word was being mistaken for, now naming itself.
        text: "pytanie otwarte",
        number: "pytanie liczbowe",
        "word-cloud": "chmura słów",
      };

      type State = NonNullable<ReturnType<typeof client.current>>;

      function questionFor(state: State): PublicQuestion | undefined {
        return config.questions.find((candidate) => candidate.id === state.currentQuestionId);
      }

      /**
       * Both predicates below now live in `src/lib/client/controls.ts`, which is where they
       * can be executed by a test rather than read as text. They take the published question
       * order explicitly, which is the only thing they ever closed over here.
       *
       * `atLastQuestion` and `pollTargetFor` keep their names and their rules exactly; what
       * changed is that a guard about them can now fail.
       */

      /**
       * The lobby target is bounded exactly like the other two: one device, one phase,
       * ~2.5 s (floored at 3 s) with the same backoff and the same visibility rule, and it
       * ends the moment the host starts the first question. Two commands a tick, which is the
       * figure `src/pages/api/quiz/state.ts` records. The rule that picks it is in
       * `controls.ts`; what bounds it is this file's single loop, below.
       */

      /** Whether a tick is still worth firing for the current target. */
      function pollWanted(state: State | null): boolean {
        const target = pollTargetFor(config.questions, state);
        if (target === null) return false;

        // The final-read gate. Only the word cloud has one; the participation loop stops
        // because its target disappears at the reveal.
        if (target.kind === "words" && state?.phase === "question-revealed") {
          return cloudFinalReadFor !== target.questionId;
        }

        return true;
      }

      /**
       * Forgets every polled panel's numbers when the question changes.
       *
       * **One reset for both panels, called before anything renders.** A first paint under a
       * new prompt carrying the previous question's count — or its cloud — is plausible and
       * wrong, and the word cloud makes it worse than the count did: a chip is a word somebody
       * wrote, so a stale one attributes it to the question now on screen.
       */
      function resetPanels(questionId: string | null): void {
        panelQuestionId = questionId;
        answered = null;
        answeredStale = false;
        cloudWords = null;
        cloudDistinct = 0;
        cloudStale = false;
        // Deliberately NOT `cloudFinalReadFor`: it is keyed by question id, so it needs no
        // clearing here, and clearing it would re-open the loop for a question the host had
        // already revealed and come back to.
        pollDelay = POLL_BASE_MS;
      }

      function renderParticipation(state: State): void {
        const distribution =
          state.phase === "question-revealed" ? state.revealedDistribution : null;
        const showCount = pollTargetFor(config.questions, state)?.kind === "participation";

        // The rail's count and the stage's bars now hide independently, because they sit in
        // different regions — but both answers come from the one predicate, so a bar list
        // can still never appear for a question whose poll is not running.
        setHidden(participationBox, !showCount);
        setHidden(distributionPanel, distribution === null);
        setHidden(countBox, !showCount);
        setHidden(staleMark, !answeredStale);

        if (showCount) {
          // The denominator is the join count the page already maintains, which the
          // poll's own `playerCount` keeps fresh — so the join figure stops needing a
          // manual refresh while a question is open.
          /**
           * `—` until the first reply lands, and it goes through `reset` rather than through a
           * `textContent` write: the dash is also where a new question starts, so the counter
           * has to forget the previous one's figure here or the first reply would count up from
           * it. `resetPanels` nulls `answered` on exactly that transition, which is what makes
           * this branch the reset.
           *
           * Keyed by the question as well as the figure, so `3` on question 4 is not mistaken
           * for `3` on question 3 — the reset already covers that, and the key means the two
           * would have to fail together.
           */
          if (answered === null) answeredCount.reset();
          else answeredCount.to(answered, `${state.currentQuestionId}|${answered}`);
          setText("participation-total", `z ${liveCount ?? state.playerCount}`);
        }

        /**
         * The bars **are** the bands at a reveal: same letters, same order, same geometry,
         * with the room's share added at the right end. `renderQuestion` drops the option
         * list whenever a distribution exists, so the two never appear together — which is
         * what lets these carry the band's shape rather than looking like a second widget.
         *
         * The share is `count · share%` because neither number answers the other's question:
         * the share is what the room compares, the count is what makes it trustworthy. It is
         * computed against people, not selections, so on a multiple-choice question the bars
         * sum past 100% — see `renderDistribution`.
         */
        renderDistribution(
          distributionBox,
          state.currentQuestionId === null ? undefined : questionFor(state),
          {
            distribution,
            correctOptionIds: state.revealedOptionIds,
            /**
             * The projector is the one surface that opts into the count-up: the reveal is a
             * beat the host narrates, and bars that grow from zero give the room a second to
             * read the shape before the figures settle. `renderDistribution` runs it only when
             * the numbers actually changed, so the several renders a reveal sits through do
             * not reset it, and a reduced-motion display gets the final figures at once.
             */
            animate: true,
            list: BAND_LIST,
            row:
              "relative grid min-h-[92px] grid-cols-[92px_1fr_auto] items-center gap-x-8 " +
              "overflow-hidden rounded-[20px] bg-quiz-asphalt pr-8 [counter-increment:option] " +
              "before:flex before:h-[92px] before:items-center before:justify-center " +
              "before:bg-quiz-slab-inactive before:text-[48px] before:font-extrabold " +
              "before:tracking-[-0.02em] before:text-quiz-zinc " +
              "before:[--tw-content:counter(option,_upper-alpha)] " +
              "data-[correct=true]:bg-quiz-mint-tint data-[correct=true]:before:bg-quiz-mint " +
              "data-[correct=true]:before:text-quiz-ink",
            label:
              "text-[50px] font-semibold leading-[58px] tracking-[-0.02em] text-quiz-echo " +
              "[[data-correct=true]>&]:text-quiz-mint",
            count:
              "text-[52px] font-extrabold tabular-nums text-quiz-zinc " +
              "[[data-correct=true]>&]:text-quiz-mint",
            /**
             * The share as a rule along the foot of the band, not as a row of its own.
             *
             * Absolutely positioned so a bar costs no height: eight bands with their own bar
             * rows do not fit a 1080p stage under a prompt, and the honest fixes — a smaller
             * band or a smaller prompt — both spend something the room needs to read. It
             * starts where the text does, so the slab stays a solid block of colour.
             */
            bar: "absolute inset-x-0 bottom-0 left-[92px] h-[8px] bg-quiz-divider",
            barFill:
              "h-full bg-quiz-slab-inactive [[data-correct=true]_&]:bg-quiz-mint",
            // `echo`, not `zinc`: this is a sentence about the room, and zinc is for labels.
            empty: "text-[40px] leading-[52px] text-quiz-echo",
          }
        );
      }

      /**
       * The word cloud panel (roadmap S-08, FR-012/FR-015).
       *
       * Shown for exactly the phases the poll runs in, so the panel and the data path cannot
       * disagree — `pollTargetFor` is the single predicate, and asking it here is what keeps
       * that true rather than re-deriving the condition.
       *
       * A failed read leaves the last cloud on screen with the staleness marker beside the
       * count, never an empty one: on a projector an empty cloud is the claim that nobody in
       * the room wrote a word. `pollFailed` documents the same rule for the count.
       */
      function renderWordCloudPanel(state: State): void {
        const isCloud = pollTargetFor(config.questions, state)?.kind === "words";
        // The panel survives the final read: `pollTargetFor` still returns a words target in
        // `question-revealed`, and only `pollWanted` stops the ticks. That split is what lets
        // the host talk over a frozen cloud.
        setHidden(wordCloudBox, !isCloud);
        setHidden(wordCloudPanel, !isCloud);
        setHidden(wordCloudStale, !cloudStale);

        if (!isCloud) return;

        const shown = cloudWords?.length ?? 0;
        setText("word-cloud-count", wordCloudCountText(shown, cloudDistinct));

        /**
         * How much of the room has written (impl review F4).
         *
         * **The plan promised this line and the first implementation dropped it**, leaving the
         * route computing `answered` and this page storing it with nothing rendering it — a data
         * path with no affordance, which is `lessons.md`'s first rule inverted. The word count
         * beside it is not a substitute: it counts distinct *words*, so five words can mean five
         * people or fifty, and the host reads this figure to decide when to reveal.
         *
         * Same shape and same fallbacks as the participation count: `—` until the first reply,
         * the same count-up on its own instance, and the denominator prefers the freshest join
         * count the page holds.
         */
        if (answered === null) cloudAnsweredCount.reset();
        else cloudAnsweredCount.to(answered, `${state.currentQuestionId}|${answered}`);
        setText("word-cloud-total", `z ${liveCount ?? state.playerCount}`);

        renderWordCloud(wordCloudWords, cloudWords ?? undefined, {
          list: "flex flex-wrap items-baseline gap-x-10 gap-y-6",
          /**
           * `signwhite`, not chrome. A cloud is thirty chips at once, and chrome is rationed
           * to one intense moment per screen — a chrome cloud spends the whole budget on the
           * one panel that has no single thing to point at. The size scale is what carries
           * the emphasis here, and it is set inline by the renderer rather than by class.
           */
          chip: "font-extrabold leading-none tracking-[-0.02em] text-quiz-signwhite",
          empty: "text-[40px] leading-[52px] text-quiz-echo",
          // Measured for this projector: small enough that thirty fit, large enough that a
          // one-vote word is still readable from the back.
          minRem: 1.75,
          maxRem: 5,
          /**
           * The moment the PRD's FR-015 is about: a word somebody typed on their own phone
           * showing up on the big screen is what proves the session is live. Only words the
           * cloud has not drawn before move — the panel repaints on every poll, and
           * restarting thirty chips every 2.5 seconds is a fault, not an arrival.
           */
          animate: true,
        });
      }

      /**
       * What the stage says while `NO_SESSION` holds. Polish, because it renders directly.
       *
       * Names both halves of the fix in the order the host does them, because either alone
       * fails silently: `start` without a secret is a 401 in the status line, and a typed
       * secret without `start` is a page that keeps waiting.
       *
       * It names *where* the secret is typed since the field moved behind the QR: an
       * instruction pointing at a box that is not on screen is worse than none, and this line
       * is the one thing a host who has just opened the page is looking at.
       */
      const NO_SESSION_PROMPT =
        "Kliknij kod QR u góry, wpisz sekret hosta, a potem kliknij „start”, żeby rozpocząć rozgrywkę.";

      /**
       * The phase-to-verb decision — which verb is offered where, which one is the next
       * step, and what a dark one says about itself — moved to `src/lib/client/controls.ts`
       * as `verbsFor`. The table itself is private there, so a second reader of it is not
       * expressible rather than merely forbidden.
       *
       * It went for the reason `countdown.ts` did: an inline script has no harness, so the
       * only guard available over it was a scan of its own literal — and the property that
       * matters (the panel never offers a verb the route refuses) is a statement about the
       * routes, which no reading of this file can check. `controls.test.ts` runs it instead.
       *
       * The closing verb's phase rule went with it, so all five verbs now answer to one
       * mechanism. Its *arming* state stays here — see `syncEndButton`.
       */

      /**
       * WHAT THE REVEAL VERB IS CALLED WHEN THE QUESTION HAS NO ANSWER TO SHOW.
       *
       * A word-cloud question is unscored by the build gate (FR-015) and carries no correct
       * answer, so `pokaż odpowiedź` offers the host a beat that cannot happen — while the
       * button itself is doing something real and necessary: the reveal is what closes
       * submissions (`answer.ts` accepts only in `question-open`) and freezes the cloud on
       * the projector for the host to talk over. So this is a naming fix, not a gate. Do
       * **not** answer it by dropping `reveal` from the `question-open` row: that takes away
       * the only way to close the cloud, and with it the `standings` beat that follows.
       *
       * **Keyed on `pollTargetFor`, not on a fresh `kind === "word-cloud"` test.** That is
       * this file's single question-kind predicate — the same one `syncCloudPanel` asks —
       * and it already answers exactly the two phases in which this button can be read: the
       * cloud's own `question-open`, and the `question-revealed` it deliberately holds
       * through. A second kind test here is the drift the panel guards against everywhere
       * else.
       */
      const REVEAL_LABEL = "pokaż odpowiedź";
      const REVEAL_LABEL_CLOSES = "zamknij pytanie";
      const CLOUD_ALREADY_CLOSED = "Pytanie jest już zamknięte — przejdź do następnego pytania.";

      /**
       * What every flow verb says while this panel is not the running quiz's (impl-review F2).
       *
       * One string, because the whole bar carries the same reason: none of these verbs is
       * refused by its *phase* — the routes would happily apply them — they are withheld
       * because they would apply to a **different quiz's live session** than the one on this
       * screen.
       */
      const WRONG_QUIZ_REASON =
        "Ta sesja prowadzi inny quiz — otwórz jego panel, aby nim sterować.";

      /** The stage's copy in the same state. The link beneath it carries the destination. */
      const WRONG_QUIZ_PROMPT = "Ta sesja prowadzi inny quiz.";

      /**
       * Whether this panel is looking at a session running some other quiz.
       *
       * **One reader, for the reason the phase table has one:** `syncControls`,
       * `syncEndButton` and `render` all need the answer, and three copies of a comparison is
       * three chances for the bar to disagree with the stage. Reuses the attendee view's
       * tested `quizMismatch` rather than re-deriving it, passing `/quiz/host` so the link
       * points at a *panel* — see that function on why the base is a parameter.
       *
       * Returns `null` for no session, for this panel's own quiz, and for a running quiz with
       * no known title (a document that predates quiz identity) — all three fall through to
       * the ordinary rendering path, which is what those states had before.
       */
      function wrongQuiz(state: ReturnType<typeof client.current>) {
        return quizMismatch(
          config.quizId,
          state?.quizId ?? null,
          config.quizTitles,
          "/quiz/host"
        );
      }

      /**
       * REVEALING WHILE THE CLOCK IS STILL RUNNING TAKES TWO TAPS.
       *
       * The reveal is the flow verb with something to lose: `answer.ts` accepts only in
       * `question-open`, so the tap that shows the answer is the same tap that closes
       * submissions — and everyone still typing when it lands is simply cut off, with no
       * undo and nothing on any screen to say it happened early. `dalej` is recoverable and
       * `pokaż ranking` is a re-broadcast; this one is not.
       *
       * **The same two-tap shape as `zakończ sesję`, deliberately, down to the label and the
       * version rule** — one confirmation idiom on this bar rather than two. It is *not* a
       * route-side confirmation like `end`'s: the route has no business refusing an early
       * reveal, since a host who means it is exercising a legitimate call, and the guard is
       * about the mis-click, not about legality. So nothing travels with the request.
       *
       * **It is asked for exactly when it has something to protect** — see
       * `revealNeedsConfirm`. A confirmation the host meets on every question is one they
       * learn to double-tap through, which is worse than none: it costs a beat every time
       * and stops registering as a warning precisely when it is one.
       */
      const REVEAL_CONFIRM_LABEL = "na pewno? kliknij ponownie";

      /**
       * WHAT THE STANDINGS VERB IS CALLED ONCE THE BOARD IS ALREADY ON SCREEN.
       *
       * The button stays live in the `standings` phase, and that is load-bearing rather than
       * an oversight: `applyHostAction` answers a committed-but-unbroadcast board with a 502
       * reading "Kliknij ponownie, aby rozgłosić go jeszcze raz", and by then the session is
       * already in `standings`. Disabling it there turns that instruction into a pointer at a
       * dark button, and leaves `dalej` — which abandons the beat — as the only way on. That
       * is the failure impl review F5 fixed; do not re-introduce it by tidying the phase rule.
       *
       * **So the fix is the name, not the gate** — `REVEAL_LABEL`'s reasoning exactly. Called
       * "pokaż ranking" in a phase where the ranking is visibly already shown, the button
       * reads as a step the host forgot to take, and a tap on it reported itself as doing
       * nothing (the route now says otherwise — see its `republished` note). Named for what
       * the second tap actually does, it stops looking like a mistake and starts looking like
       * the recovery it is.
       *
       * The hint is on the enabled button rather than in the docs, because the question it
       * answers — *why would I click this again?* — is asked on stage, by someone who cannot
       * leave the panel to find out.
       */
      const STANDINGS_LABEL = "pokaż ranking";
      const STANDINGS_LABEL_AGAIN = "wyślij ranking ponownie";
      const STANDINGS_AGAIN_HINT =
        "Ranking jest już na ekranie. Kliknij, jeśli nie dotarł do wszystkich telefonów — " +
        "wyśle go jeszcze raz, bez zmiany stanu sesji.";

      /**
       * Whether the reveal is armed, and the version it was armed at.
       *
       * The version is the disarming rule, and it is `syncEndButton`'s reasoning applied to
       * the other one-way verb: arming is a statement about the session the host is looking
       * at, so any accepted action — theirs, or a second host's on another device — makes it
       * stale. Every accepted transition bumps the version, so it names "the state I looked
       * at" exactly.
       */
      let revealArmed = false;
      let revealArmedVersion: number | null = null;

      function disarmReveal(): void {
        revealArmed = false;
        revealArmedVersion = null;
      }

      /**
       * The phase rules, applied to the buttons.
       *
       * The decision comes from `verbsFor` and this function does the DOM writes — the split
       * that lets a test run the rule. Nothing here re-decides legality; everything here is
       * about labels, titles and the ring.
       *
       * Called from `render` AND from `fire`'s `finally`, because that block re-enables
       * every button unconditionally — without the second call, an action would hand back
       * buttons enabled in a phase that refuses them, which is the exact bug the two
       * previously-gated buttons already carry a warning about.
       */
      function syncControls(): void {
        const state = client.current();
        const phase = state === null ? NO_SESSION : state.phase;
        const rule = verbsFor(
          phase,
          atLastQuestion(config.questions, state?.currentQuestionId ?? null)
        );
        /**
         * **A precondition on the whole bar, deliberately NOT a row in the phase table**
         * (impl-review F2).
         *
         * `verbsFor`'s two dimensions are the phase and the position, and a mismatch is
         * neither — the session's phase is perfectly real, it just belongs to another quiz.
         * Adding a pseudo-phase for it would put a state into `CONTROL_RULES` that no route
         * legality row could be written against, which is the premise `controls.test.ts`
         * runs on. So the table still decides what this phase allows, and this decides
         * whether this panel is entitled to act on it at all.
         *
         * Every verb, including `start`: `start` would answer its own 409, which is a
         * refusal the panel is supposed to pre-empt rather than provoke ("disabled elsewhere
         * rather than relying on the route's 409").
         */
        const wrong = wrongQuiz(state) !== null;

        // The current question has no answer to reveal — only submissions to close.
        const revealCloses = pollTargetFor(config.questions, state)?.kind === "words";

        // The board is already on the projector, so the standings verb is a re-broadcast
        // rather than a step the host has yet to take. Naming only — see the constants.
        const standingsAgain = phase === "standings";

        // An arm does not survive the session moving under it. `syncEndButton`'s rule, for
        // the same reason and against the same mis-click.
        if (revealArmed && state?.version !== revealArmedVersion) disarmReveal();

        for (const button of actionButtons()) {
          // Cast rather than validated: the attribute is authored in this file's own markup,
          // and a typo there is a button no row of the table answers — which `verbsFor`
          // already handles by leaving it dark with no reason, exactly as it should.
          const action = (button.dataset.action ?? "") as FlowAction;
          const allowed = !wrong && rule.allow.includes(action);
          const reason = wrong
            ? WRONG_QUIZ_REASON
            : revealCloses && action === "reveal" && phase === "question-revealed"
              ? CLOUD_ALREADY_CLOSED
              : rule.why[action];
          /**
           * What an **enabled** button explains, which is a different question from what a
           * dark one does: not "why can I not press this", but "why would I press this in a
           * phase where it is plainly not the next step". Only the standings re-broadcast has
           * an answer worth the room's time — every other live verb says what it does in its
           * own name.
           */
          const hint = allowed && standingsAgain && action === "standings"
            ? STANDINGS_AGAIN_HINT
            : undefined;

          button.disabled = !allowed;
          // The explanation travels on the button itself, so a host who reaches for one
          // learns why without leaving the panel. **One `title` with two sources**, resolved
          // here rather than by two writes: the enabled hint and the refusal reason describe
          // opposite states, so a button must never be able to carry both.
          const title = allowed ? hint : reason;
          if (title !== undefined) button.title = title;
          else button.removeAttribute("title");

          // Naming only — the phase rule above is untouched by it. See `REVEAL_LABEL`.
          if (action === "reveal") {
            // Disarmed by the disable too: a button that went out of reach must not come
            // back still holding a tap the host made before the room moved.
            if (!allowed && revealArmed) disarmReveal();
            const name = revealCloses ? REVEAL_LABEL_CLOSES : REVEAL_LABEL;
            // The armed label wins over the name, never the other way round — the host has
            // to be able to read what the second tap is going to do.
            button.textContent = revealArmed ? REVEAL_CONFIRM_LABEL : name;
          }

          // Naming only, exactly like the reveal's above: the allow list is untouched, and
          // must stay so — this button is the retry the 502 asks for. See the constants.
          if (action === "standings") {
            button.textContent = standingsAgain ? STANDINGS_LABEL_AGAIN : STANDINGS_LABEL;
          }

          /**
           * The highlight on the next step: exactly one filled chrome pill on the bar, and
           * the rationing is what makes it read as an instruction rather than as decoration.
           *
           * **A `data-` flag rather than a class toggle.** The filled and the outlined
           * treatments set the same three properties, and two competing utilities on one
           * element are resolved by stylesheet order — not by the order they were added — so
           * a toggled `text-quiz-ink` could silently lose to the base `text-quiz-signwhite`.
           * A variant always wins over the base utility it overrides.
           *
           * Geometry is identical in both states on purpose: the bar is measured for a
           * projector, and a pill that grew when it became the next step would reflow the
           * whole row mid-session.
           */
          button.dataset.next = String(allowed && action === rule.next);
        }
      }

      /**
       * Whether the closing button is armed, and the version it was armed at (roadmap
       * S-10, FR-006).
       *
       * **The version is the whole of the disarming rule.** Arming is a statement about the
       * session the host is looking at, so any accepted action — theirs or a second host's —
       * makes it stale, and a stale arm firing is precisely the mis-click this reversal had
       * to answer. Every accepted transition bumps the version, so it identifies "the
       * session I looked at" exactly, in the same way `rankVersion` does on the attendee
       * side.
       */
      let endArmed = false;
      let endArmedVersion: number | null = null;

      /**
       * The closing button's phase rule, its placement and its arming state, in one place.
       *
       * Called from `render` AND from `fire`'s `finally`, for the reason
       * `syncControls` is: that block re-enables every button unconditionally, so
       * without the second call an action would leave this one enabled in a phase that
       * refuses it — and, worse, still armed.
       *
       * Enabled only where the route would accept it and the host would mean it:
       * `question-revealed` and `standings`. Not in `lobby` — a session nobody has played is
       * closed from the terminal, not by the one button on this page that cannot be undone;
       * not in `question-open`, which the route refuses anyway; not in `ended`.
       *
       * **That rule is no longer written here.** It is `end`'s row in `verbsFor`, alongside
       * the four flow verbs, so all five answer to one mechanism and one test — the closing
       * verb's phase rule was the piece of the panel that had no table and therefore no
       * executable guard. What stays is everything a table cannot hold: the arming, the
       * placement, the label.
       *
       * **`end` is deliberately not collapsed by `whenLast`.** The flow verbs offer nothing
       * on the last question; this one has to stay live there, because that is the beat where
       * it becomes the only step left.
       *
       * **Where it is, is a separate question from whether it works**, and this function owns
       * both. Placement follows `atLastQuestion`; the phase rule follows the phase; and the
       * two are deliberately not folded together — the menu makes the verb reachable mid-quiz
       * for the host who has to abandon a session, and it is the *route* that then refuses it
       * in a phase `end` would not accept. A menu that bypassed the phase rule would be a
       * second way to reach the one action with no undo.
       */
      function syncEndButton(): void {
        const state = client.current();
        const phase = state === null ? NO_SESSION : state.phase;
        const last = atLastQuestion(config.questions, state?.currentQuestionId ?? null);
        const rule = verbsFor(phase, last);
        // The same precondition the bar applies, and it has to be read here too: this is the
        // one control with no undo, and it would otherwise stay live on a panel entitled to
        // act on nothing. See `syncControls`.
        const wrong = wrongQuiz(state) !== null;

        if (endArmed && state?.version !== endArmedVersion) {
          endArmed = false;
          endArmedVersion = null;
        }

        endButton.disabled = wrong || !rule.allow.includes("end");
        // Disarmed by the disable too: a button that went out of reach must not come back
        // still holding a tap the host made before the room moved.
        if (endButton.disabled && endArmed) {
          endArmed = false;
          endArmedVersion = null;
        }

        /**
         * **WHERE THE BUTTON IS AT ALL**, which is the other half of the phase rule above and
         * belongs to this function for the same reason: it is one statement about one button,
         * and a second place deciding it is how a control that cannot be undone ends up on
         * screen in a beat nobody meant to offer it in.
         *
         * The menu is the home; the bar is the visit. For thirteen questions the closing verb
         * takes opening the menu — deliberate, which is what a one-way action wants — and on
         * the last one it comes out to the utility line ringed as the only step left. The
         * `ended` exclusion is not tidiness: the close already happened, the bar says so in
         * words, and a dead red pill beside that sentence is the "nothing works" row the
         * sentence exists to replace.
         *
         * **Not `hidden` on a button that stays put**, because the menu has to hold it while
         * it is away from the bar — a hidden button in one place is a button in no place.
         * `append` is a move, so the element, its listener and the arming state above survive
         * it untouched; the reparent is the whole of the operation.
         */
        const home = last && phase !== "ended" ? endSlotBar : endSlotMenu;
        if (endButton.parentElement !== home) home.append(endButton);
        // The menu's description goes with it, from the same statement that decided the move:
        // the sentence explains a button, so it may not outlive the button's absence, and a
        // second place deciding that is a second reading of `home`.
        setHidden(endNote, home !== endSlotMenu);
        // And the bar's row goes with it for the same reason, from the same reading. Held open
        // by a `min-h` at first, which bought a bar of constant height at the price of a band
        // of empty asphalt above the verbs for thirteen questions out of fourteen — reserved
        // emptiness the room looks at all session, against a bar that grows once at the close.
        // `hidden` rather than a zero height, so the footer's `gap-4` collapses with the row.
        setHidden(endRow, home !== endSlotBar);

        /**
         * **The ring moves here on the last question**, and it has to: the flow verbs offer
         * nothing once the last answer is revealed, so without this the bar names no next
         * step at the one beat where the host is being watched.
         *
         * **Read off the same decision rather than recomputed**, which is what keeps "exactly
         * one filled pill" true by construction: `verbsFor` names `end` as `next` in exactly
         * the rows where every flow verb has gone, so a row that lit two pills would have to
         * be written to. `last` is still what places the button, so the ring can only ever be
         * lit on the bar.
         */
        endButton.dataset.next = String(!wrong && rule.next === "end");

        // "…i pokaż wyniki" because that is what the tap does (S-10): the closing document
        // carries the final board, so this verb is the winner reveal, not just a shutdown.
        endButton.textContent = endArmed
          ? "na pewno? kliknij ponownie"
          : "zakończ sesję i pokaż wyniki";
      }

      /**
       * WHICH SHELL THE PHASE GETS, IN ONE PLACE.
       *
       * Three of the six states this view can be in replace the layout rather than fill it:
       * the lobby is two plates, the closing screen is an inverted ground with no rail and no
       * strip, and everything else is the stage-and-rail split. Deciding that here — and
       * writing `data-phase` from the same call — is what keeps a region from being shown by
       * one branch and hidden by another.
       *
       * Note what this does *not* decide, and there are two of them now. Whether the board is
       * on screen keys on `standings !== null` in `render`, because the schema owns the rule
       * about where a board may appear and a phase list here would be a copy able to fall
       * behind it. Whether the *rail* is on screen keys on whether any of its three blocks
       * is, in `syncRail` — same reason, and the close is covered by that rule rather than by
       * a case here. See `syncRail` for why a phase list would be wrong.
       */
      function applyShell(phase: string): void {
        document.body.dataset.phase = phase;

        const lobby = phase === "lobby";
        const ended = phase === "ended";

        setHidden(lobbyBox, !lobby);
        setHidden(bodySplit, lobby);
        setHidden(topStrip, ended);
        // Every verb is refused in `ended`, so the row would say only "nothing works".
        setHidden(controlRow, ended);
        setHidden(endedNote, !ended);
      }

      /**
       * THE RAIL IS ON SCREEN EXACTLY WHEN SOMETHING IS IN IT.
       *
       * Its three blocks each hide on their own rule — the answered count and the clock while
       * a question is open, the cloud's counters while the cloud is the question — and
       * `#rail` used to survive all of them, so an empty 440px column with a divider sat
       * beside the stage in four states: every non-cloud reveal, the standings beat, the
       * sessionless `brak sesji` fallback, and (handled, but as a special case) the close.
       * The stage is `flex-1`, so removing the rail from layout is what hands the bars and
       * the board the width they are read from the back of the room at.
       *
       * **Derived from the blocks, never from the phase.** The word-cloud reveal is the case
       * that makes a phase list wrong: `pollTargetFor` still returns a words target in
       * `question-revealed` so the host can talk over a frozen cloud, and a rule keyed on
       * `phase === "question-revealed"` would take the rail away from the one reveal that
       * still has something in it. Reading the sections' own `hidden` state is also what
       * keeps this from becoming a second copy of predicates that already exist above.
       *
       * Takes no `state` for the same reason — a parameter is the door a phase condition
       * walks back in through. It must run *after* the three panel renderers, which is why
       * both call sites sit with `syncControls`/`syncEndButton` at the end of their path.
       *
       * The close needs no case of its own: at `ended` the poll predicate returns null and
       * `stopCountdown` has already cleared the clock, so all three are hidden and the rail
       * goes — which is what `applyShell`'s comment about the winner taking the width was
       * describing all along.
       */
      function syncRail(): void {
        // `Boolean` because the DOM lib types `hidden` as `boolean | "until-found"`, so the
        // chain is `string | boolean` and `setHidden` takes neither. Every truthy value of it
        // means the block is off screen, which is the only thing this asks.
        const nothingToShow = Boolean(
          participationBox.hidden && wordCloudBox.hidden && hostCountdownBox.hidden,
        );
        setHidden(railBox, nothingToShow);
      }

      function render(): void {
        /**
         * **The countdown's single clearing point, and it is here rather than in its own
         * renderer because that was a bug.**
         *
         * `renderCountdownPanel` cleared the clock at its own top — but it is called near
         * the *end* of `render`, and the `state === null` branch below returns long before
         * reaching it. So a purge, a TTL expiry or a `bun run quiz:reset` left the timer
         * chain re-arming and `#host-countdown` on screen, counting a question down over
         * the "brak sesji" panel. Its own null handling was unreachable, which is the tell.
         *
         * Cleared before the first branch, every branch therefore passes through it, and
         * only the `question-open` path arms a clock again — the same shape the attendee
         * page uses, for the same reason.
         */
        stopCountdown();

        const state = client.current();

        if (state === null) {
          setText("phase", "brak sesji");
          setHidden(questionCounter, true);
          setText("player-count", "—");
          lobbyCount.reset();
          setText("version", "—");
          // A purge, an expiry, or the first paint. None of them is the lobby and none is the
          // close, so the ordinary split is what a sessionless view shows.
          applyShell(NO_SESSION);
          liveCount = null;
          setHidden(participationBox, true);
          setHidden(distributionPanel, true);
          setHidden(acceptedAnswerBox, true);
          setHidden(standingsBox, true);
          setHidden(wordCloudBox, true);
          setHidden(wordCloudPanel, true);
          stopPolling();
          // And the clock (impl review F8). This branch returns before `renderCountdownPanel`,
          // so without it a purge or an expiry mid-question leaves the rail counting down under
          // "brak sesji" — a timer running for a session that no longer exists.
          stopCountdown();
          /**
           * A purge or an expiry, so the next session starts from nothing. Without this the
           * cloud from the previous room would be re-shown the moment a new session reached
           * the same question — question ids are stable across sessions, which is what makes
           * that line up rather than being far-fetched (`clearSeen`'s reasoning on the
           * attendee side).
           */
          resetPanels(null);
          cloudFinalReadFor = null;
          /**
           * The stage says what to do, not what is about to happen.
           *
           * `renderQuestion`'s default placeholder — "Za chwilę pojawi się kolejne pytanie."
           * — is worded for the gap *between* two questions, and this branch is not that: a
           * purge, an expiry, or the first paint of a page nobody has started yet. Nothing
           * arrives on its own here, so the promise reads as a page that is loading and
           * leaves the host waiting instead of acting. The action is the one the panel below
           * already offers — the secret field, then `start`, the only verb `syncControls`
           * leaves live in this branch.
           */
          renderQuestion(questionBox, undefined, {
            prompt: promptClass(undefined),
            missingText: NO_SESSION_PROMPT,
          });
          // After the three hides above, which is what it reads: this branch shows `brak
          // sesji` on the stage and has no figure for the rail, so the rail goes with them.
          syncRail();
          // Before the early return, not after it: this branch is a purge, an expiry, or
          // the first paint, and in all three the closing button must be out of reach and
          // holding no arm from a session that is gone — while the flow verbs must fall
          // back to offering `start` alone, which is the only one a sessionless view can
          // honour.
          setHidden(mismatchLink, true);
          syncControls();
          syncEndButton();
          return;
        }

        /**
         * This panel is not the running quiz's (impl-review F2).
         *
         * **Before every branch that reads the session's own shape**, because none of them
         * is about this quiz: the counter would be blank, `questionFor` would resolve nothing
         * and the stage would paint "Za chwilę pojawi się kolejne pytanie." — promising a
         * room a question that is never coming, on the one screen 150 people are looking at.
         *
         * Keyed on the id comparison, never on a phase list: a mismatch is true in every
         * phase of the other quiz.
         */
        const mismatch = wrongQuiz(state);

        if (mismatch !== null) {
          setText("phase", "inny quiz");
          setHidden(questionCounter, true);
          setText("player-count", "—");
          lobbyCount.reset();
          setText("version", state.version);
          applyShell(NO_SESSION);
          liveCount = null;
          setHidden(participationBox, true);
          setHidden(distributionPanel, true);
          setHidden(acceptedAnswerBox, true);
          setHidden(standingsBox, true);
          setHidden(wordCloudBox, true);
          setHidden(wordCloudPanel, true);
          // Nothing on this panel is polling for a question that belongs to another quiz —
          // `pollTargetFor` already answers `null` for a foreign id, but stopping explicitly
          // is what makes that a decision rather than a coincidence.
          stopPolling();
          resetPanels(null);
          cloudFinalReadFor = null;

          renderQuestion(questionBox, undefined, {
            prompt: promptClass(undefined),
            // The one thing the room must not read here is the default placeholder.
            missingText: WRONG_QUIZ_PROMPT,
          });
          syncRail();

          mismatchLink.href = mismatch.href;
          // `textContent`, never `innerHTML` — `render.ts`'s escaping rule, and a quiz title
          // is authored content that still travels through a DOM write.
          mismatchLink.textContent = mismatch.linkText;
          setHidden(mismatchLink, false);

          // The bar and the closing button read the same comparison, so both go dark here;
          // called before the early return for the reason the sessionless branch calls them.
          syncControls();
          syncEndButton();
          return;
        }

        setHidden(mismatchLink, true);

        setText("player-count", liveCount ?? state.playerCount);
        const joined = liveCount ?? state.playerCount;
        lobbyCount.to(joined, `lobby|${joined}`);
        setText("version", state.version);

        applyShell(state.phase);

        /**
         * The top strip's counter.
         *
         * Derived from the question's position in the published definition rather than from
         * a field on the snapshot: the order is the definition's, the page already holds it,
         * and a number on the wire would be a second copy able to disagree with the prompt
         * beneath it. `—` in a phase with no current question, which is the lobby and the
         * gap between a purge and the next `start`.
         *
         * One-based, because it is read by a room rather than by a program.
         */
        const questionPosition = config.questions.findIndex(
          (candidate) => candidate.id === state.currentQuestionId
        );
        setHidden(questionCounter, questionPosition < 0);
        if (questionPosition >= 0) setText("question-index", questionPosition + 1);

        // Before any panel renders, so neither can paint the previous question's numbers
        // under a new prompt. Both polled panels read the state this clears.
        if (state.currentQuestionId !== panelQuestionId) resetPanels(state.currentQuestionId);

        const question = questionFor(state);

        /**
         * The chip, written here rather than with the other three figures above because it is
         * the one that needs the question — `KIND_LABELS` while it is open, the phase word
         * otherwise. Falls back to the phase if the question cannot be resolved, which is a
         * definition and a snapshot that disagree: the chip should then say what the session
         * thinks it is doing rather than go blank.
         */
        setText(
          "phase",
          (state.phase === "question-open" && question
            ? KIND_LABELS[question.kind]
            : PHASE_LABELS[state.phase]) ?? state.phase
        );

        const distribution =
          state.phase === "question-revealed" ? state.revealedDistribution : null;

        /**
         * The leaderboard beat (roadmap S-07, FR-014).
         *
         * The schema already refuses a board outside its own phase and a phase without
         * one, so the null check is the whole condition — the same reasoning the accepted
         * answer below rests on, and adding a phase test here would be a second place for
         * the rule to live.
         *
         * **Rendered from the snapshot with no sort.** Every device paints the sequence
         * the server published; see `renderStandings`.
         *
         * `ownDisplayName: null` because the host is not a player. The highlight belongs
         * to the attendee view.
         */
        const standings = state.standings;
        setHidden(standingsBox, standings === null);
        /**
         * The closing beat (roadmap S-10, FR-006).
         *
         * **The same board, told apart by phase and by nothing else.** The visibility rule
         * above is unchanged and still keys on the field alone — the schema is what decides
         * where a board may appear, and a phase test there would be a second place for that
         * rule to live. What the phase decides here is only how it reads: a heading, and the
         * winner's row set larger than the four under it.
         *
         * The emphasis is a first-child variant on the list rather than a new
         * `renderStandings` option, because it is presentation and the renderer's job is the
         * published order. `[&>li:first-child>span]` reaches the three spans a row is built
         * from — see `renderStandings`.
         */
        const closing = state.phase === "ended";
        setText("standings-title", closing ? "Zwycięzca" : "Ranking");
        // The ground is chrome on the closing screen, so the label that reads `zinc`
        // everywhere else needs the ink-on-chrome step instead. Nothing else about the
        // heading changes, including where it lives.
        el("standings-title").className = closing
          ? "text-[26px] font-semibold uppercase tracking-[0.16em] text-quiz-ink-on-chrome"
          : "text-[26px] font-semibold uppercase tracking-[0.16em] text-quiz-zinc";
        // The board replaces the question rather than sitting under it. The phase keeps a
        // `currentQuestionId` — that is what stops `advance` reopening question 1 — so
        // without this the finished question stays on the projector above the standings.
        setHidden(questionBox, standings !== null);
        /**
         * THE BOARD, IN ITS TWO REGISTERS (signage redesign, step 4).
         *
         * **The same board, told apart by phase and by nothing else** — the visibility rule
         * above still keys on `standings !== null`, because the schema is what decides where
         * a board may appear and a phase list here would be a second copy of that rule.
         * What the phase decides is only how it reads.
         *
         * Between questions: the leader takes a full chrome bar and the four under them sit
         * on hairlines, so the room reads the top of the board first and the rest as context.
         *
         * At the close: the ground is already chrome, so the winner cannot be marked with it
         * — they are marked with size instead, at 224px across the full width, and places two
         * through five become four equal lanes underneath. `first:` and `[li:first-child>&]:`
         * do the splitting, because `renderStandings` applies one row class to every row and
         * a variant is the only way to say "except the first" without a second renderer
         * option.
         */
        renderStandings(standingsBoard, standings?.rows, {
          ownDisplayName: null,
          animate: true,
          // The two registers publish the same five names, so without a key the closing
          // screen would inherit the standings beat's signature and arrive silently.
          motionKey: closing ? "ended" : "standings",
          list: closing
            ? "flex flex-wrap items-stretch gap-x-8 gap-y-6 [&>li:first-child]:w-full " +
              "[&>li:nth-child(n+2)]:min-w-0 [&>li:nth-child(n+2)]:flex-1 " +
              "[&>li:nth-child(n+2)]:basis-0"
            // No gap: the hairline under each row is the separation, and a gap on top of it
            // costs five rows more height than the stage has.
            : "flex flex-col",
          row: closing
            ? "flex min-w-0 flex-col gap-1"
            : "grid grid-cols-[auto_1fr_auto_auto] items-center gap-8 border-b-2 " +
              "border-quiz-divider px-6 py-0.5 first:mb-3 first:rounded-[20px] " +
              "first:border-transparent first:bg-quiz-chrome first:py-2 first:text-quiz-ink",
          rank: closing
            ? "text-[26px] font-semibold tabular-nums text-quiz-ink-on-chrome " +
              "[li:first-child>&]:hidden"
            : "text-[72px] font-semibold leading-[80px] tabular-nums text-quiz-zinc " +
              "[li:first-child>&]:text-[104px] [li:first-child>&]:font-extrabold " +
              "[li:first-child>&]:leading-[104px] [li:first-child>&]:text-quiz-ink",
          // `truncate` rather than a wrap: five rows that became seven would push the
          // board off the screen this type size was measured for.
          name: closing
            ? "truncate text-[56px] font-extrabold leading-[60px] tracking-[-0.035em] " +
              "[li:first-child>&]:text-[224px] [li:first-child>&]:leading-[212px] " +
              "[li:first-child>&]:tracking-[-0.055em]"
            : "truncate text-[72px] font-semibold leading-[80px] tracking-[-0.035em] " +
              "[li:first-child>&]:text-[104px] [li:first-child>&]:font-extrabold " +
              "[li:first-child>&]:leading-[104px]",
          points: closing
            ? "text-[40px] font-semibold tabular-nums text-quiz-ink-on-chrome " +
              "[li:first-child>&]:text-[72px] [li:first-child>&]:font-extrabold"
            : "text-[72px] font-semibold leading-[80px] tabular-nums " +
              "[li:first-child>&]:text-[104px] [li:first-child>&]:font-extrabold " +
              "[li:first-child>&]:leading-[104px]",
          /**
           * THE MOVEMENT CELL (this change).
           *
           * **Sized as secondary to the rank on purpose.** At 40px against the rank's 72px
           * it reads from the back of the room without competing with the position itself —
           * the arrow is context for the number, not a second number.
           *
           * `min-w-[3ch]` reserves the column so it takes the same width empty as it does
           * holding `▼12`. The renderer always emits the span, but an empty one is zero
           * wide, and a board where three of five rows moved would otherwise pull those
           * three names left while the other two stayed put.
           *
           * **The `[li:first-child>&]` override is the whole reason the colours are not
           * unconditional** (the defect impl review F1 already caught once on this board,
           * in the other direction). The leader's row is a chrome bar — `#ffd400` — and
           * mint on that is roughly invisible from anywhere in the room. Ink is near-black
           * on yellow and the triangle still carries the direction, so nothing is lost by
           * dropping the hue exactly where it cannot be read.
           *
           * Nothing here applies at the close: the row is a flex column there, the span is
           * empty, and `end.ts` publishes no deltas.
           */
          delta: closing
            ? ""
            : "min-w-[3ch] text-[40px] font-semibold leading-[48px] tabular-nums " +
              "[li:first-child>&]:text-quiz-ink",
          deltaUp: closing ? "" : "text-quiz-mint",
          deltaDown: closing ? "" : "text-quiz-signal",
          empty: closing
            ? "text-[40px] leading-[52px] text-quiz-ink-on-chrome"
            : "text-[40px] leading-[52px] text-quiz-echo",
        });

        /**
         * At a reveal with bars to show, **the option list is replaced by them** — the
         * bars carry the same option text with a count against it, so drawing both puts
         * the options on the projector twice. With no distribution (a failed tally read,
         * or a non-choice kind) the ordinary revealed rendering stands, so
         * `revealedOptionIds` still marks the correct answer and FR-016 holds either way.
         */
        const revealed = state.phase === "question-revealed";
        const shownQuestion =
          state.currentQuestionId === null
            ? undefined
            : distribution !== null && question
              ? { ...question, options: undefined }
              : question;

        // The flag the band variants key on. Set on the container rather than passed into the
        // class string, so the reveal cannot be half-applied: one attribute, every band.
        questionBox.dataset.revealed = String(revealed);

        /**
         * The multiple-choice sentence, shown exactly when its bands are on screen — so it
         * never explains an outline the room cannot see. `shownQuestion` rather than
         * `question`, because the reveal replaces the option list with the bars and the rule
         * about empty squares has nothing to say about a bar chart.
         *
         * **It is rendered *by* `renderQuestion` now, not hidden beside it**, and the change
         * is about where it can physically be. As a sibling in the page it could only sit
         * above the prompt or below the bands; below the bands it was inside the stage's
         * `overflow-hidden` and vanished on any screen shorter than the projector — which is
         * every screen this gets set up on. Passing it in puts it between the prompt and the
         * list, where the room reads it before the shapes it explains.
         *
         * The condition is unchanged; what was a `hidden` toggle is now a value or
         * `undefined`, which is the same rule with one fewer element to keep in step.
         */
        const multipleNote =
          question?.kind === "multiple-choice" &&
          Boolean(shownQuestion?.options?.length) &&
          // The board replaces the question, and the sentence goes with it. Keyed on the
          // same `standings === null` the question box is, so the two cannot disagree.
          standings === null
            ? MULTIPLE_NOTE_TEXT
            : undefined;

        renderQuestion(questionBox, shownQuestion, {
          prompt: promptClass(shownQuestion?.prompt),
          list: BAND_LIST,
          option: bandClass(question?.kind),
          note: MULTIPLE_NOTE_CLASS,
          noteText: multipleNote,
          mode: revealed ? "revealed" : "static",
          correctOptionIds: state.revealedOptionIds,
        });

        /**
         * The question arriving on the projector (this change).
         *
         * **Keyed by what is on the stage, including whether it has been revealed**, so the
         * reveal's re-render — which repaints the same prompt with the bands marked — lands
         * as its own beat rather than sitting still. A repeated snapshot carries the same
         * two values and moves nothing.
         *
         * On the block rather than on the prompt: `renderQuestion` wipes this container, so
         * anything inside it is a fresh node every render and has no arrival to speak of.
         */
        renderEntrance(
          questionBox,
          `${shownQuestion?.id ?? "none"}|${revealed ? "revealed" : "open"}`,
          { enabled: true },
        );

        /**
         * The accepted answer, straight off the snapshot (roadmap S-05).
         *
         * The schema already refuses a non-null value outside `question-revealed`, so
         * the null check is the whole condition — no phase test is needed here, and
         * adding one would be a second place for the rule to live.
         */
        const accepted = state.revealedAnswerText;
        setHidden(acceptedAnswerBox, accepted === null || accepted.length === 0);
        if (accepted) setText("accepted-answer-value", accepted);
        // After the hide, never before: a box that is hidden this render simply never
        // animates, which is what keeps the entrance out of the visibility rule's way.
        renderEntrance(acceptedAnswerBox, accepted ?? "", { enabled: true });

        renderCountdownPanel(state);
        renderParticipation(state);
        renderWordCloudPanel(state);
        // Last of the four, because it reads what the three above just decided.
        syncRail();
        syncControls();
        syncEndButton();

        if (pollWanted(state)) schedulePoll();
        else stopPolling();
      }

      /**
       * FOUR REGISTERS, BECAUSE TWO OF THEM WERE LYING (signage redesign, step 6).
       *
       * `say(text, bad)` was binary, and a boolean has no room for the two outcomes that are
       * neither: `applied: false` — the state is not where the host thought, nothing broke,
       * retrying does nothing — and the closing button's arming line, which is a question
       * being put to the host. Both came out mint, which is the colour this page uses for
       * *it worked*. On stage that is the difference between a host moving on and a host
       * pressing the same button again.
       *
       * - `ok` — it happened.
       * - `pending` — in flight. Nothing to do but wait.
       * - `attention` — nothing broke; the host has to decide something.
       * - `refused` — refused or not delivered.
       *
       * **The redesign's one planned behavioural change**, which is why it is its own commit:
       * it can be reverted without taking the styling with it. Two more were added along the
       * way, both unplanned and both fixing something older than this change — the countdown
       * recursion that blanked an expired question, and persisting a device's own pick so a
       * reload does not lose it.
       *
       * **The bubble used to be persistent and is now a toast** — it stays until its own clock
       * runs out or the next thing is said, whichever comes first. That reverses step 5's
       * decision (plan §7 open question 2), and the reversal was taken with the user for a
       * reason the plan could not see from a mockup: on a projector, "start: OK" is not an
       * outcome the host reads once, it is a line the whole room stares at until the next
       * action, whenever that is.
       *
       * **All four registers expire, `refused` included**, which is the part worth stating out
       * loud because it is the one that loses something. A host who looked away no longer finds
       * the refusal waiting; the recovery is to repeat the action, which is what a refusal asks
       * for anyway. The two registers that are *about* an unfinished thing get roughly twice as
       * long, and neither of them is the only sign that thing is unfinished: `pending` disables
       * every button while it is true, and `attention`'s one arming use re-labels the closing
       * button itself ("na pewno? kliknij ponownie") for as long as it stays armed. So the
       * durations below are the toast's own patience, never the state's.
       */
      type Register = "ok" | "pending" | "attention" | "refused";

      /**
       * The colours are whole class names, spelled out.
       *
       * Tailwind finds classes by scanning source text, so it sees these four literals and
       * emits them — but it would see nothing in a `border-l-quiz-${register}` built at
       * runtime, and the edge would come out in the default grey in production while working
       * in dev. Never assemble a class name from parts here.
       *
       * **Swapped through `classList`, never by rewriting `className`.** The colour now lives
       * on the bubble itself rather than on a marker element of its own, and the bubble carries
       * its whole layout in the markup above — so a full rewrite would mean keeping a copy of
       * that layout here, in step with the template, forever. Removing all four and adding one
       * is the version with nothing to drift.
       */
      const EDGE_COLOURS: Record<Register, string> = {
        ok: "border-l-quiz-mint",
        pending: "border-l-quiz-pill-border",
        attention: "border-l-quiz-chrome",
        refused: "border-l-quiz-signal",
      };

      /**
       * How long each register stays up. Read only by `say`.
       *
       * `pending` and `attention` are the two that are about something unfinished, so they get
       * the longer window — see the note on `Register` for why outliving them is nonetheless
       * safe. `refused` sits with `ok` at the short end rather than living forever, which is
       * the behaviour change this table carries.
       */
      const MESSAGE_HIDE_MS: Record<Register, number> = {
        ok: 4_000,
        pending: 9_000,
        attention: 9_000,
        refused: 6_000,
      };

      /**
       * The toast's clock. Its state machine is `src/lib/client/toast.ts`, unit-tested with
       * fake timers — inline it would be a second timer handle and a second `clearTimeout` on
       * a page whose guards pin both to the poll, and untestable besides.
       *
       * It is **not** a second poll loop and cannot become one: it fetches nothing, so it
       * spends no commands and cannot appear in the runbook's tripwire. Same standing as the
       * countdown, and `host/[slug].test.ts` classifies timers by what their callback can reach.
       */
      const messageHide = createAutoHide({
        defaultMs: MESSAGE_HIDE_MS.ok,
        onHide: () => setHidden(messageBubble, true),
      });

      function say(text: string, register: Register): void {
        /**
         * **Unhidden before the text is written** (impl review F4). `#message` is a live
         * region, and a node inside a `display:none` subtree is not in the accessibility tree
         * — so writing into the hidden bubble announced nothing, and revealing a bubble that
         * already held its sentence did not reliably announce either.
         *
         * Then hidden again when there is nothing to say: an empty bubble would hold a lit
         * rectangle over the stage for a sentence that is not there.
         */
        setHidden(messageBubble, false);
        setText("message", text);
        setHidden(messageBubble, text.length === 0);

        /**
         * Armed after the paint, and re-armed on every call — so a burst (`pending` then its
         * outcome) leaves one clock, belonging to the last thing said. An empty `say` has
         * already hidden the bubble, so it cancels rather than arming a hide for something
         * that is not on screen.
         */
        if (text.length === 0) messageHide.cancel();
        else messageHide.show(MESSAGE_HIDE_MS[register]);

        // The left edge carries the register; the copy stays `signwhite` in every one of them.
        // Four sentence colours would make the words themselves the signal, and a refusal set
        // in red reads as an error in the *page* rather than an answer from the route.
        messageBubble.classList.remove(...Object.values(EDGE_COLOURS));
        messageBubble.classList.add(EDGE_COLOURS[register]);
      }

      function stopPolling(): void {
        if (pollTimer === null) return;
        window.clearTimeout(pollTimer);
        pollTimer = null;
      }

      /**
       * A POLLED FIGURE THAT CLIMBS TO ITS NEW VALUE INSTEAD OF SWAPPING TO IT.
       *
       * The three figures on this page that a *poll* moves — the lobby's join count and the
       * two "how much of the room has answered" counters — share one problem a swap makes
       * worse the longer the interval is: the number is the only evidence the room's own
       * actions are landing, and replacing `0` with `25` in a single frame reads as a figure
       * being set rather than a room filling.
       *
       * **One factory rather than three copies**, for the reason this page states about its
       * poll: three copies would be three `shown` variables and three chances for one of them
       * to stop agreeing with the element it speaks for. The state each instance holds is
       * exactly what `renderFigureCountUp` cannot know — what is painted *right now*, mid-count
       * — and that is why it lives here rather than in `render.ts`.
       *
       * `shown` is written by the format callback, so it stays true mid-count as well: a tick
       * landing while the previous one is still climbing cancels that frame (`motion.ts` rule
       * 1), and the next count has to start from the digit the room is looking at rather than
       * from the number the cancelled run was heading for.
       *
       * Counting **from what is on screen** is the whole point, and it is not what
       * `renderFigureCountUp` does by default: an award is a fresh figure each question, so it
       * starts at zero. Here 24 → 25 must be one step, or every tick would look like the room
       * emptying and refilling.
       */
      function createCountUp(node: HTMLElement): {
        to: (value: number, signature: string) => void;
        reset: () => void;
      } {
        let shown = 0;

        return {
          /**
           * Keyed by the caller's signature, so the ordinary case — a tick that finds the same
           * figure — is a no-op rather than a replayed animation, on a page that re-renders on
           * every snapshot.
           */
          to(value, signature) {
            renderFigureCountUp(
              node,
              value,
              signature,
              (painted) => {
                shown = painted;
                return String(painted);
              },
              { from: shown }
            );
          },
          /**
           * Back to `—`, with nothing left running or remembered.
           *
           * All three parts are needed and none is a formality: an in-flight count would keep
           * writing digits over the dash (`cancelMotion`), a remembered signature would leave a
           * later beat that happens to land on the same figure showing the dash forever
           * (`forgetMotion`), and a stale `shown` would make the next count start from a number
           * belonging to the previous question — or the previous room.
           */
          reset() {
            cancelMotion(node);
            forgetMotion(node);
            shown = 0;
            node.textContent = "—";
          },
        };
      }

      /**
       * The lobby's join count. Nobody's join publishes anything, so this number moving is how
       * the room learns the thing works — the one figure here the room is actually watching.
       */
      const lobbyCount = createCountUp(lobbyCountBox);
      /**
       * The two answered counters, one per panel kind.
       *
       * Separate instances rather than one shared by both: they are two elements, and a single
       * `shown` would have the cloud's counter starting from whatever the choice question's
       * counter last painted. They never run at once — `pollTargetFor` picks one panel — but
       * "never at once" is a property of a predicate elsewhere, and this does not have to rely
       * on it.
       *
       * These climb over a smaller distance than the lobby's does: the poll is 2.5 s, so the
       * step is usually one or two. The animation is there for the beat where it is not — the
       * first reply after a question opens, and the burst when the room realises the clock is
       * running.
       */
      const answeredCount = createCountUp(el("participation-count"));
      const cloudAnsweredCount = createCountUp(el("word-cloud-answered"));

      function schedulePoll(): void {
        // Never two timers, and never a timer stacked behind a request that has not come
        // back. `render` runs on every snapshot, and a snapshot arriving mid-question
        // would otherwise add a second loop each time — the count would still look right
        // while the command spend doubled, then quadrupled.
        if (pollTimer !== null || polling) return;
        if (document.visibilityState === "hidden") return;

        /**
         * **The lobby ticks on a floor, not on its own interval.**
         *
         * `pollDelay` stays the loop's single delay — `host/[slug].test.ts` pins that, and for the
         * reason it states: a second delay variable is a second backoff, which is most of what
         * a second loop is. So the target raises the floor instead of replacing the schedule,
         * and `Math.max` keeps the backoff on top of it: a lobby whose ticks are failing still
         * doubles away from 10 s toward the same 20 s ceiling rather than being pinned there.
         *
         * 3 s because the lobby's figure *is* the beat: the room is looking at it, and the join
         * it is reporting was somebody's own. It still costs less than the participation count's
         * 2.5 s, and a ten-minute lobby comes to ~400 commands — the spend a floor exists to
         * bound, kept well inside the budget while the number stays responsive.
         */
        const floor =
          pollTargetFor(config.questions, client.current())?.kind === "lobby" ? LOBBY_POLL_MS : POLL_BASE_MS;

        pollTimer = window.setTimeout(() => {
          pollTimer = null;
          void runPoll();
        }, Math.max(pollDelay, floor));
      }

      /**
       * THE COUNTDOWN, AND WHY IT IS NOT A SECOND POLL LOOP (roadmap S-11, FR-020).
       *
       * `host/[slug].test.ts` guards this page against a second *polling* loop, for a specific
       * reason: two loops mean two backoffs, two in-flight flags, and two chances to leave
       * a timer fetching for a panel that is off screen. **This clock fetches nothing.** No
       * endpoint, no backoff, no failure mode beyond a stale number — so it costs no
       * commands and cannot appear in the runbook's tripwire, which is a polling detector.
       *
       * **Its state machine lives in `countdown.ts`, unit-tested with fake timers.** It was
       * inline until an implementation review found this page leaving a clock running over
       * a purged session — a bug the structural scan could not see, because a scan cannot
       * execute a timer.
       *
       * The remainder comes from the snapshot's `updatedAt` plus the question's own limit,
       * which is the same arithmetic every phone does from the same two values. The
       * projector cannot drift from the room because neither side measures anything local.
       *
       * **Nothing happens at zero.** No `onExpire`: the clock stops and the question stays
       * on screen, because the host owns every transition and nothing here may move the
       * session.
       */
      const countdown = createCountdown({
        onPaint: (remainingMs, limitMs) =>
          renderCountdown(hostCountdownBox, remainingMs, limitMs),
      });

      function stopCountdown(): void {
        countdown.stop();
        setHidden(hostCountdownBox, true);
        // Here rather than at the call sites, because a caller that forgets is silent. The
        // rail's rule is derived from this box among others, and `visibilitychange` and
        // `pagehide` clear the clock without passing through `render` — so without this they
        // leave the rail on screen with nothing in it until the next paint.
        syncRail();
      }

      /**
       * Arms the clock for a scored open question, and nothing otherwise.
       *
       * **Arm-only: the clearing lives at the top of `render`.** This function used to
       * clear as well, which read as safe and was not — it is called near the end of
       * `render`, so every early return above it skipped the clear entirely. Splitting the
       * two means the clear cannot be missed by a branch, and this one cannot be reached
       * without it having already happened.
       *
       * **Keyed on the limit's presence, never on a phase or kind list.** The schema
       * decides which questions carry a clock, and a list here would be a copy of that rule
       * able to fall behind it — the same reasoning both views apply to the board.
       */
      function renderCountdownPanel(state: State | null): void {
        if (state === null || state.phase !== "question-open") return;
        if (state.currentQuestionId === null) return;

        const question = config.questions.find((q) => q.id === state.currentQuestionId);
        if (question?.timeLimitSeconds === undefined) return;

        setHidden(hostCountdownBox, false);
        countdown.start(state.updatedAt, question.timeLimitSeconds);
      }

      /**
       * A poll that could not be answered.
       *
       * **Keep the last count and back off; never zero it.** `readPlayerCount`'s
       * discipline, for the same reason: on a projector a number that drops to zero
       * reads to the room as everyone having stopped answering, and a host who cannot
       * read the count is in a different situation from one whose room has gone quiet.
       * The staleness marker is what says which.
       */
      function pollFailed(kind: PollTarget["kind"]): void {
        // Only the panel that asked is marked stale. Marking both would put "(nieaktualne)"
        // beside a count nobody is polling — and the lobby target has no panel at all, so
        // `else` was the wrong shape the moment a third kind existed: a failed lobby tick
        // would have written "(nieaktualne)" beside a participation count for a question
        // that is not even open. The lobby's own figure keeps its last value and backs off;
        // the host still has `odśwież`, and the connection line says when the page is unwell.
        if (kind === "words") cloudStale = true;
        else if (kind === "participation") answeredStale = true;

        pollDelay = Math.min(pollDelay * 2, POLL_MAX_MS);
        render();
      }

      async function runPoll(): Promise<void> {
        const target = pollTargetFor(config.questions, client.current());
        if (target === null) return;
        if (!pollWanted(client.current())) return;

        /**
         * **The phase this request was ISSUED in, captured before it leaves** (impl review F2).
         *
         * The word cloud's final-read flag is set from this, not from the phase the reply
         * happens to arrive in. Read at arrival, a body computed while the question was still
         * open counts as the final cloud whenever the host reveals mid-flight — which this
         * function's own `finally` calls "the ordinary way that happens" — and every word
         * submitted after the request left is permanently missing from the cloud the host then
         * talks over, with nothing on screen to say so.
         *
         * The same capture-at-issue shape `index.astro` uses for its rank fetch
         * (`const beat = state.version`), and for the same class of reason.
         */
        const issuedInPhase = client.current()?.phase ?? null;

        // Nothing may open a second request while one is open — including the secret
        // field's immediate retry, which is otherwise one keystroke away from a burst.
        if (polling) return;
        polling = true;

        try {
          const response = await fetch(target.url, {
            headers: { [config.secretHeader]: secretField.value },
            // See `POLL_TIMEOUT_MS`: an abandoned request takes the `catch` below, which sets
            // the staleness marker. A request that never returns sets nothing at all.
            signal: AbortSignal.timeout(POLL_TIMEOUT_MS),
          });

          /**
           * **A 401 is not a network failure and must not take that path.** The ordinary
           * cause is a host who has opened the page and not yet typed the secret — the
           * first thirty seconds of every session. Backing off would leave the projector
           * showing a staleness marker that says nothing about what is actually wrong,
           * and would then delay recovery by up to the backed-off interval after the
           * secret is finally typed. So: report it as what it is, leave the interval
           * alone, and let the `input` handler on the secret field retry immediately.
           */
          // The lobby target cannot arrive here: `/api/quiz/state` is deliberately open, so
          // it has no 401 to give. The two host endpoints are what this branch is about.
          if (response.status === 401) {
            /**
             * It names the QR because the field is behind it now — but this branch
             * deliberately does **not** call `openHostMenu`, which the action path's 401
             * does. This one fires from a loop: a modal reopening every ~2.5 s over the
             * projector for the whole of a question is a worse failure than the one it
             * would be fixing, and the host is told exactly where to go.
             */
            say(
              target.kind === "words"
                ? "Kliknij kod QR i wpisz sekret hosta, żeby zobaczyć chmurę słów."
                : "Kliknij kod QR i wpisz sekret hosta, żeby zobaczyć liczbę odpowiedzi.",
              "refused"
            );

            /**
             * **The fast retries are bounded, and that bound is about a different threat
             * from the backoff above.** `/quiz/host` is deliberately unprotected — there
             * is nothing on it worth guarding — so an attendee who opens it during a
             * choice question would otherwise poll every 2.5 s for the whole segment.
             * Each of those requests emits a `session.auth.rejected` line, and `log.ts`
             * calls that the only security-relevant signal this system emits: a real
             * unauthorized attempt would sit buried among them. Backing off after the
             * window a host actually needs costs the honest case nothing, because the
             * `input` handler below resets this the moment the secret is typed.
             */
            unauthorizedPolls += 1;
            if (unauthorizedPolls > UNAUTHORIZED_FAST_RETRIES) {
              pollDelay = Math.min(pollDelay * 2, POLL_MAX_MS);
            }

            return;
          }

          // Reaching here means the secret is working, whatever else went wrong. Reset the
          // 401 counter but NOT `pollDelay` — a 503 below still needs to back off, and the
          // success path further down is what returns the interval to base.
          unauthorizedPolls = 0;

          if (!response.ok) {
            pollFailed(target.kind);
            return;
          }

          const payload = (await response.json()) as {
            questionId?: string;
            answered?: number;
            playerCount?: number | null;
            words?: WordCount[];
            distinct?: number;
          };

          /**
           * The host is free to advance at any moment, so a reply can arrive after the
           * question changed. Discarded rather than painted: the count — or worse, a cloud of
           * words somebody wrote about another question — would look entirely plausible under
           * the new prompt, which is what makes it worth a guard.
           */
          if (
            target.kind !== "lobby" &&
            payload.questionId !== client.current()?.currentQuestionId
          ) {
            return;
          }

          if (typeof payload.playerCount === "number") liveCount = payload.playerCount;

          if (target.kind === "lobby") {
            // The count above is the whole of it. Deliberately no `answered`/`cloud` write
            // and no staleness clear: this target feeds neither panel, and touching their
            // state here is how a lobby tick would come to speak for a question.
          } else if (target.kind === "words") {
            // Absent rather than empty is the "could not say" case, and it must not blank the
            // cloud — `readWordCloud` returns `null` for it and the route turns that into a
            // 503, which took the `!response.ok` path above. Reaching here with no array at
            // all would be a route that changed shape; keep what is on screen.
            if (Array.isArray(payload.words)) {
              cloudWords = payload.words;
              cloudDistinct = typeof payload.distinct === "number" ? payload.distinct : 0;
              /**
               * **Cleared only when a cloud actually arrived** (impl review F6). Run
               * unconditionally — as it was — a 200 whose body had lost its `words` array would
               * keep the previous cloud, correctly, and then present it as *fresh*: the same
               * "looks live but isn't" failure `POLL_TIMEOUT_MS` exists to prevent, reached
               * through the body instead of through the network.
               */
              cloudStale = false;
            }
            if (typeof payload.answered === "number") answered = payload.answered;

            /**
             * The final read has landed, so `pollWanted` stops re-arming for this question.
             *
             * **Gated on the phase the request was ISSUED in, not the phase it arrived in**
             * (impl review F2). Recorded only for a request that left *after* the reveal: one
             * issued while the question was still open cannot be final, because words submitted
             * in the interval are not in it. A reveal mid-flight therefore costs one extra tick
             * rather than a silently incomplete cloud.
             *
             * Still only in the revealed phase at all — doing it while the question is open
             * would end the loop on the first tick and freeze the cloud while the room was
             * writing into it.
             */
            if (issuedInPhase === "question-revealed") {
              cloudFinalReadFor = target.questionId;
            }
          } else {
            answered = typeof payload.answered === "number" ? payload.answered : answered;
            answeredStale = false;
          }

          pollDelay = POLL_BASE_MS;
          render();
        } catch {
          // The venue network. Not an error worth a message — the marker says it.
          pollFailed(target.kind);
        } finally {
          polling = false;
          /**
           * The single place a tick is re-armed, so every branch above simply returns.
           * **Conditional**, because `render` may have called `stopPolling` while this
           * request was open — the host revealing mid-fetch is the ordinary way that
           * happens — and re-arming there would leave a timer running for a panel that
           * is no longer on screen.
           *
           * `pollWanted` rather than `pollTargetFor`, so the word cloud's final read closes
           * the loop here too. Without that this block would re-arm forever on a revealed
           * word-cloud question — the panel is still on screen, so the target still exists.
           */
          if (pollWanted(client.current())) schedulePoll();
        }
      }

      /**
       * The three non-plain outcomes the host routes already return are reported as
       * themselves, because collapsing any of them into "worked" or "failed" is what
       * makes a host retry the wrong thing on stage:
       *
       * - `applied: false` with a note — the state is not where the host thought, but
       *   nothing broke and the room is fine. Retrying does nothing.
       * - `502` with the state committed — the write landed, the broadcast did not.
       *   Retrying the *same* action is the fix, and is safe: devices drop a snapshot
       *   they already hold.
       * - `401` — the secret. Nothing else will work until it is corrected.
       */
      /**
       * `body` exists for exactly one caller (roadmap S-10): `end` reads its confirmation
       * version from the form, and `extractHostFields` looks for it nowhere else. The flow
       * verbs pass nothing and send exactly the request shape they always did.
       *
       * Widened here rather than given its own send path, so there stays **one** action
       * fetch site and one outcome vocabulary. A second copy would be a second place for the
       * 401, the committed-but-unbroadcast 502 and the `applied: false` note to be handled,
       * and the two would drift on the one action that cannot be undone.
       */
      /** The `start` request's body: which quiz this panel is asking the store to run. */
      function startBody(): FormData {
        const body = new FormData();
        body.set("quizId", config.quizId);
        return body;
      }

      async function fire(action: string, body?: FormData): Promise<void> {
        allButtons().forEach((button) => {
          button.disabled = true;
        });
        say("Wysyłam…", "pending");

        try {
          const response = await fetch(`/api/quiz/host/${action}`, {
            method: "POST",
            headers: { [config.secretHeader]: secretField.value },
            body,
          });
          const payload = (await response.json().catch(() => ({}))) as ActionResponse;

          if (payload.state !== undefined) {
            client.apply(payload.state as Parameters<typeof client.apply>[0], "http");
          }

          if (response.status === 401) {
            say(payload.error ?? "Brak uprawnień hosta.", "refused");
            // The field is behind the menu now, so focusing it means opening that first —
            // `openHostMenu` does both, and this branch is the reason it does.
            openHostMenu();
            return;
          }

          if (response.status === 502) {
            say(
              payload.error ??
                "Zapisano, ale nie dotarło do urządzeń. Powtórz tę samą akcję.",
              "refused"
            );
            return;
          }

          if (!response.ok) {
            say(payload.error ?? `Błąd ${response.status}.`, "refused");
            return;
          }

          if (payload.applied === false) {
            /**
             * **The one `applied: false` that did something**, and it needs saying before the
             * generic branch below reports it as nothing (`standings.ts`, `republished`).
             *
             * Nothing in the store changed — no transition, no version — but the snapshot
             * went out to every device, which is the whole of what the host asked for by
             * tapping a board that was already on screen. `ok` rather than `attention`: the
             * retry the 502 asked for has just succeeded, and the register is what the host
             * reads before the words.
             */
            if (payload.note === "republished") {
              say("ranking wysłany ponownie do urządzeń", "ok");
              return;
            }

            say(
              payload.note === "no-op"
                ? `${action}: nic do zrobienia (koniec pytań?). Stan bez zmian.`
                : `${action}: ta akcja została już zastosowana. Stan bez zmian.`,
              "attention"
            );
            return;
          }

          say(`${action}: OK`, "ok");
        } catch (err) {
          say(`${action}: żądanie nie doszło (${String(err)})`, "refused");
        } finally {
          allButtons().forEach((button) => {
            button.disabled = false;
          });
          // After the blanket re-enable, not before: the phase rule has to win. The same
          // applies to the closing button, which must not come back enabled in a phase that
          // refuses it — nor still armed after the action it was armed alongside.
          syncControls();
          syncEndButton();
        }
      }

      /**
       * WHETHER THE ROOM IS ALREADY IN.
       *
       * The count the participation poll maintains, against the freshest join figure the page
       * holds — the same pair the rail prints, read here rather than re-derived, so the guard
       * and the number the host is looking at cannot disagree.
       *
       * **A stale count does not get to waive the confirmation.** `answeredStale` means the
       * poll is failing, so the last figure is a claim about some earlier moment; treating it
       * as "everybody answered" would drop the guard exactly when the page is least able to
       * say so. The cost of being wrong the other way is one extra tap.
       *
       * A total of zero is not "everyone" — an empty room answers a question nobody joined,
       * and `0 >= 0` would read that as a full house.
       */
      function everyoneAnswered(state: State): boolean {
        const total = liveCount ?? state.playerCount;
        return !answeredStale && answered !== null && total > 0 && answered >= total;
      }

      /**
       * WHEN THE REVEAL HAS TO BE MEANT TWICE.
       *
       * Two conditions, and each of them alone is the whole of a case where the tap costs
       * nothing:
       *
       * - **The clock has to still be running.** `countdown.isRunning()` is asked rather than
       *   the deadline recomputed here, because that arithmetic already exists once — a second
       *   copy is the drift `renderCountdownPanel`'s own note warns about. It answers all three
       *   no-clock cases at once: the two unscored questions carry no limit and never arm it,
       *   and an expired window stops it, so revealing after time is up is a single tap. That
       *   is the common path and it stays as fast as it was.
       * - **The room must not have finished answering.** A confirmation asks the host to defend
       *   a decision the room has already made for them, which is the shape a warning stops
       *   being read at. The clock running past the last answer is the case the host is *meant*
       *   to cut short.
       *
       * The phase is deliberately not tested: `verbsFor` offers `reveal` in exactly one
       * phase, and a condition here would be the second phase rule beside a button that the
       * table exists to prevent. The clock is armed in that phase and no other anyway.
       */
      function revealNeedsConfirm(state: State): boolean {
        if (!countdown.isRunning()) return false;
        return !everyoneAnswered(state);
      }

      actionButtons().forEach((button) => {
        button.addEventListener("click", () => {
          const action = button.dataset.action ?? "";
          const state = client.current();

          /**
           * The reveal's first tap arms and says why; the second one fires. Everything else
           * on this bar fires on the first tap, as it always did — the branch is narrow on
           * purpose, and `revealNeedsConfirm` narrows it further to the moments it protects.
           */
          if (action === "reveal" && !revealArmed && state !== null && revealNeedsConfirm(state)) {
            revealArmed = true;
            revealArmedVersion = state.version;
            syncControls();
            const total = liveCount ?? state.playerCount;
            say(
              // Names both halves of what the tap does. "Pokaż odpowiedź" is the visible
              // one; closing submissions is the one with no undo, and it is the reason the
              // host is being asked twice.
              `czas jeszcze trwa (odpowiedzi: ${answered ?? "—"} z ${total}) — ` +
                "kliknij ponownie, aby zamknąć odpowiedzi i pokazać wynik",
              "attention"
            );
            return;
          }

          // Disarmed BEFORE the request, not after it, so a reveal that fails has to be
          // meant a second time — the arming was a statement about a state the failed
          // attempt has already outlived. `end`'s handler, for the same reason.
          disarmReveal();

          /**
           * `start` names the quiz this panel rendered (multiple-quizzes).
           *
           * A body rather than a query string, because `extractStartFields` reads the
           * form — and it is built here rather than inside `fire` so that function stays
           * one send path with no per-action knowledge in it. `end` builds its
           * confirmation body the same way, a few lines below.
           */
          const body = action === "start" ? startBody() : undefined;
          void fire(action, body);
        });
      });

      /**
       * The closing beat's two taps (roadmap S-10, FR-006).
       *
       * The first arms and says which session it is about; the second sends that version,
       * which the route refuses if the room has moved since. Disarmed *before* the request
       * rather than after it, so a close that fails has to be meant a second time — the
       * arming is a statement about a state the host looked at, and a failed attempt has
       * already outlived it.
       */
      endButton.addEventListener("click", () => {
        const state = client.current();

        // The phase rule already disables the button here; this is the backstop for a click
        // that lands between a snapshot and the render that follows it.
        if (state === null) {
          say("brak sesji do zakończenia", "refused");
          return;
        }

        if (!endArmed) {
          endArmed = true;
          endArmedVersion = state.version;
          syncEndButton();
          say(`kliknij ponownie, aby zakończyć sesję (wersja ${state.version})`, "attention");
          return;
        }

        const version = endArmedVersion ?? state.version;
        endArmed = false;
        endArmedVersion = null;
        syncEndButton();

        const body = new FormData();
        // The version the host CONFIRMED, not a freshly read one — sending the latter would
        // make the confirmation a formality that always matches, which is the whole guard.
        body.set("version", String(version));
        void fire("end", body);
      });

      refresh.addEventListener("click", () => {
        refresh.disabled = true;
        client
          .refresh()
          .then(() => say("odświeżono", "ok"))
          .catch((err: unknown) => say(`nie udało się odświeżyć: ${String(err)}`, "refused"))
          .finally(() => {
            refresh.disabled = false;
          });
      });

      /**
       * The poll stops when nobody can see it and when the page goes away — a projector
       * tab left in the background must not keep spending commands, and a timer that
       * outlives the page is a request fired at a document that is gone.
       */
      document.addEventListener("visibilitychange", () => {
        // The countdown stops with the poll. It spends no commands, so this is hygiene
        // rather than budget — but a hidden tab that keeps a timer is the shape this page
        // is careful about, and `render` re-arms it from the wall clock on the way back.
        if (document.visibilityState === "hidden") {
          stopPolling();
          stopCountdown();
        } else render();
      });
      window.addEventListener("pagehide", () => {
        stopPolling();
        stopCountdown();
        /**
         * And the toast goes with them, through `say` like every other write to it. A
         * back-forward-cache restore does not re-run this script, so without this the page
         * comes back holding an outcome from before it went away — with its own clock either
         * already spent or throttled, which is the "still on screen long after it meant
         * anything" failure this toast exists to end.
         */
        say("", "ok");
      });
      /**
       * The other half of `pagehide`. A back-forward-cache restore does not re-run this
       * script, so without this the page comes back showing whatever count it froze on,
       * with no poll running and no staleness marker — the exact "a stale number that
       * looks live" failure the marker exists to prevent. It self-heals on the host's next
       * action, but the gap is silent, and `render` re-arms everything.
       */
      window.addEventListener("pageshow", () => render());

      secretField.value = readSecret();
      secretField.addEventListener("input", () => {
        storeSecret(secretField.value);
        setText("secret-note", secretField.value.length > 0 ? "zapamiętany w tej karcie" : "");
        // The 401 recovery path. Typing the secret is the fix, so it is the trigger —
        // and it clears the backoff a run of refused polls may have built up, so a host
        // who took their time typing does not then wait out a lengthened interval.
        unauthorizedPolls = 0;
        pollDelay = POLL_BASE_MS;
        stopPolling();
        void runPoll();
      });
      setText("secret-note", secretField.value.length > 0 ? "zapamiętany w tej karcie" : "");

      el("host-menu-open").addEventListener("click", () => openHostMenu());
      el("host-menu-close").addEventListener("click", () => hostMenu.close());
      // A tab that has nothing stored cannot do anything until the secret is typed, and the
      // only hint the room's screen carries is a QR that says nothing about being a button.
      // So the first paint of an unauthorised tab opens the menu itself; a reload mid-segment
      // has the secret in `sessionStorage` and is left alone.
      if (secretField.value.length === 0) openHostMenu();

      render();
      void client.start();
    </script>
  </body>
</html>
