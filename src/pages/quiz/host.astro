---
import "../../styles/global.css";

import QRCode from "qrcode";

import { HOST_SECRET_HEADER } from "../../lib/session/host";
import { SESSION_CHANNEL, SNAPSHOT_EVENT } from "../../lib/session/realtime";
import { publicQuiz } from "../../quiz/public";

/**
 * The host view (roadmap S-02).
 *
 * Drives the segment from the stage and shows the room what it needs to see. Read from
 * the back of a venue room, so the phase, the prompt and the join count are set at a
 * scale well past the site's ordinary body type. All copy is Polish.
 *
 * **On demand — no `prerender` export.**
 *
 * ## The secret is typed, never shipped
 *
 * This page reads no secret in its frontmatter and embeds none in its HTML. The host
 * types it into a field once, it is held in `sessionStorage` for the tab's lifetime,
 * and every action sends it as the `x-livequiz-host-secret` header to the existing
 * `/api/quiz/host/*` routes. So the page stays as unprotected as the PRD wants — there
 * is nothing on it worth guarding — while the write path stays guarded by the routes
 * that already do it. A missing or wrong secret surfaces those routes' own Polish 401
 * rather than a second message that could disagree with it.
 *
 * That is the difference from `spine-check.astro`, which ships the secret to the
 * browser and is therefore only allowed to exist behind `LIVEQUIZ_HARNESS`.
 *
 * ## `end` is here now. `purge` is still not
 *
 * **This section previously read "`end` and `purge` are deliberately not here", and S-10
 * reversed half of it.** The original reasoning is kept rather than deleted, because a
 * reader checking why an irreversible verb sits on a stage screen should meet the position
 * it overturned: *F-03 set the two irreversible verbs apart from the flow verbs on purpose.
 * They stay on the harness page with its confirmation flow, which the runbook and the
 * rehearsal recovery path both lean on. A mis-click at the front of a room is not
 * recoverable.*
 *
 * What changed is that FR-006 asks the **host** to trigger the closing beat, and a terminal
 * window in front of a room is not a trigger. The mis-click risk is answered rather than
 * avoided: the button is set apart from the flow verbs, carries no `data-action` so the
 * blanket handler cannot reach it, requires two taps, disarms whenever the session moves,
 * and sends a version the route refuses if it is stale. See the button's own note below.
 *
 * `purge` stays on the harness page. It deletes with no undo and no ten-minute window, and
 * nothing about FR-006 asks for it on stage.
 */

/** Where the room goes. Built from the request so preview and production agree. */
const attendeeUrl = new URL("/quiz", Astro.url);

/**
 * The join QR (added 2026-08-08, from the first two-device run).
 *
 * The URL as text was the only way in, and typing it is the slowest step in a flow
 * PRD FR-002 gives thirty seconds — 150 people transcribing a hostname is the join
 * target spent before anyone has picked a name.
 *
 * Rendered **server-side into inline SVG**, so nothing extra ships to the phones and
 * the projector needs no network of its own to draw it. Dark modules on white rather
 * than the page's dark palette: an inverted QR is readable by many scanners and
 * reliably readable by fewer, and the venue is not the place to find out which kind
 * someone brought.
 *
 * The generator is server-only. `boundary.test.ts` would fail the suite if a
 * `<script>` block below ever imported it.
 */
const joinQrSvg = await QRCode.toString(attendeeUrl.href, {
  type: "svg",
  errorCorrectionLevel: "M",
  margin: 1,
  color: { dark: "#0a0a0f", light: "#ffffff" },
});
---

<html lang="pl" class="bg-surface-primary">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>LiveQuiz — prowadzący</title>
  </head>
  <body
    class="min-h-dvh bg-surface-primary text-text-primary font-archivo antialiased
           flex flex-col gap-8 px-8 py-6"
  >
    <header class="flex flex-wrap items-center justify-between gap-6">
      <h1 class="text-brand-purple-light text-sm font-bold uppercase tracking-[0.2em]">
        LiveQuiz — prowadzący
      </h1>

      <!-- The join affordance, sized for the back of the room: scan, or read the URL
           off the same block. Both routes to the same place, side by side. -->
      <div class="flex items-center gap-5">
        <div class="h-40 w-40 rounded-xl bg-white p-2 [&>svg]:h-full [&>svg]:w-full">
          <Fragment set:html={joinQrSvg} />
        </div>
        <div class="flex flex-col gap-1">
          <p class="text-text-secondary text-lg">Zeskanuj albo wpisz:</p>
          <p class="text-3xl font-bold leading-tight break-all">
            {attendeeUrl.host}{attendeeUrl.pathname}
          </p>
        </div>
      </div>
    </header>

    <!-- Compact, and above the controls: it is the first thing to fix when an action
         comes back 401, and nothing else on the page works until it is right. -->
    <section class="flex flex-wrap items-center gap-3">
      <label for="secret" class="text-text-secondary text-base">Sekret hosta</label>
      <input
        id="secret"
        type="password"
        autocomplete="off"
        class="flex-1 min-w-56 rounded-lg border border-surface-border bg-surface-secondary
               px-3 py-2 text-lg text-text-primary focus:border-brand-purple-light
               focus:outline-none"
      />
      <span id="secret-note" class="text-text-secondary text-base"></span>
    </section>

    <main class="flex flex-1 flex-col gap-8">
      <!-- The three figures the room and the host read from a distance. -->
      <section class="grid gap-6 sm:grid-cols-3">
        <div>
          <p class="text-text-secondary text-lg uppercase tracking-wide">Faza</p>
          <p id="phase" class="text-5xl font-bold leading-tight">—</p>
        </div>
        <div>
          <p class="text-text-secondary text-lg uppercase tracking-wide">Uczestnicy</p>
          <p id="player-count" class="text-7xl font-bold leading-none text-brand-purple-light">
            —
          </p>
        </div>
        <div>
          <p class="text-text-secondary text-lg uppercase tracking-wide">Wersja</p>
          <p id="version" class="text-5xl font-bold leading-tight">—</p>
        </div>
      </section>

      <section id="question" class="flex flex-col gap-5"></section>

      <!--
        The countdown (roadmap S-11, FR-020).

        **Below the prompt for the reason the participation panel is**: the prompt is what
        the room is reading, and a clock above it makes the screen about the clock.

        Sized to be read from the back of the room, which is the whole point of putting it
        here rather than leaving it on 150 phones. It counts the same window the server
        enforces, from the same timestamp every phone uses, so the projector and the room
        cannot disagree about how long is left.

        Present only while a scored question is open — the two unscored questions carry no
        limit, and the word cloud in particular fills until the host reveals it.
      -->
      <section id="host-countdown" hidden class="flex flex-col gap-2">
        <div class="flex items-baseline gap-4">
          <p class="text-text-secondary text-lg uppercase tracking-wide">Pozostały czas</p>
          <p
            data-countdown-text
            class="text-7xl font-bold leading-none tabular-nums"
          >
            —
          </p>
        </div>
        <div class="h-3 overflow-hidden rounded-full bg-white/10">
          <div
            data-countdown-bar
            class="h-full rounded-full bg-emerald-400 transition-[width] duration-1000 ease-linear"
            style="width: 100%"
          >
          </div>
        </div>
      </section>

      <!--
        The accepted answer for a free-text question, at reveal (roadmap S-05, FR-016).

        A choice question marks its correct option in the list above; a text question has
        no list to mark, so without this the room sees the answer on 150 phones and
        nothing on the projector — the failure the host notices from the stage.

        Sized to be read from the back, and hidden whenever the field is null, which the
        schema guarantees for every phase but `question-revealed`.
      -->
      <section
        id="accepted-answer"
        hidden
        class="rounded-xl border-2 border-emerald-400 bg-emerald-500/15 px-6 py-5"
      >
        <p class="text-text-secondary text-lg uppercase tracking-wide">Poprawna odpowiedź</p>
        <p id="accepted-answer-value" class="text-6xl font-bold leading-tight"></p>
      </section>

      <!--
        The participation panel (roadmap S-04, FR-005).

        `answered / joined` while a question is open, the room's answers once it is
        revealed, and nothing at all for a question kind that cannot be answered.

        **Below the prompt, deliberately.** The prompt is what the room is reading; a
        panel above it pushes the question down the projector and makes the screen about
        the count rather than about the question.

        Hidden with the `hidden` attribute, which needs no CSS to work — the same reason
        `setHidden` exists.
      -->
      <section id="participation" hidden class="flex flex-col gap-3">
        <div id="participation-count-box" class="flex items-baseline gap-4">
          <p class="text-text-secondary text-lg uppercase tracking-wide">Odpowiedzi</p>
          <p id="participation-count" class="text-7xl font-bold leading-none">—</p>
          <!-- Beside the number, not in place of it: the count keeps its last value on a
               failed poll, and this is what says the value is not fresh. -->
          <span id="participation-stale" hidden class="text-amber-400 text-lg">
            (nieaktualne)
          </span>
        </div>
        <div id="distribution"></div>
      </section>

      <!--
        The word cloud (roadmap S-08, FR-012/FR-015).

        The one panel on this page that fills continuously rather than on a host action,
        and the reason it exists at all: watching your own word land on the big screen is
        what proves the session is live. It is fed by a **poll**, not by the snapshot —
        publishing per submission is the O(N^2) fan-out the spine contract forbids, and a
        cloud that fills as the room types has no host action to ride. See
        `/api/quiz/host/words`.

        **Below the prompt for the reason the participation panel is**: the prompt is what
        the room is reading, and a panel above it pushes the question down the projector.

        The count line sits above the words rather than below, so the host can see the
        room's progress without reading the cloud — and it carries the same staleness
        marker the participation count does, because a cloud that has quietly stopped
        filling is indistinguishable from a room that has stopped writing.
      -->
      <section id="word-cloud" hidden class="flex flex-col gap-4">
        <div class="flex flex-wrap items-baseline gap-x-8 gap-y-2">
          <!-- How much of the room has written, which is the figure the host reads to judge
               when to reveal (impl review F4). Distinct from the word count beside it: thirty
               attendees can write five words, so the two answer different questions and the
               cloud alone cannot say how many people have taken part. Both numbers come from
               the same poll reply, so this costs no extra command. -->
          <div class="flex items-baseline gap-4">
            <p class="text-text-secondary text-lg uppercase tracking-wide">Odpowiedzi</p>
            <p id="word-cloud-answered" class="text-4xl font-bold leading-none">—</p>
          </div>
          <div class="flex items-baseline gap-4">
            <p class="text-text-secondary text-lg uppercase tracking-wide">Chmura słów</p>
            <p id="word-cloud-count" class="text-4xl font-bold leading-none">—</p>
          </div>
          <span id="word-cloud-stale" hidden class="text-amber-400 text-lg">
            (nieaktualne)
          </span>
        </div>
        <div id="word-cloud-words"></div>
      </section>

      <!--
        The leaderboard (roadmap S-07, FR-014).

        The published top five, straight off the snapshot — the host's screen sorts
        nothing, and neither does any phone. That is what makes "no divergence in
        standings between devices" a property of the design rather than an agreement
        between four renderers.

        Sized for the back of the room: `MAX_DISPLAY_NAME_LENGTH` is 24 because that is
        what fits a projected line at this type size, and a name that would still overflow
        truncates with an ellipsis rather than wrapping — five rows that became seven
        would push the board off the screen it was measured for.
      -->
      <!-- The heading carries an id because the closing beat renames it (roadmap S-10):
           the same board is a leaderboard between questions and a result at the end, and a
           projector that still says "Ranking" after the session closed leaves the room
           unsure whether anything has finished. -->
      <section id="standings" hidden class="flex flex-col gap-3">
        <p
          id="standings-title"
          class="text-text-secondary text-lg uppercase tracking-wide"
        >
          Ranking
        </p>
        <div id="standings-board"></div>
      </section>
    </main>

    <footer class="flex flex-col gap-4">
      <div class="flex flex-wrap gap-3">
        <button
          data-action="start"
          class="rounded-xl bg-brand-purple px-6 py-4 text-2xl font-semibold text-white
                 disabled:opacity-50"
        >
          start
        </button>
        <button
          data-action="advance"
          class="rounded-xl bg-brand-purple px-6 py-4 text-2xl font-semibold text-white
                 disabled:opacity-50"
        >
          dalej
        </button>
        <button
          data-action="reveal"
          class="rounded-xl bg-brand-purple px-6 py-4 text-2xl font-semibold text-white
                 disabled:opacity-50"
        >
          pokaż odpowiedź
        </button>
        <!-- The FR-014 beat. Reachable only from a reveal, which is why it is disabled
             everywhere else rather than relying on the route's 409 — the refusal is the
             backstop, not the interaction. -->
        <button
          data-action="standings"
          class="rounded-xl bg-brand-purple px-6 py-4 text-2xl font-semibold text-white
                 disabled:opacity-50"
        >
          pokaż ranking
        </button>
        <!-- No join publishes anything (that would be the O(N^2) fan-out the spine
             contract forbids), so this is how the host watches the lobby fill. -->
        <button
          id="refresh"
          class="rounded-xl border border-surface-border bg-surface-secondary px-6 py-4
                 text-2xl font-semibold text-text-primary disabled:opacity-50"
        >
          odśwież
        </button>

        <!--
          The closing beat (roadmap S-10, FR-006), and **the reversal of a deliberate F-03
          decision** — see this page's docstring, which used to say `end` was not here.

          Three things keep that reversal defensible, and all three are load-bearing:

          - **It is set apart.** Pushed to the far end of the row, outlined in red rather
            than filled in brand purple, and it carries no `data-action` — so a mis-reach
            lands on a flow verb and the blanket handler that drives them cannot fire it.
          - **It takes two taps.** The first arms it and rewrites the label; the second
            fires. Any action that moves the session disarms it again, so it can never fire
            into a state the host has not looked at.
          - **The route still guards it.** The second tap sends the version the host is
            looking at, which `end` refuses if it has moved. The interaction is the first
            line; the 409 is the backstop.

          `purge` is deliberately still NOT here. This slice reversed the placement for the
          verb a host needs on stage, not for the one that deletes without an undo.
        -->
        <!-- Disabled in the markup, not only by script: the page renders before the first
             snapshot arrives, and the one button that cannot be undone must not be live
             while the view still knows nothing about the session. -->
        <button
          id="end"
          disabled
          class="ml-auto rounded-xl border-2 border-red-400 px-6 py-4 text-2xl
                 font-semibold text-red-400 disabled:opacity-50"
        >
          zakończ sesję
        </button>
      </div>

      <p id="connection" class="text-text-secondary text-base">połączenie: —</p>
      <p id="message" role="status" aria-live="polite" class="text-xl"></p>
    </footer>

    <script
      define:vars={{
        channelName: SESSION_CHANNEL,
        snapshotEvent: SNAPSHOT_EVENT,
        secretHeader: HOST_SECRET_HEADER,
        questions: publicQuiz.questions,
      }}
    >
      window.__liveQuizHost = { channelName, snapshotEvent, secretHeader, questions };
    </script>

    <script>
      import {
        createSessionClient,
        type ConnectionInfo,
        type ConnectionStatus,
      } from "../../lib/client/session";
      import {
        el,
        renderCountdown,
        renderDistribution,
        renderQuestion,
        renderStandings,
        renderWordCloud,
        setHidden,
        setText,
        wordCloudCountText,
        type WordCount,
      } from "../../lib/client/render";
      import type { PublicQuestion } from "../../quiz/public";

      type Config = {
        channelName: string;
        snapshotEvent: string;
        secretHeader: string;
        questions: PublicQuestion[];
      };

      type ActionResponse = {
        state?: unknown;
        applied?: boolean;
        note?: string;
        error?: string;
      };

      /**
       * `sessionStorage`, not `localStorage`: the secret should not outlive the tab the
       * host opened for this segment. Outside the session namespace on purpose: it is
       * not session data, nothing in `keys.ts` governs it, and no purge has any business
       * with it — it is a convenience for one browser tab.
       */
      const SECRET_STORAGE_KEY = "quiz-host-secret";

      const config = (window as unknown as { __liveQuizHost: Config }).__liveQuizHost;

      const secretField = el("secret") as HTMLInputElement;
      const questionBox = el("question");
      const refresh = el("refresh") as HTMLButtonElement;
      const participationBox = el("participation");
      const countBox = el("participation-count-box");
      const staleMark = el("participation-stale");
      const distributionBox = el("distribution");
      const acceptedAnswerBox = el("accepted-answer");
      const standingsBox = el("standings");
      const standingsBoard = el("standings-board");
      const wordCloudBox = el("word-cloud");
      const wordCloudWords = el("word-cloud-words");
      const wordCloudStale = el("word-cloud-stale");
      const hostCountdownBox = el("host-countdown");
      const endButton = el("end") as HTMLButtonElement;

      const actionButtons = (): HTMLButtonElement[] =>
        Array.from(document.querySelectorAll<HTMLButtonElement>("button[data-action]"));

      /**
       * `endButton` is listed here but is deliberately **not** in `actionButtons` — it has
       * no `data-action`, so the blanket click handler that drives the flow verbs cannot
       * reach it. It belongs in this list because everything here is disabled while a
       * request is open, and closing the session on top of an action still in flight is
       * exactly the race the version confirmation would then have to catch.
       */
      const allButtons = (): HTMLButtonElement[] => [...actionButtons(), refresh, endButton];

      function readSecret(): string {
        try {
          return window.sessionStorage.getItem(SECRET_STORAGE_KEY) ?? "";
        } catch {
          return "";
        }
      }

      function storeSecret(value: string): void {
        try {
          window.sessionStorage.setItem(SECRET_STORAGE_KEY, value);
        } catch {
          // Storage disabled. The field still holds the value for this page load,
          // which is enough to run the segment.
        }
      }

      /**
       * The join count as of the last time anything told us one.
       *
       * Two sources feed it and both are legitimate: a snapshot carries the count that
       * was embedded when the host last acted, and `/api/quiz/state` carries one read
       * live. Whichever spoke most recently wins, because neither is authoritative over
       * the other — the count is informational by design, and the only failure that
       * matters is showing a stale number forever, which is what happened before the
       * live read existed.
       *
       * `null` means nothing has told us yet.
       */
      let liveCount: number | null = null;

      /**
       * THE FIRST OF THE PROJECT'S TWO SANCTIONED POLLING LOOPS (roadmap S-04, FR-005).
       *
       * The runbook's command tripwire is described there as a polling detector, so every
       * loop that exists has to be nameable. This one is bounded on purpose: **one
       * device**, only while a choice question is open, ~2.5s — so an unexpected pattern
       * in the command counter is still detectable as one.
       *
       * The second is the connection fallback in `src/lib/client/session.ts`, which polls
       * `/api/quiz/state` on any device whose Ably channel is unavailable. It is bounded
       * differently — by the outage, by tab visibility and by the session ending — and its
       * budget is recorded in `src/pages/api/quiz/state.ts`. The two are independent and
       * may run at once on this device; neither knows about the other.
       *
       * It is a read. `/api/quiz/host/participation` writes nothing, and that is
       * load-bearing rather than incidental: during `question-open` the session
       * document's `updatedAt` is the moment the question opened and bounds the speed
       * clamp, so a host-side write here would inflate every award after it. See the
       * warning in `src/pages/api/quiz/answer.ts`.
       */
      const POLL_BASE_MS = 2_500;
      const POLL_MAX_MS = 20_000;
      /**
       * How long a tick is given before it is abandoned (impl review F1).
       *
       * **Without this a stall is indistinguishable from a healthy poll, and worse than a
       * failure.** `polling` stays `true`, so `schedulePoll` returns early and no further tick
       * re-arms; and `pollFailed` never runs, so the staleness marker never appears. The
       * projector then shows a frozen count or a frozen cloud that *looks live* — precisely
       * what `(nieaktualne)` exists to prevent, and the same class as the back-forward-cache
       * gap `pageshow` closes below.
       *
       * Ten seconds, matching `REQUEST_TIMEOUT_MS` in `src/lib/client/answer.ts`, whose
       * docstring states the rule this borrows: a request that never returns is worse than one
       * that fails, because nothing downstream can tell the difference. Generous against a
       * venue network and still well short of a host advance.
       */
      const POLL_TIMEOUT_MS = 10_000;
      /**
       * How many consecutive `401`s keep the fast interval before the loop starts backing
       * off. Five ticks is ~12.5 s — comfortably longer than a host takes to type the
       * secret, and short enough that a page which is never going to be authorised stops
       * hammering. See the `401` branch in `runPoll` for what this is protecting.
       */
      const UNAUTHORIZED_FAST_RETRIES = 5;

      let pollTimer: number | null = null;
      let pollDelay = POLL_BASE_MS;
      let unauthorizedPolls = 0;
      /**
       * The word cloud's per-question state (roadmap S-08).
       *
       * Held beside `answered` below and reset by the same `panelQuestionId` change, because
       * the two panels are two views of the same beat and a cloud left over from the previous
       * question under a new prompt is exactly as wrong as a stale count.
       *
       * `null` means the poll has not answered yet, which `renderWordCloud` draws as its
       * waiting sentence rather than as an empty room.
       */
      let cloudWords: WordCount[] | null = null;
      let cloudDistinct = 0;
      let cloudStale = false;
      /**
       * Which question's cloud has already had its final, post-reveal read.
       *
       * **Without this the loop never stops.** The word-cloud target below deliberately
       * covers `question-revealed` so the host keeps a complete cloud to talk over — but no
       * submission can arrive in that phase, so every tick after the first is guaranteed to
       * return the same bytes. This is what makes the final read a read rather than a loop.
       */
      let cloudFinalReadFor: string | null = null;
      /**
       * Whether a request is in flight.
       *
       * **`pollTimer` alone does not answer this**, and that gap is the bug this exists to
       * close: the timer callback clears the handle *before* awaiting, so for the whole
       * duration of a fetch there is no timer — and `render` runs on every snapshot, which
       * means every host action. Without this flag each such render scheduled another
       * tick, and a slow venue network could hold several requests open at once. Worst
       * exactly when the network is worst, which is when the backoff was meant to be
       * reducing load rather than racing it.
       */
      let polling = false;
      /** The last count the endpoint gave us. `null` means it has not answered yet. */
      let answered: number | null = null;
      let answeredStale = false;
      /** Which question the panel's numbers belong to, so a new one resets them. */
      let panelQuestionId: string | null = null;

      const client = createSessionClient({
        channelName: config.channelName,
        snapshotEvent: config.snapshotEvent,
        /**
         * On for the same reason as the attendee view, with a sharper edge: this is the
         * one device whose failure stops the room. The host's own actions already return
         * authoritative state over HTTP, so a host with no channel can still run the
         * segment — the fallback is what keeps the panel from freezing between them.
         *
         * Independent of the participation loop below: that one is bounded to a choice
         * question on this device, this one to a channel outage. Both may run at once;
         * neither knows about the other.
         */
        fallbackPolling: true,
        onSnapshot: (state) => {
          if (state) liveCount = state.playerCount;
          render();
        },
        onCount: (count) => {
          // Fires even when the snapshot was dropped as not-newer, which is the
          // ordinary case for a refresh in a lobby nobody has advanced out of.
          if (count !== null) liveCount = count;
          render();
        },
        onConnection: (status: ConnectionStatus, info: ConnectionInfo) => {
          /**
           * **This is the one screen where the cause is named outright, code included.**
           * The host is the only person who can act on an exhausted Ably limit — the fix
           * is a plan upgrade, not patience — and `połączenie: disconnected` says nothing
           * about which of the two situations they are in. The code travels so it can be
           * matched against Ably's dashboard without guessing.
           *
           * Attendee phones get the neutral wording instead; see `index.astro`.
           */
          /**
           * Cause and mode are composed rather than chosen between. Picking one would
           * lose the diagnosis exactly when it is most useful: a host running on the
           * fallback *because* the account limit is exhausted needs to see both, or the
           * amber line reads as a network hiccup and the plan never gets raised.
           */
          const reason =
            info.cause === "account-limit"
              ? `limit Ably wyczerpany (${info.code ?? "?"}) — sala pełna, potrzebny wyższy plan`
              : info.detail;

          setText(
            "connection",
            status === "degraded"
              ? `połączenie: tryb zapasowy — ${reason}`
              : `połączenie: ${reason}`
          );
          /**
           * Three colours for three situations, because two would merge the one that
           * needs an action with the one that does not. Amber says the segment is running
           * on the fallback: worth knowing, not worth stopping for.
           */
          el("connection").className =
            status === "connected"
              ? "text-text-secondary text-base"
              : status === "degraded"
                ? "text-amber-300 text-base"
                : "text-red-400 text-base";
        },
      });

      const PHASE_LABELS: Record<string, string> = {
        lobby: "poczekalnia",
        "question-open": "pytanie otwarte",
        "question-revealed": "odpowiedź ujawniona",
        standings: "ranking",
        ended: "zakończona",
      };

      type State = NonNullable<ReturnType<typeof client.current>>;

      function questionFor(state: State): PublicQuestion | undefined {
        return config.questions.find((candidate) => candidate.id === state.currentQuestionId);
      }

      /**
       * **ONE predicate governs both the panels and the poll**, and it is written once
       * (extended by roadmap S-08 from a boolean to a target).
       *
       * Two conditions would mean the poll runs for a question whose panel is not rendered —
       * feeding nothing, from an endpoint that can only ever return zero. A data path with no
       * affordance is the mirror of `lessons.md`'s first rule, and it fails just as quietly:
       * nothing is wrong on screen, and the command counter climbs.
       *
       * **One loop serves both endpoints**, chosen here by question kind. A second timer was
       * the alternative and it is the failure this file guards hardest against — see the
       * `polling` flag's note above: two loops mean two backoffs, two in-flight flags, and two
       * chances to leave a timer running for a panel that is no longer on screen.
       *
       * Returns `null` when nothing should be polled, which is also what hides both panels.
       */
      type PollTarget = { kind: "participation" | "words"; questionId: string; url: string };

      function pollTargetFor(state: State | null): PollTarget | null {
        if (state === null) return null;

        const questionId = state.currentQuestionId;
        if (questionId === null) return null;

        const kind = questionFor(state)?.kind;
        const query = `?questionId=${encodeURIComponent(questionId)}`;

        /**
         * The word cloud runs in **both** `question-open` and `question-revealed`, unlike the
         * participation count. FR-005 keeps the distribution off the screen until the reveal
         * because it is a cheat sheet while answering is open; the cloud has no correct answer
         * to leak (FR-005's own scope note says so), so the only reason to stop is that there
         * is nothing left to read — which is what `cloudFinalReadFor` decides, not this.
         */
        if (kind === "word-cloud") {
          if (state.phase !== "question-open" && state.phase !== "question-revealed") return null;
          return { kind: "words", questionId, url: `/api/quiz/host/words${query}` };
        }

        // Unchanged from S-04: the count is shown only while the question is open, and only
        // for the two kinds whose answers it can count.
        if (state.phase !== "question-open") return null;
        if (kind !== "single-choice" && kind !== "multiple-choice") return null;

        return { kind: "participation", questionId, url: `/api/quiz/host/participation${query}` };
      }

      /** Whether a tick is still worth firing for the current target. */
      function pollWanted(state: State | null): boolean {
        const target = pollTargetFor(state);
        if (target === null) return false;

        // The final-read gate. Only the word cloud has one; the participation loop stops
        // because its target disappears at the reveal.
        if (target.kind === "words" && state?.phase === "question-revealed") {
          return cloudFinalReadFor !== target.questionId;
        }

        return true;
      }

      /**
       * Forgets every polled panel's numbers when the question changes.
       *
       * **One reset for both panels, called before anything renders.** A first paint under a
       * new prompt carrying the previous question's count — or its cloud — is plausible and
       * wrong, and the word cloud makes it worse than the count did: a chip is a word somebody
       * wrote, so a stale one attributes it to the question now on screen.
       */
      function resetPanels(questionId: string | null): void {
        panelQuestionId = questionId;
        answered = null;
        answeredStale = false;
        cloudWords = null;
        cloudDistinct = 0;
        cloudStale = false;
        // Deliberately NOT `cloudFinalReadFor`: it is keyed by question id, so it needs no
        // clearing here, and clearing it would re-open the loop for a question the host had
        // already revealed and come back to.
        pollDelay = POLL_BASE_MS;
      }

      function renderParticipation(state: State): void {
        const distribution =
          state.phase === "question-revealed" ? state.revealedDistribution : null;
        const showCount = pollTargetFor(state)?.kind === "participation";

        setHidden(participationBox, !showCount && distribution === null);
        setHidden(countBox, !showCount);
        setHidden(staleMark, !answeredStale);

        if (showCount) {
          // The denominator is the join count the page already maintains, which the
          // poll's own `playerCount` keeps fresh — so the join figure stops needing a
          // manual refresh while a question is open.
          setText("participation-count", `${answered ?? "—"} / ${liveCount ?? state.playerCount}`);
        }

        renderDistribution(
          distributionBox,
          state.currentQuestionId === null ? undefined : questionFor(state),
          {
            distribution,
            correctOptionIds: state.revealedOptionIds,
            list: "flex flex-col gap-3",
            row: "grid grid-cols-[1fr_auto] gap-x-4 gap-y-2 rounded-xl border border-surface-border bg-surface-secondary px-5 py-4",
            rowCorrect: "border-emerald-400",
            label: "text-3xl",
            count: "text-3xl font-bold tabular-nums",
            bar: "col-span-2 h-3 rounded-full bg-surface-primary",
            barFill: "h-full rounded-full bg-brand-purple-light",
            empty: "text-text-secondary text-2xl",
          }
        );
      }

      /**
       * The word cloud panel (roadmap S-08, FR-012/FR-015).
       *
       * Shown for exactly the phases the poll runs in, so the panel and the data path cannot
       * disagree — `pollTargetFor` is the single predicate, and asking it here is what keeps
       * that true rather than re-deriving the condition.
       *
       * A failed read leaves the last cloud on screen with the staleness marker beside the
       * count, never an empty one: on a projector an empty cloud is the claim that nobody in
       * the room wrote a word. `pollFailed` documents the same rule for the count.
       */
      function renderWordCloudPanel(state: State): void {
        const isCloud = pollTargetFor(state)?.kind === "words";
        // The panel survives the final read: `pollTargetFor` still returns a words target in
        // `question-revealed`, and only `pollWanted` stops the ticks. That split is what lets
        // the host talk over a frozen cloud.
        setHidden(wordCloudBox, !isCloud);
        setHidden(wordCloudStale, !cloudStale);

        if (!isCloud) return;

        const shown = cloudWords?.length ?? 0;
        setText("word-cloud-count", wordCloudCountText(shown, cloudDistinct));

        /**
         * How much of the room has written (impl review F4).
         *
         * **The plan promised this line and the first implementation dropped it**, leaving the
         * route computing `answered` and this page storing it with nothing rendering it — a data
         * path with no affordance, which is `lessons.md`'s first rule inverted. The word count
         * beside it is not a substitute: it counts distinct *words*, so five words can mean five
         * people or fifty, and the host reads this figure to decide when to reveal.
         *
         * Same shape and same fallbacks as the participation count: `—` until the first reply,
         * and the denominator prefers the freshest join count the page holds.
         */
        setText("word-cloud-answered", `${answered ?? "—"} / ${liveCount ?? state.playerCount}`);

        renderWordCloud(wordCloudWords, cloudWords ?? undefined, {
          list: "flex flex-wrap items-baseline gap-x-8 gap-y-3",
          chip: "font-bold leading-none text-brand-purple-light",
          empty: "text-text-secondary text-3xl",
          // Measured for this projector: small enough that thirty fit, large enough that a
          // one-vote word is still readable from the back.
          minRem: 1.75,
          maxRem: 5,
        });
      }

      /**
       * The key `CONTROL_RULES` is read under when there is no session yet — before the
       * first `start`, and after a purge or an expiry. A real key rather than a null
       * branch, so the table below answers every state the view can be in and no phase
       * falls through to "whatever was on screen before".
       */
      const NO_SESSION = "none";

      /**
       * WHICH FLOW VERB IS OFFERED IN WHICH PHASE, AND WHICH ONE IS THE NEXT STEP.
       *
       * S-07 wrote the principle on the standings button alone: *disabled everywhere else
       * rather than relying on the route's 409 — the refusal is the backstop, not the
       * interaction*. `start`, `advance` and `reveal` never got it, so the host could tap
       * `pokaż odpowiedź` in the lobby and be answered by an error. This table extends the
       * rule to all four verbs and adds `next`, the one button highlighted as the step the
       * session is waiting for.
       *
       * **One table, not four conditions.** The phase rule for a flow verb lives here and
       * nowhere else — the same discipline `pollTargetFor` is held to by `host.test.ts`,
       * and for the same reason: a second place to state it is a second place for it to
       * drift from what the routes actually accept.
       *
       * `allow` mirrors route legality (`src/pages/api/quiz/host/*`), with three entries
       * that look inconsistent and are not:
       *
       * - **`advance` stays offered while a question is open.** It is the host's only lever
       *   on stage: if something appears on the projector that should not be there, the way
       *   out is to advance past it. It is simply not the *next* step there.
       * - **`standings` is offered in the `standings` phase too**, where the route treats it
       *   as a no-op that re-broadcasts. That is the recovery path its own 502 asks for —
       *   "Ranking jest zapisany, ale nie dotarł do urządzeń. Kliknij ponownie…" — and the
       *   state is already `standings` by the time the host reads it, so gating it out of
       *   that phase took away the retry the message names.
       * - **`start` is offered only with no session.** The route is create-if-absent and
       *   idempotent, so tapping it mid-quiz does nothing; an enabled button that does
       *   nothing is the thing this change exists to remove.
       *
       * `end` is deliberately absent: it is not a `data-action` button, it carries arming
       * state, and `syncEndButton` owns it — including the decision that it stays out of
       * reach in `lobby` even though the route would accept it.
       */
      type ControlRule = {
        allow: readonly string[];
        next: string | null;
        why: Record<string, string>;
      };

      const ALREADY_RUNNING = "Sesja już trwa.";
      const NOT_STARTED = "Sesja nie została jeszcze rozpoczęta.";
      const ALREADY_ENDED = "Sesja została zakończona.";
      const NEEDS_REVEAL = "Ranking można pokazać dopiero po ujawnieniu odpowiedzi.";

      const CONTROL_RULES: Record<string, ControlRule> = {
        [NO_SESSION]: {
          allow: ["start"],
          next: "start",
          why: { advance: NOT_STARTED, reveal: NOT_STARTED, standings: NOT_STARTED },
        },
        lobby: {
          allow: ["advance"],
          next: "advance",
          why: {
            start: ALREADY_RUNNING,
            reveal: "Żadne pytanie nie jest otwarte — nie ma czego pokazać.",
            standings: NEEDS_REVEAL,
          },
        },
        "question-open": {
          allow: ["advance", "reveal"],
          next: "reveal",
          why: { start: ALREADY_RUNNING, standings: NEEDS_REVEAL },
        },
        "question-revealed": {
          allow: ["advance", "standings"],
          next: "advance",
          why: {
            start: ALREADY_RUNNING,
            reveal: "Odpowiedź jest już pokazana — przejdź do następnego pytania.",
          },
        },
        standings: {
          allow: ["advance", "standings"],
          next: "advance",
          why: {
            start: ALREADY_RUNNING,
            reveal: "Ranking jest już pokazany — przejdź do następnego pytania.",
          },
        },
        ended: {
          allow: [],
          next: null,
          why: {
            start: ALREADY_ENDED,
            advance: ALREADY_ENDED,
            reveal: ALREADY_ENDED,
            standings: ALREADY_ENDED,
          },
        },
      };

      /**
       * The highlight on the next step. A ring rather than a size or padding change: the
       * button row is measured for a projector and sits in a `flex-wrap` container, so a
       * button that grew when it became the next step would reflow the whole row mid-session.
       */
      const NEXT_STEP_CLASSES = ["ring-4", "ring-white/70"];

      /**
       * The phase rules above, applied to the buttons.
       *
       * Called from `render` AND from `fire`'s `finally`, because that block re-enables
       * every button unconditionally — without the second call, an action would hand back
       * buttons enabled in a phase that refuses them, which is the exact bug the two
       * previously-gated buttons already carry a warning about.
       */
      function syncControls(): void {
        const state = client.current();
        const phase = state === null ? NO_SESSION : state.phase;
        const rule = CONTROL_RULES[phase] ?? CONTROL_RULES[NO_SESSION];

        for (const button of actionButtons()) {
          const action = button.dataset.action ?? "";
          const allowed = rule.allow.includes(action);
          const reason = rule.why[action];

          button.disabled = !allowed;
          // The reason travels on the button itself, so a host who reaches for a dark
          // button learns why it is dark without leaving the panel.
          if (!allowed && reason !== undefined) button.title = reason;
          else button.removeAttribute("title");

          const isNext = allowed && action === rule.next;
          for (const className of NEXT_STEP_CLASSES) {
            button.classList.toggle(className, isNext);
          }
        }
      }

      /**
       * Whether the closing button is armed, and the version it was armed at (roadmap
       * S-10, FR-006).
       *
       * **The version is the whole of the disarming rule.** Arming is a statement about the
       * session the host is looking at, so any accepted action — theirs or a second host's —
       * makes it stale, and a stale arm firing is precisely the mis-click this reversal had
       * to answer. Every accepted transition bumps the version, so it identifies "the
       * session I looked at" exactly, in the same way `rankVersion` does on the attendee
       * side.
       */
      let endArmed = false;
      let endArmedVersion: number | null = null;

      /**
       * The closing button's phase rule and its arming state, in one place.
       *
       * Called from `render` AND from `fire`'s `finally`, for the reason
       * `syncControls` is: that block re-enables every button unconditionally, so
       * without the second call an action would leave this one enabled in a phase that
       * refuses it — and, worse, still armed.
       *
       * Enabled only where the route would accept it and the host would mean it:
       * `question-revealed` and `standings`. Not in `lobby` — a session nobody has played is
       * closed from the terminal, not by the one button on this page that cannot be undone;
       * not in `question-open`, which the route refuses anyway; not in `ended`.
       */
      function syncEndButton(): void {
        const state = client.current();
        const phase = state?.phase;

        if (endArmed && state?.version !== endArmedVersion) {
          endArmed = false;
          endArmedVersion = null;
        }

        endButton.disabled = !(phase === "question-revealed" || phase === "standings");
        // Disarmed by the disable too: a button that went out of reach must not come back
        // still holding a tap the host made before the room moved.
        if (endButton.disabled && endArmed) {
          endArmed = false;
          endArmedVersion = null;
        }

        endButton.textContent = endArmed ? "na pewno? kliknij ponownie" : "zakończ sesję";
      }

      function render(): void {
        /**
         * **The countdown's single clearing point, and it is here rather than in its own
         * renderer because that was a bug.**
         *
         * `renderCountdownPanel` cleared the clock at its own top — but it is called near
         * the *end* of `render`, and the `state === null` branch below returns long before
         * reaching it. So a purge, a TTL expiry or a `bun run quiz:reset` left the timer
         * chain re-arming and `#host-countdown` on screen, counting a question down over
         * the "brak sesji" panel. Its own null handling was unreachable, which is the tell.
         *
         * Cleared before the first branch, every branch therefore passes through it, and
         * only the `question-open` path arms a clock again — the same shape the attendee
         * page uses, for the same reason.
         */
        stopCountdown();

        const state = client.current();

        if (state === null) {
          setText("phase", "brak sesji");
          setText("player-count", "—");
          setText("version", "—");
          liveCount = null;
          setHidden(participationBox, true);
          setHidden(acceptedAnswerBox, true);
          setHidden(standingsBox, true);
          setHidden(wordCloudBox, true);
          stopPolling();
          /**
           * A purge or an expiry, so the next session starts from nothing. Without this the
           * cloud from the previous room would be re-shown the moment a new session reached
           * the same question — question ids are stable across sessions, which is what makes
           * that line up rather than being far-fetched (`clearSeen`'s reasoning on the
           * attendee side).
           */
          resetPanels(null);
          cloudFinalReadFor = null;
          renderQuestion(questionBox, undefined, { prompt: "text-4xl font-bold leading-tight" });
          // Before the early return, not after it: this branch is a purge, an expiry, or
          // the first paint, and in all three the closing button must be out of reach and
          // holding no arm from a session that is gone — while the flow verbs must fall
          // back to offering `start` alone, which is the only one a sessionless view can
          // honour.
          syncControls();
          syncEndButton();
          return;
        }

        setText("phase", PHASE_LABELS[state.phase] ?? state.phase);
        setText("player-count", liveCount ?? state.playerCount);
        setText("version", state.version);

        // Before any panel renders, so neither can paint the previous question's numbers
        // under a new prompt. Both polled panels read the state this clears.
        if (state.currentQuestionId !== panelQuestionId) resetPanels(state.currentQuestionId);

        const question = questionFor(state);
        const distribution =
          state.phase === "question-revealed" ? state.revealedDistribution : null;

        /**
         * The leaderboard beat (roadmap S-07, FR-014).
         *
         * The schema already refuses a board outside its own phase and a phase without
         * one, so the null check is the whole condition — the same reasoning the accepted
         * answer below rests on, and adding a phase test here would be a second place for
         * the rule to live.
         *
         * **Rendered from the snapshot with no sort.** Every device paints the sequence
         * the server published; see `renderStandings`.
         *
         * `ownDisplayName: null` because the host is not a player. The highlight belongs
         * to the attendee view.
         */
        const standings = state.standings;
        setHidden(standingsBox, standings === null);
        /**
         * The closing beat (roadmap S-10, FR-006).
         *
         * **The same board, told apart by phase and by nothing else.** The visibility rule
         * above is unchanged and still keys on the field alone — the schema is what decides
         * where a board may appear, and a phase test there would be a second place for that
         * rule to live. What the phase decides here is only how it reads: a heading, and the
         * winner's row set larger than the four under it.
         *
         * The emphasis is a first-child variant on the list rather than a new
         * `renderStandings` option, because it is presentation and the renderer's job is the
         * published order. `[&>li:first-child>span]` reaches the three spans a row is built
         * from — see `renderStandings`.
         */
        const closing = state.phase === "ended";
        setText("standings-title", closing ? "Zwycięzca" : "Ranking");
        // The board replaces the question rather than sitting under it. The phase keeps a
        // `currentQuestionId` — that is what stops `advance` reopening question 1 — so
        // without this the finished question stays on the projector above the standings.
        setHidden(questionBox, standings !== null);
        renderStandings(standingsBoard, standings?.rows, {
          ownDisplayName: null,
          list: closing
            ? "flex flex-col gap-3 [&>li:first-child]:border-brand-purple-light " +
              "[&>li:first-child]:bg-brand-purple/20 [&>li:first-child>span]:text-7xl"
            : "flex flex-col gap-3",
          row: "grid grid-cols-[auto_1fr_auto] items-baseline gap-6 rounded-xl border border-surface-border bg-surface-secondary px-6 py-4",
          rank: "text-5xl font-bold tabular-nums text-brand-purple-light",
          // `truncate` rather than a wrap: five rows that became seven would push the
          // board off the screen this type size was measured for.
          name: "text-5xl font-bold truncate",
          points: "text-5xl font-bold tabular-nums",
          empty: "text-text-secondary text-3xl",
        });

        /**
         * At a reveal with bars to show, **the option list is replaced by them** — the
         * bars carry the same option text with a count against it, so drawing both puts
         * the options on the projector twice. With no distribution (a failed tally read,
         * or a non-choice kind) the ordinary revealed rendering stands, so
         * `revealedOptionIds` still marks the correct answer and FR-016 holds either way.
         */
        renderQuestion(
          questionBox,
          state.currentQuestionId === null
            ? undefined
            : distribution !== null && question
              ? { ...question, options: undefined }
              : question,
          {
            prompt: "text-6xl font-bold leading-tight",
            list: "grid gap-3 sm:grid-cols-2",
            option:
              "rounded-xl border border-surface-border bg-surface-secondary px-5 py-4 text-3xl",
            mode: state.phase === "question-revealed" ? "revealed" : "static",
            correctOptionIds: state.revealedOptionIds,
            optionCorrect: "border-emerald-400",
          }
        );

        /**
         * The accepted answer, straight off the snapshot (roadmap S-05).
         *
         * The schema already refuses a non-null value outside `question-revealed`, so
         * the null check is the whole condition — no phase test is needed here, and
         * adding one would be a second place for the rule to live.
         */
        const accepted = state.revealedAnswerText;
        setHidden(acceptedAnswerBox, accepted === null || accepted.length === 0);
        if (accepted) setText("accepted-answer-value", accepted);

        renderCountdownPanel(state);
        renderParticipation(state);
        renderWordCloudPanel(state);
        syncControls();
        syncEndButton();

        if (pollWanted(state)) schedulePoll();
        else stopPolling();
      }

      function say(text: string, bad: boolean): void {
        setText("message", text);
        el("message").className = bad ? "text-xl text-red-400" : "text-xl text-emerald-400";
      }

      function stopPolling(): void {
        if (pollTimer === null) return;
        window.clearTimeout(pollTimer);
        pollTimer = null;
      }

      /**
       * THE COUNTDOWN, AND WHY IT IS NOT A SECOND POLL LOOP (roadmap S-11, FR-020).
       *
       * `host.test.ts` guards this page against a second *polling* loop, and the reason it
       * gives is specific: two loops mean two backoffs, two in-flight flags, and two chances
       * to leave a timer fetching for a panel that is off screen. **This timer fetches
       * nothing.** It touches no endpoint, has no backoff, no in-flight flag and no failure
       * mode beyond painting a stale number — so it costs no commands and cannot appear in
       * the runbook's tripwire, which is a polling detector.
       *
       * That distinction is exactly what the rewritten guard in `host.test.ts` now asserts:
       * one timer arms a `fetch`, and this one is held to a different, narrower rule —
       * cleared on every render, armed only while a scored question is open.
       *
       * Its remainder is computed from the snapshot's `updatedAt` plus the question's own
       * limit, which is the same arithmetic every phone does from the same two values. The
       * projector cannot drift from the room because neither side is measuring anything
       * local.
       */
      let countdownTimer: number | null = null;
      /** What the running clock is counting, so the tick needs no lookup. */
      let countdownFor: { deadline: number; limitMs: number } | null = null;

      function stopCountdown(): void {
        if (countdownTimer !== null) {
          window.clearTimeout(countdownTimer);
          countdownTimer = null;
        }
        countdownFor = null;
        setHidden(hostCountdownBox, true);
      }

      /**
       * Shows the clock for a scored open question, and nothing otherwise.
       *
       * **Keyed on the limit's presence, never on a phase list.** The schema decides which
       * questions have a clock — required when scored, refused when not — and a list here
       * would be a copy of that rule able to fall behind it. The same reasoning both views
       * apply to the standings board's visibility.
       */
      /**
       * Arms the clock for a scored open question, and nothing otherwise.
       *
       * **Arm-only: the clearing lives at the top of `render`.** This function used to
       * clear as well, which read as safe and was not — it is called near the end of
       * `render`, so every early return above it skipped the clear entirely. Splitting the
       * two means the clear cannot be missed by a branch and this one cannot be reached
       * without it having already happened.
       */
      function renderCountdownPanel(state: State | null): void {
        if (state === null || state.phase !== "question-open") return;
        if (state.currentQuestionId === null) return;

        const question = config.questions.find((q) => q.id === state.currentQuestionId);
        if (question?.timeLimitSeconds === undefined) return;

        const limitMs = question.timeLimitSeconds * 1_000;
        countdownFor = { deadline: state.updatedAt + limitMs, limitMs };

        setHidden(hostCountdownBox, false);
        paintCountdown();
      }

      function paintCountdown(): void {
        if (countdownFor === null) return;

        // Recomputed from the wall clock every tick rather than decremented, so a projector
        // whose tab was throttled comes back correct instead of minutes fast.
        const remaining = countdownFor.deadline - Date.now();
        renderCountdown(hostCountdownBox, remaining, countdownFor.limitMs);

        // At zero the clock simply stops. Nothing advances, nothing reveals: the host owns
        // every transition, and the room keeps looking at the question until they act.
        if (remaining <= 0) return;

        const untilNextSecond = remaining % 1_000 || 1_000;
        countdownTimer = window.setTimeout(() => {
          countdownTimer = null;
          paintCountdown();
        }, untilNextSecond);
      }

      function schedulePoll(): void {
        // Never two timers, and never a timer stacked behind a request that has not come
        // back. `render` runs on every snapshot, and a snapshot arriving mid-question
        // would otherwise add a second loop each time — the count would still look right
        // while the command spend doubled, then quadrupled.
        if (pollTimer !== null || polling) return;
        if (document.visibilityState === "hidden") return;
        pollTimer = window.setTimeout(() => {
          pollTimer = null;
          void runPoll();
        }, pollDelay);
      }

      /**
       * A poll that could not be answered.
       *
       * **Keep the last count and back off; never zero it.** `readPlayerCount`'s
       * discipline, for the same reason: on a projector a number that drops to zero
       * reads to the room as everyone having stopped answering, and a host who cannot
       * read the count is in a different situation from one whose room has gone quiet.
       * The staleness marker is what says which.
       */
      function pollFailed(kind: PollTarget["kind"]): void {
        // Only the panel that asked is marked stale. Marking both would put "(nieaktualne)"
        // beside a count nobody is polling.
        if (kind === "words") cloudStale = true;
        else answeredStale = true;

        pollDelay = Math.min(pollDelay * 2, POLL_MAX_MS);
        render();
      }

      async function runPoll(): Promise<void> {
        const target = pollTargetFor(client.current());
        if (target === null) return;
        if (!pollWanted(client.current())) return;

        /**
         * **The phase this request was ISSUED in, captured before it leaves** (impl review F2).
         *
         * The word cloud's final-read flag is set from this, not from the phase the reply
         * happens to arrive in. Read at arrival, a body computed while the question was still
         * open counts as the final cloud whenever the host reveals mid-flight — which this
         * function's own `finally` calls "the ordinary way that happens" — and every word
         * submitted after the request left is permanently missing from the cloud the host then
         * talks over, with nothing on screen to say so.
         *
         * The same capture-at-issue shape `index.astro` uses for its rank fetch
         * (`const beat = state.version`), and for the same class of reason.
         */
        const issuedInPhase = client.current()?.phase ?? null;

        // Nothing may open a second request while one is open — including the secret
        // field's immediate retry, which is otherwise one keystroke away from a burst.
        if (polling) return;
        polling = true;

        try {
          const response = await fetch(target.url, {
            headers: { [config.secretHeader]: secretField.value },
            // See `POLL_TIMEOUT_MS`: an abandoned request takes the `catch` below, which sets
            // the staleness marker. A request that never returns sets nothing at all.
            signal: AbortSignal.timeout(POLL_TIMEOUT_MS),
          });

          /**
           * **A 401 is not a network failure and must not take that path.** The ordinary
           * cause is a host who has opened the page and not yet typed the secret — the
           * first thirty seconds of every session. Backing off would leave the projector
           * showing a staleness marker that says nothing about what is actually wrong,
           * and would then delay recovery by up to the backed-off interval after the
           * secret is finally typed. So: report it as what it is, leave the interval
           * alone, and let the `input` handler on the secret field retry immediately.
           */
          if (response.status === 401) {
            say(
              target.kind === "words"
                ? "Wpisz sekret hosta, żeby zobaczyć chmurę słów."
                : "Wpisz sekret hosta, żeby zobaczyć liczbę odpowiedzi.",
              true
            );

            /**
             * **The fast retries are bounded, and that bound is about a different threat
             * from the backoff above.** `/quiz/host` is deliberately unprotected — there
             * is nothing on it worth guarding — so an attendee who opens it during a
             * choice question would otherwise poll every 2.5 s for the whole segment.
             * Each of those requests emits a `session.auth.rejected` line, and `log.ts`
             * calls that the only security-relevant signal this system emits: a real
             * unauthorized attempt would sit buried among them. Backing off after the
             * window a host actually needs costs the honest case nothing, because the
             * `input` handler below resets this the moment the secret is typed.
             */
            unauthorizedPolls += 1;
            if (unauthorizedPolls > UNAUTHORIZED_FAST_RETRIES) {
              pollDelay = Math.min(pollDelay * 2, POLL_MAX_MS);
            }

            return;
          }

          // Reaching here means the secret is working, whatever else went wrong. Reset the
          // 401 counter but NOT `pollDelay` — a 503 below still needs to back off, and the
          // success path further down is what returns the interval to base.
          unauthorizedPolls = 0;

          if (!response.ok) {
            pollFailed(target.kind);
            return;
          }

          const payload = (await response.json()) as {
            questionId?: string;
            answered?: number;
            playerCount?: number | null;
            words?: WordCount[];
            distinct?: number;
          };

          /**
           * The host is free to advance at any moment, so a reply can arrive after the
           * question changed. Discarded rather than painted: the count — or worse, a cloud of
           * words somebody wrote about another question — would look entirely plausible under
           * the new prompt, which is what makes it worth a guard.
           */
          if (payload.questionId !== client.current()?.currentQuestionId) {
            return;
          }

          if (typeof payload.playerCount === "number") liveCount = payload.playerCount;

          if (target.kind === "words") {
            // Absent rather than empty is the "could not say" case, and it must not blank the
            // cloud — `readWordCloud` returns `null` for it and the route turns that into a
            // 503, which took the `!response.ok` path above. Reaching here with no array at
            // all would be a route that changed shape; keep what is on screen.
            if (Array.isArray(payload.words)) {
              cloudWords = payload.words;
              cloudDistinct = typeof payload.distinct === "number" ? payload.distinct : 0;
              /**
               * **Cleared only when a cloud actually arrived** (impl review F6). Run
               * unconditionally — as it was — a 200 whose body had lost its `words` array would
               * keep the previous cloud, correctly, and then present it as *fresh*: the same
               * "looks live but isn't" failure `POLL_TIMEOUT_MS` exists to prevent, reached
               * through the body instead of through the network.
               */
              cloudStale = false;
            }
            if (typeof payload.answered === "number") answered = payload.answered;

            /**
             * The final read has landed, so `pollWanted` stops re-arming for this question.
             *
             * **Gated on the phase the request was ISSUED in, not the phase it arrived in**
             * (impl review F2). Recorded only for a request that left *after* the reveal: one
             * issued while the question was still open cannot be final, because words submitted
             * in the interval are not in it. A reveal mid-flight therefore costs one extra tick
             * rather than a silently incomplete cloud.
             *
             * Still only in the revealed phase at all — doing it while the question is open
             * would end the loop on the first tick and freeze the cloud while the room was
             * writing into it.
             */
            if (issuedInPhase === "question-revealed") {
              cloudFinalReadFor = target.questionId;
            }
          } else {
            answered = typeof payload.answered === "number" ? payload.answered : answered;
            answeredStale = false;
          }

          pollDelay = POLL_BASE_MS;
          render();
        } catch {
          // The venue network. Not an error worth a message — the marker says it.
          pollFailed(target.kind);
        } finally {
          polling = false;
          /**
           * The single place a tick is re-armed, so every branch above simply returns.
           * **Conditional**, because `render` may have called `stopPolling` while this
           * request was open — the host revealing mid-fetch is the ordinary way that
           * happens — and re-arming there would leave a timer running for a panel that
           * is no longer on screen.
           *
           * `pollWanted` rather than `pollTargetFor`, so the word cloud's final read closes
           * the loop here too. Without that this block would re-arm forever on a revealed
           * word-cloud question — the panel is still on screen, so the target still exists.
           */
          if (pollWanted(client.current())) schedulePoll();
        }
      }

      /**
       * The three non-plain outcomes the host routes already return are reported as
       * themselves, because collapsing any of them into "worked" or "failed" is what
       * makes a host retry the wrong thing on stage:
       *
       * - `applied: false` with a note — the state is not where the host thought, but
       *   nothing broke and the room is fine. Retrying does nothing.
       * - `502` with the state committed — the write landed, the broadcast did not.
       *   Retrying the *same* action is the fix, and is safe: devices drop a snapshot
       *   they already hold.
       * - `401` — the secret. Nothing else will work until it is corrected.
       */
      /**
       * `body` exists for exactly one caller (roadmap S-10): `end` reads its confirmation
       * version from the form, and `extractHostFields` looks for it nowhere else. The flow
       * verbs pass nothing and send exactly the request shape they always did.
       *
       * Widened here rather than given its own send path, so there stays **one** action
       * fetch site and one outcome vocabulary. A second copy would be a second place for the
       * 401, the committed-but-unbroadcast 502 and the `applied: false` note to be handled,
       * and the two would drift on the one action that cannot be undone.
       */
      async function fire(action: string, body?: FormData): Promise<void> {
        allButtons().forEach((button) => {
          button.disabled = true;
        });
        say("…", false);

        try {
          const response = await fetch(`/api/quiz/host/${action}`, {
            method: "POST",
            headers: { [config.secretHeader]: secretField.value },
            body,
          });
          const payload = (await response.json().catch(() => ({}))) as ActionResponse;

          if (payload.state !== undefined) {
            client.apply(payload.state as Parameters<typeof client.apply>[0], "http");
          }

          if (response.status === 401) {
            say(payload.error ?? "Brak uprawnień hosta.", true);
            secretField.focus();
            secretField.select();
            return;
          }

          if (response.status === 502) {
            say(
              payload.error ??
                "Zapisano, ale nie dotarło do urządzeń. Powtórz tę samą akcję.",
              true
            );
            return;
          }

          if (!response.ok) {
            say(payload.error ?? `Błąd ${response.status}.`, true);
            return;
          }

          if (payload.applied === false) {
            say(
              payload.note === "no-op"
                ? `${action}: nic do zrobienia (koniec pytań?). Stan bez zmian.`
                : `${action}: ta akcja została już zastosowana. Stan bez zmian.`,
              false
            );
            return;
          }

          say(`${action}: OK`, false);
        } catch (err) {
          say(`${action}: żądanie nie doszło (${String(err)})`, true);
        } finally {
          allButtons().forEach((button) => {
            button.disabled = false;
          });
          // After the blanket re-enable, not before: the phase rule has to win. The same
          // applies to the closing button, which must not come back enabled in a phase that
          // refuses it — nor still armed after the action it was armed alongside.
          syncControls();
          syncEndButton();
        }
      }

      actionButtons().forEach((button) => {
        button.addEventListener("click", () => {
          void fire(button.dataset.action ?? "");
        });
      });

      /**
       * The closing beat's two taps (roadmap S-10, FR-006).
       *
       * The first arms and says which session it is about; the second sends that version,
       * which the route refuses if the room has moved since. Disarmed *before* the request
       * rather than after it, so a close that fails has to be meant a second time — the
       * arming is a statement about a state the host looked at, and a failed attempt has
       * already outlived it.
       */
      endButton.addEventListener("click", () => {
        const state = client.current();

        // The phase rule already disables the button here; this is the backstop for a click
        // that lands between a snapshot and the render that follows it.
        if (state === null) {
          say("brak sesji do zakończenia", true);
          return;
        }

        if (!endArmed) {
          endArmed = true;
          endArmedVersion = state.version;
          syncEndButton();
          say(`kliknij ponownie, aby zakończyć sesję (wersja ${state.version})`, false);
          return;
        }

        const version = endArmedVersion ?? state.version;
        endArmed = false;
        endArmedVersion = null;
        syncEndButton();

        const body = new FormData();
        // The version the host CONFIRMED, not a freshly read one — sending the latter would
        // make the confirmation a formality that always matches, which is the whole guard.
        body.set("version", String(version));
        void fire("end", body);
      });

      refresh.addEventListener("click", () => {
        refresh.disabled = true;
        client
          .refresh()
          .then(() => say("odświeżono", false))
          .catch((err: unknown) => say(`nie udało się odświeżyć: ${String(err)}`, true))
          .finally(() => {
            refresh.disabled = false;
          });
      });

      /**
       * The poll stops when nobody can see it and when the page goes away — a projector
       * tab left in the background must not keep spending commands, and a timer that
       * outlives the page is a request fired at a document that is gone.
       */
      document.addEventListener("visibilitychange", () => {
        // The countdown stops with the poll. It spends no commands, so this is hygiene
        // rather than budget — but a hidden tab that keeps a timer is the shape this page
        // is careful about, and `render` re-arms it from the wall clock on the way back.
        if (document.visibilityState === "hidden") {
          stopPolling();
          stopCountdown();
        } else render();
      });
      window.addEventListener("pagehide", () => {
        stopPolling();
        stopCountdown();
      });
      /**
       * The other half of `pagehide`. A back-forward-cache restore does not re-run this
       * script, so without this the page comes back showing whatever count it froze on,
       * with no poll running and no staleness marker — the exact "a stale number that
       * looks live" failure the marker exists to prevent. It self-heals on the host's next
       * action, but the gap is silent, and `render` re-arms everything.
       */
      window.addEventListener("pageshow", () => render());

      secretField.value = readSecret();
      secretField.addEventListener("input", () => {
        storeSecret(secretField.value);
        setText("secret-note", secretField.value.length > 0 ? "zapamiętany w tej karcie" : "");
        // The 401 recovery path. Typing the secret is the fix, so it is the trigger —
        // and it clears the backoff a run of refused polls may have built up, so a host
        // who took their time typing does not then wait out a lengthened interval.
        unauthorizedPolls = 0;
        pollDelay = POLL_BASE_MS;
        stopPolling();
        void runPoll();
      });
      setText("secret-note", secretField.value.length > 0 ? "zapamiętany w tej karcie" : "");

      render();
      void client.start();
    </script>
  </body>
</html>
