---
import QuizNotice from "../../components/QuizNotice.astro";
import { getQuizByCode } from "../../quiz/index";

/**
 * `/q/<code>` — the address a phone that cannot scan gets typed into it
 * (multiple-quizzes).
 *
 * Four digits, read off the projector, resolved through the registry and redirected to
 * `/quiz/<slug>`. It exists because `/quiz/summer-tour-szczecin` is fine to *scan* and
 * miserable to *type* in a dark room, on a phone, while the host waits — and FR-002
 * gives the whole join thirty seconds.
 *
 * **Deliberately outside `/quiz/`.** Every character counts on a typed address, and this
 * is the one URL in the project whose length is a feature.
 *
 * **A code whose quiz is not the one being run still redirects.** It would be easy to
 * check the session here and say "wrong quiz" — and wrong to: that message belongs on
 * the attendee view, once, where a phone that arrived by QR meets it too. Two copies of
 * one error is two places for it to drift, and the phone that typed a code is in exactly
 * the same position as the phone that scanned an old QR.
 *
 * **On demand — no `prerender` export and no `getStaticPaths`.** The latter is required
 * for a *prerendered* dynamic route and meaningless here; the codes are committed source,
 * so prerendering would be defensible, but this route sits with the rest of LiveQuiz and
 * the registry is parsed once at module scope either way.
 */
const code = Astro.params.code;
const quiz = code === undefined ? undefined : getQuizByCode(code);

if (quiz !== undefined) {
  return Astro.redirect(`/quiz/${quiz.id}`);
}

/**
 * An unknown code gets a page, not the framework's blank 404 — a mistyped digit is the
 * most likely thing that lands here, and the answer to it is "check the screen, or go to
 * /quiz", which a bare 404 cannot say.
 *
 * The **status stays 404**, because the code genuinely does not exist; what changes is
 * that the body is useful. `/quiz` is the link rather than a quiz slug: this page has no
 * idea which quiz was meant, and `/quiz` is where the code is asked for again — with the
 * digits in a field this time, which is the one remedy a mistyped code has.
 *
 * The shell is `QuizNotice` — shared with the attendee route and with `/quiz`'s own
 * code field, so this argument is made once rather than per route (impl-review F6).
 */
Astro.response.status = 404;
---

<QuizNotice
  title="LiveQuiz — nie znamy tego kodu"
  heading="Nie znamy tego kodu."
  body="Sprawdź cztery cyfry na ekranie i wpisz je jeszcze raz."
  link={{ href: "/quiz", label: "Albo wpisz kod quizu z ekranu" }}
/>
